Dialogue: 0,0:00:00.00,0:00:02.47,Japanese,,0,0,0,,みくりさん
Dialogue: 0,0:00:02.47,0:00:04.10,Japanese,,0,0,0,,きちんと入籍して
Dialogue: 0,0:00:04.10,0:00:06.11,Japanese,,0,0,0,,結婚しましょう
Dialogue: 0,0:00:06.11,0:00:09.31,Japanese,,0,0,0,,結婚すれば 雇用契約は必要なくなります
Dialogue: 0,0:00:09.31,0:00:12.61,Japanese,,0,0,0,,今まで みくりさんに支払っていた 給与分が浮いて
Dialogue: 0,0:00:12.61,0:00:16.18,Japanese,,0,0,0,,生活費 ないしは貯蓄に 回すことができます
Dialogue: 0,0:00:16.18,0:00:16.88,Japanese,,0,0,0,,つきましては……
Dialogue: 0,0:00:16.88,0:00:18.12,Japanese,,0,0,0,,待ってください
Dialogue: 0,0:00:18.12,0:00:21.29,Japanese,,0,0,0,,どうして 籍を入れようと思ったんですか？
Dialogue: 0,0:00:21.29,0:00:22.42,Japanese,,0,0,0,,ﾘｽﾄﾗです
Dialogue: 0,0:00:22.42,0:00:25.19,Japanese,,0,0,0,,ﾘｽﾄﾗされたから ﾌﾟﾛﾎﾟｰｽﾞ？
Dialogue: 0,0:00:25.19,0:00:27.63,Japanese,,0,0,0,,結婚すれば 給料は払わずに
Dialogue: 0,0:00:27.63,0:00:31.33,Japanese,,0,0,0,,私をタダで使えるから合理的
Dialogue: 0,0:00:31.33,0:00:33.67,Japanese,,0,0,0,,そういうことですよね？
Dialogue: 0,0:00:33.67,0:00:38.67,Japanese,,0,0,0,,僕のことが好きではない ということですか？
Dialogue: 0,0:00:38.67,0:00:42.78,Japanese,,0,0,0,,それは…… ｢好き｣の搾取です
Dialogue: 0,0:00:45.51,0:00:48.62,Japanese,,0,0,0,,大好きの人からのプロポース
Dialogue: 0,0:00:48.62,0:00:50.45,Japanese,,0,0,0,,嬉しかった
Dialogue: 0,0:00:50.45,0:00:53.69,Japanese,,0,0,0,,嬉しかったのに
Dialogue: 0,0:00:53.69,0:00:57.49,Japanese,,0,0,0,,何故私はモヤモヤしてしまうのか。
Dialogue: 0,0:00:59.02,0:01:02.30,Japanese,,0,0,0,,このモヤモヤは何なのか。
Dialogue: 0,0:01:06.10,0:01:09.34,Japanese,,0,0,0,,-おやすみなさい -おやすみなさい
Dialogue: 0,0:01:14.67,0:01:17.61,Japanese,,0,0,0,,今日は
Dialogue: 0,0:01:17.61,0:01:19.55,Japanese,,0,0,0,,火曜日だった。
Dialogue: 0,0:01:19.55,0:01:24.42,Japanese,,0,0,0,,これからは火曜じゃなくても 抱きしめていいですか？
Dialogue: 0,0:01:24.42,0:01:25.55,Japanese,,0,0,0,,何曜日でも
Dialogue: 0,0:01:25.55,0:01:28.35,Japanese,,0,0,0,,あれからハグの日は解体され
Dialogue: 0,0:01:28.35,0:01:32.76,Japanese,,0,0,0,,気持ちの赴くままに 毎日していたものだから
Dialogue: 0,0:01:32.76,0:01:35.23,Japanese,,0,0,0,,気持ちが離れてしまえば
Dialogue: 0,0:01:35.23,0:01:39.33,Japanese,,0,0,0,,手すら触れない 何もない
Dialogue: 0,0:01:39.33,0:01:41.13,Japanese,,0,0,0,,当然だ。
Dialogue: 0,0:01:41.13,0:01:46.61,Japanese,,0,0,0,,せっかくのプロポースを 台無しにした こんな小賢しい女
Dialogue: 0,0:01:46.61,0:01:49.78,Japanese,,0,0,0,,見捨てられて当然なのだ。
Dialogue: 0,0:01:49.78,0:01:53.31,Japanese,,0,0,0,,一度出てしまった言葉が
Dialogue: 0,0:01:53.31,0:01:56.58,Japanese,,0,0,0,,感じてしまったモヤモヤは
Dialogue: 0,0:01:56.58,0:02:00.19,Japanese,,0,0,0,,なかったことにはできない
Dialogue: 0,0:02:01.55,0:02:04.26,Japanese,,0,0,0,,お互いに
Dialogue: 0,0:02:10.90,0:02:15.27,Japanese,,0,0,0,,それは｢好き｣の搾取です
Dialogue: 0,0:02:15.27,0:02:18.14,Japanese,,0,0,0,,好きの搾取
Dialogue: 0,0:02:18.14,0:02:21.91,Japanese,,0,0,0,,そう言われて ドキッとした。
Dialogue: 0,0:02:21.91,0:02:24.91,Japanese,,0,0,0,,心のどこかで 自分を好きならば
Dialogue: 0,0:02:24.91,0:02:29.58,Japanese,,0,0,0,,当然 提案を受け入れてくれるもの だと思っていた。
Dialogue: 0,0:02:29.58,0:02:34.82,Japanese,,0,0,0,,いつの間に僕は こんなに思い上がってしまったのか
Dialogue: 0,0:02:37.49,0:02:40.46,Japanese,,0,0,0,,もうドキドキしちゃった～
Dialogue: 0,0:02:40.46,0:02:43.16,Japanese,,0,0,0,,今度こそ 左遷されんのかと思ってさ
Dialogue: 0,0:02:43.16,0:02:45.93,Japanese,,0,0,0,,ほら 本部長と やり合ったばっかりだから
Dialogue: 0,0:02:48.77,0:02:50.30,Japanese,,0,0,0,,それで？
Dialogue: 0,0:02:52.57,0:02:56.14,Japanese,,0,0,0,,｢部長に昇格させる｣だって
Dialogue: 0,0:02:58.18,0:02:59.95,Japanese,,0,0,0,,いらっしゃい
Dialogue: 0,0:03:01.48,0:03:03.25,Japanese,,0,0,0,,こんばんは
Dialogue: 0,0:03:03.25,0:03:07.05,Japanese,,0,0,0,,百合さんが祝杯を挙げてる って聞いて
Dialogue: 0,0:03:07.05,0:03:09.99,Japanese,,0,0,0,,さっきから 同じ話 10回は聞かされてるから
Dialogue: 0,0:03:09.99,0:03:11.39,Japanese,,0,0,0,,５回ぐらいでしょ
Dialogue: 0,0:03:11.39,0:03:12.96,Japanese,,0,0,0,,聞き役のヘルプで来ました
Dialogue: 0,0:03:12.96,0:03:15.66,Japanese,,0,0,0,,-風見君 いつもの？ -はい
Dialogue: 0,0:03:18.60,0:03:22.50,Japanese,,0,0,0,,部長への昇進 おめでとうございます
Dialogue: 0,0:03:22.50,0:03:25.20,Japanese,,0,0,0,,おめでたいのか どうなのか
Dialogue: 0,0:03:25.20,0:03:27.51,Japanese,,0,0,0,,責任は山のように増えるし
Dialogue: 0,0:03:27.51,0:03:32.81,Japanese,,0,0,0,,首都圏初の女性部長ともなると 風当たりは強い
Dialogue: 0,0:03:32.81,0:03:39.22,Japanese,,0,0,0,,今までの仕事が認められたことに おめでとう
Dialogue: 0,0:03:41.65,0:03:44.49,Japanese,,0,0,0,,１杯おごらせてください
Dialogue: 0,0:03:44.49,0:03:45.92,Japanese,,0,0,0,,じゃ一番高いヤツ
Dialogue: 0,0:03:45.92,0:03:47.33,Japanese,,0,0,0,,いいですよ
Dialogue: 0,0:03:47.33,0:03:48.23,Japanese,,0,0,0,,ウソよ
Dialogue: 0,0:03:48.23,0:03:52.63,Japanese,,0,0,0,,山さん 締めのビール１杯 風見君のおごり
Dialogue: 0,0:03:52.63,0:03:54.43,Japanese,,0,0,0,,締めですか？
Dialogue: 0,0:03:54.43,0:03:57.67,Japanese,,0,0,0,,明日も早いから帰らないと
Dialogue: 0,0:04:01.41,0:04:03.48,Japanese,,0,0,0,,風見君
Dialogue: 0,0:04:03.48,0:04:05.91,Japanese,,0,0,0,,日曜日 あいてる？
Dialogue: 0,0:04:08.18,0:04:12.15,Japanese,,0,0,0,,あの…… 青空市に出店する意思があるのか
Dialogue: 0,0:04:12.15,0:04:14.92,Japanese,,0,0,0,,あるなら何を売りたいか それだけなんですけど
Dialogue: 0,0:04:14.92,0:04:18.42,Japanese,,0,0,0,,だから それが どういう話なのかって
Dialogue: 0,0:04:18.42,0:04:20.96,Japanese,,0,0,0,,目的と企画意図は こちらに書いて……
Dialogue: 0,0:04:20.96,0:04:26.53,Japanese,,0,0,0,,こんなちっちゃい字 読めないよ 説明しろよ
Dialogue: 0,0:04:26.53,0:04:27.57,Japanese,,0,0,0,,えっと……
Dialogue: 0,0:04:27.57,0:04:29.27,Japanese,,0,0,0,,仕事だろ？
Dialogue: 0,0:04:29.27,0:04:33.64,Japanese,,0,0,0,,金もらってんなら しっかりやれよ
Dialogue: 0,0:04:33.64,0:04:36.84,Japanese,,0,0,0,,中西さん達に どうしてもって頼まれたから
Dialogue: 0,0:04:36.84,0:04:40.15,Japanese,,0,0,0,,最低賃金に収まる時間内で お手伝いしようと思って
Dialogue: 0,0:04:40.15,0:04:42.22,Japanese,,0,0,0,,始めたことで
Dialogue: 0,0:04:42.22,0:04:46.02,Japanese,,0,0,0,,それなのに 何だか すっごくモヤモヤします
Dialogue: 0,0:04:46.02,0:04:47.79,Japanese,,0,0,0,,ごめんね
Dialogue: 0,0:04:47.79,0:04:50.09,Japanese,,0,0,0,,俺からも あとでちゃんと説明しとくから
Dialogue: 0,0:04:50.09,0:04:52.46,Japanese,,0,0,0,,引き受けたからには 文句も言いたくないし
Dialogue: 0,0:04:52.46,0:04:55.13,Japanese,,0,0,0,,責任持ってやりたいんです
Dialogue: 0,0:04:55.13,0:04:58.30,Japanese,,0,0,0,,やりたいんですけど
Dialogue: 0,0:05:01.90,0:05:04.00,Japanese,,0,0,0,,モヤモヤばっかりだ。
Dialogue: 0,0:05:04.00,0:05:08.54,Japanese,,0,0,0,,青空市も結婚も
Dialogue: 0,0:05:08.54,0:05:10.78,Japanese,,0,0,0,,このモヤモヤは
Dialogue: 0,0:05:10.78,0:05:13.95,Japanese,,0,0,0,,モヤモヤの原因は
Dialogue: 0,0:05:13.95,0:05:15.72,Japanese,,0,0,0,,似てる。
Dialogue: 0,0:05:15.72,0:05:18.38,Japanese,,0,0,0,,青空市と結婚
Dialogue: 0,0:05:18.38,0:05:21.05,Japanese,,0,0,0,,その心は
Dialogue: 0,0:05:34.60,0:05:35.74,Japanese,,0,0,0,,ごちそうさまでした
Dialogue: 0,0:05:35.74,0:05:38.50,Japanese,,0,0,0,,お話があります
Dialogue: 0,0:05:41.11,0:05:46.71,Japanese,,0,0,0,,もし この間のことなら 無理強いするつもりは……
Dialogue: 0,0:05:46.71,0:05:48.95,Japanese,,0,0,0,,ずっと考えてたんです
Dialogue: 0,0:05:48.95,0:05:52.12,Japanese,,0,0,0,,主婦の労働の対価について
Dialogue: 0,0:05:52.12,0:05:52.85,Japanese,,0,0,0,,はい？
Dialogue: 0,0:05:52.85,0:05:53.79,Japanese,,0,0,0,,それが
Dialogue: 0,0:05:53.79,0:05:57.19,Japanese,,0,0,0,,最低賃金で働くことで 見えてきたんです
Dialogue: 0,0:05:57.19,0:05:58.56,Japanese,,0,0,0,,すいません 話がよく……
Dialogue: 0,0:05:58.56,0:06:02.53,Japanese,,0,0,0,,今 私 副業してるんです
Dialogue: 0,0:06:02.53,0:06:05.10,Japanese,,0,0,0,,はい？
Dialogue: 0,0:06:05.10,0:06:09.44,Japanese,,0,0,0,,やっさんの商店街の 青空市の手伝いを頼まれて
Dialogue: 0,0:06:13.61,0:06:15.91,Japanese,,0,0,0,,時給は930円
Dialogue: 0,0:06:15.91,0:06:18.44,Japanese,,0,0,0,,横浜市の最低賃金です
Dialogue: 0,0:06:18.44,0:06:21.51,Japanese,,0,0,0,,黙ってて ごめんなさい
Dialogue: 0,0:06:24.15,0:06:26.08,Japanese,,0,0,0,,なぜ 黙って……？
Dialogue: 0,0:06:26.08,0:06:30.02,Japanese,,0,0,0,,短時間の 軽いお手伝いのつもりだったし
Dialogue: 0,0:06:30.02,0:06:35.26,Japanese,,0,0,0,,周りが男の人ばっかりで 平匡さん嫌がるかなって
Dialogue: 0,0:06:39.13,0:06:41.30,Japanese,,0,0,0,,ごめんなさい
Dialogue: 0,0:06:41.30,0:06:44.17,Japanese,,0,0,0,,かなり衝撃的ですが
Dialogue: 0,0:06:44.17,0:06:45.00,Japanese,,0,0,0,,ごめんなさい！
Dialogue: 0,0:06:45.00,0:06:48.31,Japanese,,0,0,0,,僕もリストラを黙っていたので おあいこです
Dialogue: 0,0:06:51.31,0:06:53.78,Japanese,,0,0,0,,それで？
Dialogue: 0,0:06:53.78,0:06:56.48,Japanese,,0,0,0,,時給2000円なら耐えられる って仕事も
Dialogue: 0,0:06:56.48,0:07:00.35,Japanese,,0,0,0,,最低賃金では耐えられない って場合があると思うんです
Dialogue: 0,0:07:00.35,0:07:03.62,Japanese,,0,0,0,,金額以上の働きを求められても…… ということ？
Dialogue: 0,0:07:03.62,0:07:07.36,Japanese,,0,0,0,,はい そこが モヤモヤポイントでした
Dialogue: 0,0:07:14.13,0:07:17.37,Japanese,,0,0,0,,つまり こういうことです
Dialogue: 0,0:07:17.37,0:07:18.37,Japanese,,0,0,0,,こんなものまで
Dialogue: 0,0:07:18.37,0:07:19.91,Japanese,,0,0,0,,百均で見つけました
Dialogue: 0,0:07:19.91,0:07:22.78,Japanese,,0,0,0,,説明したいという気概は 受け取りました
Dialogue: 0,0:07:22.78,0:07:24.11,Japanese,,0,0,0,,それで？
Dialogue: 0,0:07:24.11,0:07:27.61,Japanese,,0,0,0,,結婚して 専業主婦になる ということは
Dialogue: 0,0:07:27.61,0:07:28.92,Japanese,,0,0,0,,生活費の保証
Dialogue: 0,0:07:28.92,0:07:33.62,Japanese,,0,0,0,,つまり最低賃金を受け取ることと イコールだと思うんです
Dialogue: 0,0:07:33.62,0:07:37.52,Japanese,,0,0,0,,でも最低賃金は あくまで最低賃金
Dialogue: 0,0:07:37.52,0:07:40.49,Japanese,,0,0,0,,食わせてやってるから黙って働け と言われても
Dialogue: 0,0:07:40.49,0:07:42.16,Japanese,,0,0,0,,限界があります
Dialogue: 0,0:07:42.16,0:07:45.13,Japanese,,0,0,0,,でも そんなに横暴な 雇用主ばかりじゃないでしょ
Dialogue: 0,0:07:45.13,0:07:47.53,Japanese,,0,0,0,,はい いい雇用主の下で
Dialogue: 0,0:07:47.55,0:07:50.04,Japanese,,0,0,0,,ｽﾄﾚｽもﾄﾗﾌﾞﾙもなく 働けるのならば
Dialogue: 0,0:07:50.04,0:07:53.17,Japanese,,0,0,0,,最低賃金でも いいのかもしれません
Dialogue: 0,0:07:53.17,0:07:55.98,Japanese,,0,0,0,,つまり 雇用主次第であると
Dialogue: 0,0:07:55.98,0:08:00.05,Japanese,,0,0,0,,一般企業なら 人が大勢いて 人事異動もあります
Dialogue: 0,0:08:00.05,0:08:05.28,Japanese,,0,0,0,,昇給や賞与など 客観的に 従業員を評価するシステムもある
Dialogue: 0,0:08:05.28,0:08:08.99,Japanese,,0,0,0,,でも夫婦の場合 １対１なんです
Dialogue: 0,0:08:08.99,0:08:14.03,Japanese,,0,0,0,,夫が評価しなければ 妻は誰からも評価されない
Dialogue: 0,0:08:14.03,0:08:18.76,Japanese,,0,0,0,,つまり 現状の 専業主婦の労働の対価は
Dialogue: 0,0:08:22.17,0:08:24.14,Japanese,,0,0,0,,この基本給プラス
Dialogue: 0,0:08:24.17,0:08:27.61,Japanese,,0,0,0,,雇用主の評価（愛情） ということになります
Dialogue: 0,0:08:27.61,0:08:29.91,Japanese,,0,0,0,,しかし 愛情は数値化できません
Dialogue: 0,0:08:29.91,0:08:31.41,Japanese,,0,0,0,,そうなんです
Dialogue: 0,0:08:31.41,0:08:34.45,Japanese,,0,0,0,,きわめて不安定な要素なんです
Dialogue: 0,0:08:34.45,0:08:37.82,Japanese,,0,0,0,,雇用主の気まぐれで いつでもゼロになりうる
Dialogue: 0,0:08:37.82,0:08:41.85,Japanese,,0,0,0,,その場合 最低賃金労働が続く というわけですね
Dialogue: 0,0:08:41.85,0:08:44.09,Japanese,,0,0,0,,労働時間の上限もないんです
Dialogue: 0,0:08:44.09,0:08:47.53,Japanese,,0,0,0,,ヘタをすれば ブラック企業になりかねません
Dialogue: 0,0:08:47.53,0:08:51.83,Japanese,,0,0,0,,従業員として この労働環境で やっていけるのかどうか
Dialogue: 0,0:08:51.83,0:08:54.00,Japanese,,0,0,0,,不安があります
Dialogue: 0,0:08:58.57,0:09:02.74,Japanese,,0,0,0,,プロポーズは嬉しかったんです
Dialogue: 0,0:09:02.74,0:09:06.34,Japanese,,0,0,0,,平匡さんと結婚したくないとか そういうことじゃなくて……
Dialogue: 0,0:09:06.34,0:09:10.85,Japanese,,0,0,0,,そもそも 従業員なんでしょうか？
Dialogue: 0,0:09:13.42,0:09:16.46,Japanese,,0,0,0,,夫が雇用主で 妻が従業員
Dialogue: 0,0:09:16.46,0:09:20.03,Japanese,,0,0,0,,そこからして 間違っているのでは？
Dialogue: 0,0:09:20.03,0:09:23.93,Japanese,,0,0,0,,主婦も 家庭を支える 立派な職業である
Dialogue: 0,0:09:23.93,0:09:26.90,Japanese,,0,0,0,,そう考えれば
Dialogue: 0,0:09:26.90,0:09:31.07,Japanese,,0,0,0,,夫も妻も 共同経営責任者
Dialogue: 0,0:09:31.07,0:09:34.14,Japanese,,0,0,0,,共同経営責任者？
Dialogue: 0,0:09:34.14,0:09:38.48,Japanese,,0,0,0,,この視点で 僕達の関係を再構築しませんか？
Dialogue: 0,0:09:40.98,0:09:46.02,Japanese,,0,0,0,,雇用関係ではない 新たなるシステムの再構築です
Dialogue: 0,0:09:46.02,0:09:49.99,Japanese,,0,0,0,,愛情があればシステムは必要ない とも思いましたが
Dialogue: 0,0:09:49.99,0:09:54.69,Japanese,,0,0,0,,そんな簡単なことでは なかったようです
Dialogue: 0,0:09:54.69,0:09:56.06,Japanese,,0,0,0,,うまくいくかは分かりませんが
Dialogue: 0,0:09:56.06,0:09:57.20,Japanese,,0,0,0,,やります！
Dialogue: 0,0:09:57.20,0:09:59.40,Japanese,,0,0,0,,やらせてください
Dialogue: 0,0:10:01.80,0:10:02.94,Japanese,,0,0,0,,やりましょう
Dialogue: 0,0:10:02.94,0:10:05.24,Japanese,,0,0,0,,共同経営責任者
Dialogue: 0,0:10:05.24,0:10:08.11,Japanese,,0,0,0,,なりましょう ＣＥＯ
Dialogue: 0,0:11:11.54,0:11:15.41,Japanese,,0,0,0,,Ａ社の仕事内容は 今とほぼ同じ
Dialogue: 0,0:11:18.04,0:11:20.31,Japanese,,0,0,0,,Ｂ社は 新しい会社ですが
Dialogue: 0,0:11:22.58,0:11:27.02,Japanese,,0,0,0,,平匡ＣＥＯは Ｂ社に魅力を感じてるんですね
Dialogue: 0,0:11:27.02,0:11:29.72,Japanese,,0,0,0,,以前なら Ａ社を選んでいましたが
Dialogue: 0,0:11:29.72,0:11:34.49,Japanese,,0,0,0,,今は もう少し新しいことが できるんじゃないかと感じています
Dialogue: 0,0:11:34.49,0:11:38.53,Japanese,,0,0,0,,しかし その場合 役員報酬は今の半分に
Dialogue: 0,0:11:38.53,0:11:41.70,Japanese,,0,0,0,,報酬の減額を仕方ないとするか
Dialogue: 0,0:11:41.70,0:11:44.97,Japanese,,0,0,0,,私も外で働いて補填するか
Dialogue: 0,0:11:44.97,0:11:46.64,Japanese,,0,0,0,,外で？
Dialogue: 0,0:11:46.64,0:11:48.67,Japanese,,0,0,0,,商店街の仕事なんですが
Dialogue: 0,0:11:48.67,0:11:50.38,Japanese,,0,0,0,,日給3000円なので
Dialogue: 0,0:11:50.38,0:11:53.81,Japanese,,0,0,0,,１日 3.2時間以内に 収めようと思ってました
Dialogue: 0,0:11:53.81,0:11:57.35,Japanese,,0,0,0,,それが どうにも収まらなくて
Dialogue: 0,0:11:58.62,0:12:01.55,Japanese,,0,0,0,,それで これです
Dialogue: 0,0:12:01.55,0:12:03.96,Japanese,,0,0,0,,タウン誌のライターの仕事です
Dialogue: 0,0:12:03.96,0:12:07.79,Japanese,,0,0,0,,ライターとして 商店街へ行き 取材記事を書きながら
Dialogue: 0,0:12:07.79,0:12:10.86,Japanese,,0,0,0,,青空市の調整もできるかと
Dialogue: 0,0:12:10.86,0:12:12.83,Japanese,,0,0,0,,給料をよそから引っ張る 作戦ですね
Dialogue: 0,0:12:12.83,0:12:16.07,Japanese,,0,0,0,,ただし ﾌﾙﾀｲﾑ労働になるので
Dialogue: 0,0:12:16.07,0:12:20.71,Japanese,,0,0,0,,この家の家事の時間が 削られてしまいます
Dialogue: 0,0:12:23.45,0:12:26.39,Japanese,,0,0,0,,みくりＣＥＯが引き受けた仕事は
Dialogue: 0,0:12:26.42,0:12:29.92,Japanese,,0,0,0,,この303ｶﾝﾊﾟﾆｰの 仕事でもあります
Dialogue: 0,0:12:29.95,0:12:33.62,Japanese,,0,0,0,,協力して成功させましょう
Dialogue: 0,0:12:33.62,0:12:37.59,Japanese,,0,0,0,,共働きとして 家事の分担を執り行います
Dialogue: 0,0:12:37.59,0:12:39.22,Japanese,,0,0,0,,ありがとうございます！
Dialogue: 0,0:12:40.46,0:12:45.93,Japanese,,0,0,0,,こうして 部屋の各地に双方の陣が 立てられることとなり
Dialogue: 0,0:12:45.93,0:12:49.00,Japanese,,0,0,0,,家事分担の合戦が始まった。
Dialogue: 0,0:12:50.17,0:12:54.94,Japanese,,0,0,0,,これより ゆるく長い戦いが 行われてゆく。
Dialogue: 0,0:13:02.25,0:13:03.98,Japanese,,0,0,0,,どうぞ入って
Dialogue: 0,0:13:08.19,0:13:11.96,Japanese,,0,0,0,,これ 今年の人間ドックの結果
Dialogue: 0,0:13:11.96,0:13:17.66,Japanese,,0,0,0,,ここ見て 骨密度の低下
Dialogue: 0,0:13:17.66,0:13:20.93,Japanese,,0,0,0,,年々 引っ掛かる項目が 増えてきちゃってさ
Dialogue: 0,0:13:20.93,0:13:23.64,Japanese,,0,0,0,,女性ホルモンは減る一方だし
Dialogue: 0,0:13:23.64,0:13:27.04,Japanese,,0,0,0,,目は衰えるし 疲れは取れないし
Dialogue: 0,0:13:27.04,0:13:30.48,Japanese,,0,0,0,,僕の気持ち 試してます？
Dialogue: 0,0:13:33.28,0:13:36.28,Japanese,,0,0,0,,あなたの部屋で あんなこと言われたときは
Dialogue: 0,0:13:36.28,0:13:40.45,Japanese,,0,0,0,,僕は百合さんを 抱きたいと思ってるのに
Dialogue: 0,0:13:40.45,0:13:45.19,Japanese,,0,0,0,,ふざけてるのかも って 一瞬は思ったけど
Dialogue: 0,0:13:45.19,0:13:48.63,Japanese,,0,0,0,,本気で言ってくれたのよね？
Dialogue: 0,0:13:48.63,0:13:52.66,Japanese,,0,0,0,,言葉が露骨だったと反省は……
Dialogue: 0,0:13:54.17,0:13:56.57,Japanese,,0,0,0,,ホントにビックリした
Dialogue: 0,0:13:56.57,0:13:58.34,Japanese,,0,0,0,,してたんですか？
Dialogue: 0,0:13:58.34,0:14:00.27,Japanese,,0,0,0,,したわよ
Dialogue: 0,0:14:00.27,0:14:01.94,Japanese,,0,0,0,,心臓に悪い
Dialogue: 0,0:14:05.78,0:14:09.32,Japanese,,0,0,0,,でも 無理なの
Dialogue: 0,0:14:15.25,0:14:18.66,Japanese,,0,0,0,,今まで かたくなに生きてきちゃったから
Dialogue: 0,0:14:18.66,0:14:22.80,Japanese,,0,0,0,,今さら 刹那的な恋愛とか 考えられないし
Dialogue: 0,0:14:22.80,0:14:29.27,Japanese,,0,0,0,,だからといって 私と風見君が まともにつきあえるかっていうと
Dialogue: 0,0:14:29.27,0:14:34.11,Japanese,,0,0,0,,風見君が生まれたとき 私は17歳で
Dialogue: 0,0:14:34.11,0:14:39.04,Japanese,,0,0,0,,風見君が 二十歳のとき 私は37歳で
Dialogue: 0,0:14:39.04,0:14:46.22,Japanese,,0,0,0,,風見君が やっと40を過ぎる頃 私はもう還暦で
Dialogue: 0,0:14:46.22,0:14:50.49,Japanese,,0,0,0,,どこまでいっても 風見君は私の甥っ子なの
Dialogue: 0,0:14:57.10,0:15:01.47,Japanese,,0,0,0,,今日 その格好見たときに 思ったんです
Dialogue: 0,0:15:05.40,0:15:10.08,Japanese,,0,0,0,,僕が見たかった素顔を 見せてくれたのか
Dialogue: 0,0:15:11.31,0:15:15.25,Japanese,,0,0,0,,甥っ子として呼ばれたのか
Dialogue: 0,0:15:17.98,0:15:21.52,Japanese,,0,0,0,,シングルファーザーと つきあうんですか？
Dialogue: 0,0:15:21.52,0:15:23.56,Japanese,,0,0,0,,あれは終わってる
Dialogue: 0,0:15:23.56,0:15:26.39,Japanese,,0,0,0,,終わってる？
Dialogue: 0,0:15:26.39,0:15:32.46,Japanese,,0,0,0,,田島君が求めてるのは 子供の母親になってくれる人だから
Dialogue: 0,0:15:32.46,0:15:38.20,Japanese,,0,0,0,,つまり 他の男がうんぬんではなく
Dialogue: 0,0:15:38.20,0:15:41.51,Japanese,,0,0,0,,僕自身に可能性がないってことだ
Dialogue: 0,0:15:44.78,0:15:47.51,Japanese,,0,0,0,,よく分かりました
Dialogue: 0,0:15:50.72,0:15:54.72,Japanese,,0,0,0,,また飲もう 山さんのバーでも
Dialogue: 0,0:15:56.42,0:16:01.36,Japanese,,0,0,0,,僕は百合さんを おばだとは思えないんで
Dialogue: 0,0:16:04.50,0:16:07.00,Japanese,,0,0,0,,これで終わりにします
Dialogue: 0,0:16:11.37,0:16:14.87,Japanese,,0,0,0,,ゆっくり味わって
Dialogue: 0,0:16:27.55,0:16:29.56,Japanese,,0,0,0,,おいしい
Dialogue: 0,0:16:39.00,0:16:41.00,Japanese,,0,0,0,,ありがとうございました
Dialogue: 0,0:16:42.87,0:16:44.80,Japanese,,0,0,0,,こんにちは
Dialogue: 0,0:16:44.80,0:16:46.47,Japanese,,0,0,0,,はじめまして
Dialogue: 0,0:16:46.47,0:16:50.84,Japanese,,0,0,0,,タウン誌｢わくわくいそいそ｣兼 青空市実行委員の森山と申します
Dialogue: 0,0:16:50.84,0:16:52.34,Japanese,,0,0,0,,よろしくお願いします
Dialogue: 0,0:16:52.34,0:16:55.55,Japanese,,0,0,0,,今日は 来月号に載せるお店の写真と
Dialogue: 0,0:16:55.55,0:16:59.98,Japanese,,0,0,0,,青空市のタイムサービスについて お願いにまいりました
Dialogue: 0,0:16:59.98,0:17:01.65,Japanese,,0,0,0,,はい どうぞ
Dialogue: 0,0:17:01.65,0:17:04.16,Japanese,,0,0,0,,ありがとうございました
Dialogue: 0,0:17:09.36,0:17:10.56,Japanese,,0,0,0,,はあ 疲れた
Dialogue: 0,0:17:10.56,0:17:11.60,Japanese,,0,0,0,,お疲れ
Dialogue: 0,0:17:11.60,0:17:13.23,Japanese,,0,0,0,,おなかすいた
Dialogue: 0,0:17:15.77,0:17:17.30,Japanese,,0,0,0,,はい あ～ん
Dialogue: 0,0:17:19.34,0:17:21.64,Japanese,,0,0,0,,やっさんの野菜カレー最高
Dialogue: 0,0:17:21.64,0:17:23.28,Japanese,,0,0,0,,毎日でも食べられる
Dialogue: 0,0:17:23.28,0:17:26.54,Japanese,,0,0,0,,みくりは いつも褒めてくれるから 作り甲斐がある
Dialogue: 0,0:17:26.54,0:17:28.25,Japanese,,0,0,0,,タダ飯 いただいてますから
Dialogue: 0,0:17:28.25,0:17:31.88,Japanese,,0,0,0,,現物支給しかできなくて ごめんですから
Dialogue: 0,0:17:31.88,0:17:34.29,Japanese,,0,0,0,,ジャムの通信販売どうなった？
Dialogue: 0,0:17:34.29,0:17:37.42,Japanese,,0,0,0,,クリアしなきゃいけないこと 山積み
Dialogue: 0,0:17:37.42,0:17:39.16,Japanese,,0,0,0,,加工場所も問題
Dialogue: 0,0:17:39.16,0:17:42.13,Japanese,,0,0,0,,いつまでも キッチン田中に頼ってらんないし
Dialogue: 0,0:17:42.13,0:17:45.16,Japanese,,0,0,0,,ご両親も自分の仕事あるもんね
Dialogue: 0,0:17:45.16,0:17:46.13,Japanese,,0,0,0,,そっちは？
Dialogue: 0,0:17:46.13,0:17:47.27,Japanese,,0,0,0,,保健所問題
Dialogue: 0,0:17:47.27,0:17:49.00,Japanese,,0,0,0,,昨日行って相談してきた
Dialogue: 0,0:17:49.00,0:17:52.74,Japanese,,0,0,0,,あと レンタル機材がねえ
Dialogue: 0,0:17:52.74,0:17:55.54,Japanese,,0,0,0,,予算と折り合いつかなくて
Dialogue: 0,0:17:55.54,0:17:57.21,Japanese,,0,0,0,,大変だ
Dialogue: 0,0:17:57.21,0:17:59.18,Japanese,,0,0,0,,お互いね
Dialogue: 0,0:17:59.18,0:18:00.18,Japanese,,0,0,0,,仕方ない
Dialogue: 0,0:18:00.18,0:18:01.58,Japanese,,0,0,0,,頑張ろう
Dialogue: 0,0:18:01.58,0:18:02.68,Japanese,,0,0,0,,生きよう
Dialogue: 0,0:18:02.68,0:18:05.05,Japanese,,0,0,0,,生きねば
Dialogue: 0,0:18:19.73,0:18:24.84,Japanese,,0,0,0,,２週間やってみて 率直な感想はどうですか？
Dialogue: 0,0:18:24.84,0:18:27.61,Japanese,,0,0,0,,率直でいいですか？
Dialogue: 0,0:18:27.61,0:18:29.21,Japanese,,0,0,0,,どうぞ
Dialogue: 0,0:18:29.21,0:18:32.18,Japanese,,0,0,0,,私の方が 格段に 稼ぎが少ないので
Dialogue: 0,0:18:32.18,0:18:35.85,Japanese,,0,0,0,,その分 家事の分担が多いのは 納得してるんですけど
Dialogue: 0,0:18:35.85,0:18:39.72,Japanese,,0,0,0,,それで平匡さんが 分担をやり忘れていたり
Dialogue: 0,0:18:39.72,0:18:42.05,Japanese,,0,0,0,,やるのが遅かったりすると
Dialogue: 0,0:18:42.05,0:18:44.49,Japanese,,0,0,0,,それ そっちの分担だよね
Dialogue: 0,0:18:44.49,0:18:47.59,Japanese,,0,0,0,,私より家事負担少ないよね
Dialogue: 0,0:18:47.59,0:18:50.30,Japanese,,0,0,0,,と思ってしまうことがあります
Dialogue: 0,0:18:51.56,0:18:53.50,Japanese,,0,0,0,,すいません
Dialogue: 0,0:18:55.47,0:18:58.77,Japanese,,0,0,0,,平匡さんの方は？
Dialogue: 0,0:18:58.77,0:19:01.87,Japanese,,0,0,0,,正直に言っていいですか？
Dialogue: 0,0:19:01.87,0:19:03.28,Japanese,,0,0,0,,どうぞ
Dialogue: 0,0:19:03.28,0:19:06.98,Japanese,,0,0,0,,みくりさんの掃除の 質の低下が気になっています
Dialogue: 0,0:19:06.98,0:19:09.52,Japanese,,0,0,0,,部屋の隅に埃がたまっていたり
Dialogue: 0,0:19:09.52,0:19:11.12,Japanese,,0,0,0,,鏡に水垢が
Dialogue: 0,0:19:11.12,0:19:17.59,Japanese,,0,0,0,,ホント言うと 私 そんなに几帳面じゃないんです
Dialogue: 0,0:19:17.59,0:19:19.09,Japanese,,0,0,0,,どちらかというと
Dialogue: 0,0:19:19.09,0:19:22.53,Japanese,,0,0,0,,四角い部屋を丸く掃くタイプで
Dialogue: 0,0:19:22.53,0:19:24.20,Japanese,,0,0,0,,でも 今までは……
Dialogue: 0,0:19:24.20,0:19:27.53,Japanese,,0,0,0,,仕事だったから 完璧にしなくちゃ と
Dialogue: 0,0:19:27.53,0:19:29.67,Japanese,,0,0,0,,念には念を入れてました
Dialogue: 0,0:19:29.67,0:19:31.70,Japanese,,0,0,0,,でも本当は
Dialogue: 0,0:19:31.70,0:19:35.17,Japanese,,0,0,0,,生活するのに 困らない程度に綺麗なら
Dialogue: 0,0:19:35.17,0:19:37.84,Japanese,,0,0,0,,生きていける と思ってます
Dialogue: 0,0:19:39.74,0:19:43.22,Japanese,,0,0,0,,ご期待に沿えず申し訳ありません
Dialogue: 0,0:19:46.58,0:19:48.49,Japanese,,0,0,0,,よほど気になるのであれば
Dialogue: 0,0:19:48.49,0:19:50.82,Japanese,,0,0,0,,その箇所を平匡さんの分担にして
Dialogue: 0,0:19:50.82,0:19:52.59,Japanese,,0,0,0,,その代わり 他の箇所を私が……
Dialogue: 0,0:19:52.59,0:19:53.49,Japanese,,0,0,0,,いえ
Dialogue: 0,0:19:53.49,0:19:55.76,Japanese,,0,0,0,,僕の担当を増やしましょう
Dialogue: 0,0:20:02.23,0:20:04.54,Japanese,,0,0,0,,青空市？
Dialogue: 0,0:20:04.54,0:20:06.67,Japanese,,0,0,0,,奥さん 専業主婦じゃなかったんだ？
Dialogue: 0,0:20:06.67,0:20:09.07,Japanese,,0,0,0,,少し前まで そうだったんですが
Dialogue: 0,0:20:09.07,0:20:12.88,Japanese,,0,0,0,,今は ﾀｳﾝ誌のﾗｲﾀｰと ｲﾍﾞﾝﾀｰと あと主婦の
Dialogue: 0,0:20:12.88,0:20:15.41,Japanese,,0,0,0,,三足のわらじで
Dialogue: 0,0:20:15.41,0:20:18.28,Japanese,,0,0,0,,どうりで おかずの品数 減ってると思った
Dialogue: 0,0:20:18.28,0:20:20.45,Japanese,,0,0,0,,うちのと変わんないもん ほら
Dialogue: 0,0:20:20.45,0:20:25.29,Japanese,,0,0,0,,こないだから もしかして そうなのかもと思っていたが
Dialogue: 0,0:20:25.29,0:20:27.33,Japanese,,0,0,0,,津崎君と みくりさんは
Dialogue: 0,0:20:27.33,0:20:29.03,Japanese,,0,0,0,,好き同士なのかい？
Dialogue: 0,0:20:30.66,0:20:31.96,Japanese,,0,0,0,,ﾊﾟｯｼｮﾝなのかい？
Dialogue: 0,0:20:31.96,0:20:34.30,Japanese,,0,0,0,,結婚してるんだし当たり前でしょ
Dialogue: 0,0:20:34.30,0:20:35.77,Japanese,,0,0,0,,日野君
Dialogue: 0,0:20:35.77,0:20:38.57,Japanese,,0,0,0,,当たり前が 当たり前じゃないときだってある
Dialogue: 0,0:20:38.57,0:20:42.74,Japanese,,0,0,0,,世の中にはね 目に見えない ﾀﾞｰｸﾏﾀｰだって存在するんだよ
Dialogue: 0,0:20:42.74,0:20:45.11,Japanese,,0,0,0,,ﾊﾟｯｼｮﾝかどうか分かりませんが
Dialogue: 0,0:20:45.11,0:20:47.08,Japanese,,0,0,0,,好きです
Dialogue: 0,0:20:47.08,0:20:50.69,Japanese,,0,0,0,,ですが 好きだけでは やっていけないこともあると
Dialogue: 0,0:20:50.71,0:20:53.45,Japanese,,0,0,0,,実感しています
Dialogue: 0,0:20:53.45,0:20:56.62,Japanese,,0,0,0,,実は今 共働きｼﾐｭﾚｰｼｮﾝと称して
Dialogue: 0,0:20:56.62,0:20:58.72,Japanese,,0,0,0,,家事を分担してるんです
Dialogue: 0,0:20:58.72,0:21:01.09,Japanese,,0,0,0,,家事代行を 頼んでたくらいなのに？
Dialogue: 0,0:21:01.09,0:21:04.00,Japanese,,0,0,0,,正直 面倒です
Dialogue: 0,0:21:04.00,0:21:06.36,Japanese,,0,0,0,,できればやりたくない とも……
Dialogue: 0,0:21:41.33,0:21:42.30,Japanese,,0,0,0,,お帰りなさい
Dialogue: 0,0:21:42.30,0:21:43.64,Japanese,,0,0,0,,ごめんなさい 遅くなって
Dialogue: 0,0:21:43.64,0:21:44.44,Japanese,,0,0,0,,いいえ
Dialogue: 0,0:21:44.44,0:21:48.01,Japanese,,0,0,0,,商店街の残り物 せしめてきたんで すぐ ご飯にしましょう
Dialogue: 0,0:21:48.01,0:21:49.54,Japanese,,0,0,0,,はい。
Dialogue: 0,0:21:54.28,0:21:55.38,Japanese,,0,0,0,,ご飯って……
Dialogue: 0,0:21:55.38,0:21:57.35,Japanese,,0,0,0,,みくりさん！
Dialogue: 0,0:21:57.35,0:22:01.05,Japanese,,0,0,0,,今日 出前にしては？
Dialogue: 0,0:22:01.05,0:22:04.42,Japanese,,0,0,0,,ピザ 食べたいなあ
Dialogue: 0,0:22:04.42,0:22:08.49,Japanese,,0,0,0,,でも お総菜もあるし
Dialogue: 0,0:22:08.49,0:22:11.00,Japanese,,0,0,0,,あまり 揚げ物の気分では
Dialogue: 0,0:22:11.00,0:22:11.76,Japanese,,0,0,0,,気分……
Dialogue: 0,0:22:11.76,0:22:13.86,Japanese,,0,0,0,,胃に重いなあ
Dialogue: 0,0:22:13.86,0:22:16.90,Japanese,,0,0,0,,ピザのが よっぽど重いです
Dialogue: 0,0:22:16.90,0:22:18.10,Japanese,,0,0,0,,外食にしては？
Dialogue: 0,0:22:18.10,0:22:20.30,Japanese,,0,0,0,,月に一度の外食 前に言ってた
Dialogue: 0,0:22:20.30,0:22:21.11,Japanese,,0,0,0,,今から？
Dialogue: 0,0:22:21.11,0:22:22.94,Japanese,,0,0,0,,みくりさんも お疲れのようですし
Dialogue: 0,0:22:22.94,0:22:26.81,Japanese,,0,0,0,,疲れてるから 今すぐ ご飯にしたいんです
Dialogue: 0,0:22:29.01,0:22:32.05,Japanese,,0,0,0,,外に ご飯を
Dialogue: 0,0:22:35.45,0:22:37.39,Japanese,,0,0,0,,ジュウシマツが
Dialogue: 0,0:22:37.39,0:22:39.39,Japanese,,0,0,0,,ぺろお ぺろこ
Dialogue: 0,0:22:39.39,0:22:40.62,Japanese,,0,0,0,,いつの間に名前を？
Dialogue: 0,0:22:40.62,0:22:42.86,Japanese,,0,0,0,,ぺろこの方が倒れてます
Dialogue: 0,0:22:44.40,0:22:45.66,Japanese,,0,0,0,,いや倒れて……
Dialogue: 0,0:22:50.94,0:22:53.34,Japanese,,0,0,0,,こんなことだろうと思いました
Dialogue: 0,0:22:54.61,0:22:58.31,Japanese,,0,0,0,,子供じゃないんだから 隠したってしょうがないでしょ
Dialogue: 0,0:22:58.31,0:23:00.95,Japanese,,0,0,0,,すいません つい
Dialogue: 0,0:23:03.52,0:23:04.82,Japanese,,0,0,0,,チンするご飯 買ってきます
Dialogue: 0,0:23:04.82,0:23:05.72,Japanese,,0,0,0,,なら 僕が
Dialogue: 0,0:23:05.72,0:23:07.52,Japanese,,0,0,0,,いいです 私コート着てるし
Dialogue: 0,0:23:07.52,0:23:09.02,Japanese,,0,0,0,,では一緒に
Dialogue: 0,0:23:09.02,0:23:12.39,Japanese,,0,0,0,,食事の担当は私なのに 頼んだ私が悪いんで
Dialogue: 0,0:23:12.39,0:23:14.56,Japanese,,0,0,0,,私が行ってきます
Dialogue: 0,0:23:33.78,0:23:37.15,Japanese,,0,0,0,,今日は きちんと言おうと思った
Dialogue: 0,0:23:38.42,0:23:43.36,Japanese,,0,0,0,,僕が五十嵐さんを 好きになることは絶対にない
Dialogue: 0,0:23:43.36,0:23:45.12,Japanese,,0,0,0,,絶対ですか？
Dialogue: 0,0:23:45.12,0:23:48.09,Japanese,,0,0,0,,君と僕は似てるように思う
Dialogue: 0,0:23:48.09,0:23:54.97,Japanese,,0,0,0,,男に消費されるくらいなら 消費してやろうって発想
Dialogue: 0,0:23:54.97,0:23:58.30,Japanese,,0,0,0,,男と女なんて しょせん その程度のものだから
Dialogue: 0,0:23:58.30,0:24:00.97,Japanese,,0,0,0,,都合良く楽しめばいい
Dialogue: 0,0:24:00.97,0:24:04.18,Japanese,,0,0,0,,そう思ってるんじゃないかな
Dialogue: 0,0:24:04.18,0:24:07.41,Japanese,,0,0,0,,分かるなら話が早いです
Dialogue: 0,0:24:07.41,0:24:09.92,Japanese,,0,0,0,,私達 お似合いだと思いません？
Dialogue: 0,0:24:09.92,0:24:12.05,Japanese,,0,0,0,,以前ならね
Dialogue: 0,0:24:12.05,0:24:17.49,Japanese,,0,0,0,,何と 十数年ぶりに恋をしたんだ
Dialogue: 0,0:24:18.76,0:24:25.36,Japanese,,0,0,0,,自分でも滑稽なくらい 一人の人を思ってる
Dialogue: 0,0:24:26.20,0:24:28.83,Japanese,,0,0,0,,土屋部長～
Dialogue: 0,0:24:28.83,0:24:32.37,Japanese,,0,0,0,,昇進おめでとうございま～す
Dialogue: 0,0:24:32.37,0:24:33.40,Japanese,,0,0,0,,いやいや まだなってない
Dialogue: 0,0:24:33.40,0:24:35.14,Japanese,,0,0,0,,堀内 入る
Dialogue: 0,0:24:35.14,0:24:38.71,Japanese,,0,0,0,,はい 堀内入ります！
Dialogue: 0,0:24:42.95,0:24:45.02,Japanese,,0,0,0,,はあ 酔ってたねえ 珍しく
Dialogue: 0,0:24:45.02,0:24:46.78,Japanese,,0,0,0,,俺も まあまあ酔ってます
Dialogue: 0,0:24:46.78,0:24:49.02,Japanese,,0,0,0,,私も まあまあ
Dialogue: 0,0:24:49.02,0:24:51.29,Japanese,,0,0,0,,百合さん 何て？
Dialogue: 0,0:24:51.29,0:24:52.52,Japanese,,0,0,0,,返信来ない
Dialogue: 0,0:24:52.52,0:24:54.56,Japanese,,0,0,0,,まだ仕事かな？
Dialogue: 0,0:24:54.56,0:24:58.70,Japanese,,0,0,0,,うちの会社もさ こないだから ずーっとゴタゴタしてて
Dialogue: 0,0:24:58.70,0:25:00.66,Japanese,,0,0,0,,ようやく来られた
Dialogue: 0,0:25:00.66,0:25:01.87,Japanese,,0,0,0,,大変だった？
Dialogue: 0,0:25:01.87,0:25:05.00,Japanese,,0,0,0,,大変だった
Dialogue: 0,0:25:05.00,0:25:09.34,Japanese,,0,0,0,,心のオアシスは ＬＩＮＥのやりとりだけ
Dialogue: 0,0:25:13.14,0:25:16.35,Japanese,,0,0,0,,イケメンの人
Dialogue: 0,0:25:16.35,0:25:18.88,Japanese,,0,0,0,,ハードル越えなかったんですか？
Dialogue: 0,0:25:22.95,0:25:26.36,Japanese,,0,0,0,,好きなら行っちゃえばいいのに
Dialogue: 0,0:25:26.36,0:25:27.86,Japanese,,0,0,0,,若さがあればね
Dialogue: 0,0:25:27.86,0:25:32.50,Japanese,,0,0,0,,そうやって あれこれ考えるから ダメなんですよ
Dialogue: 0,0:25:32.50,0:25:35.03,Japanese,,0,0,0,,前も言ってたねえ
Dialogue: 0,0:25:35.03,0:25:42.51,Japanese,,0,0,0,,俺は 俺の好きな人に 会いたくても会えないんで
Dialogue: 0,0:25:48.95,0:25:51.85,Japanese,,0,0,0,,嫉妬です うらやましいんです
Dialogue: 0,0:25:52.88,0:25:58.39,Japanese,,0,0,0,,世界中の 自由に会える人達が
Dialogue: 0,0:26:39.30,0:26:44.14,Japanese,,0,0,0,,今日の私は 最低だった
Dialogue: 0,0:26:44.14,0:26:49.57,Japanese,,0,0,0,,余裕がないと 途端に本性が顔を出す。
Dialogue: 0,0:26:49.57,0:26:51.88,Japanese,,0,0,0,,お前 小賢しいだよ
Dialogue: 0,0:26:51.88,0:26:54.61,Japanese,,0,0,0,,生意気で 偉そうで
Dialogue: 0,0:26:54.61,0:26:57.15,Japanese,,0,0,0,,カヲル君 そういうところ 直した方がいいよ
Dialogue: 0,0:26:57.15,0:27:01.09,Japanese,,0,0,0,,小賢しい みくりが
Dialogue: 0,0:27:02.62,0:27:06.96,Japanese,,0,0,0,,私は自分が嫌いだ
Dialogue: 0,0:27:08.26,0:27:13.26,Japanese,,0,0,0,,自尊感情が低いのは 私の方だ。
Dialogue: 0,0:27:14.26,0:27:19.10,Japanese,,0,0,0,,平匡さんが愛したのは 家事を完璧にこなす
Dialogue: 0,0:27:19.10,0:27:24.68,Japanese,,0,0,0,,いつも笑顔で優しい 理想の妻で
Dialogue: 0,0:27:24.68,0:27:30.08,Japanese,,0,0,0,,お米一つで ひどい態度を取る女じゃない
Dialogue: 0,0:27:34.75,0:27:37.66,Japanese,,0,0,0,,選ばれたくて
Dialogue: 0,0:27:37.66,0:27:41.43,Japanese,,0,0,0,,認めてほしくて
Dialogue: 0,0:27:41.43,0:27:43.73,Japanese,,0,0,0,,なのに
Dialogue: 0,0:27:43.73,0:27:47.13,Japanese,,0,0,0,,なりたい自分から
Dialogue: 0,0:27:47.13,0:27:49.40,Japanese,,0,0,0,,どんどん遠ざかる。
Dialogue: 0,0:28:12.89,0:28:15.53,Japanese,,0,0,0,,相席いいですか？
Dialogue: 0,0:28:15.53,0:28:17.86,Japanese,,0,0,0,,他にも空いてる席 あるみたいだけど
Dialogue: 0,0:28:17.86,0:28:21.93,Japanese,,0,0,0,,お姉さんと風見さんって どういう関係なんですか？
Dialogue: 0,0:28:21.93,0:28:24.07,Japanese,,0,0,0,,17歳も違うのに
Dialogue: 0,0:28:24.07,0:28:28.47,Japanese,,0,0,0,,恋愛対象ってことは ないですよね？
Dialogue: 0,0:28:28.47,0:28:30.88,Japanese,,0,0,0,,年まで よくご存じで
Dialogue: 0,0:28:30.88,0:28:34.12,Japanese,,0,0,0,,50にもなって 若い男に色目使うなんて
Dialogue: 0,0:28:34.14,0:28:35.95,Japanese,,0,0,0,,むなしくなりませんか？
Dialogue: 0,0:28:35.95,0:28:37.95,Japanese,,0,0,0,,訂正箇所が多すぎて
Dialogue: 0,0:28:37.95,0:28:39.48,Japanese,,0,0,0,,どこから赤を入れたらいいものか
Dialogue: 0,0:28:39.48,0:28:41.49,Japanese,,0,0,0,,正確には49歳
Dialogue: 0,0:28:41.49,0:28:44.16,Japanese,,0,0,0,,でも周りから見れば同じです
Dialogue: 0,0:28:44.16,0:28:46.92,Japanese,,0,0,0,,アンチエイジングに お金を出す女はいるけど
Dialogue: 0,0:28:46.92,0:28:51.06,Japanese,,0,0,0,,老いを進んで買う女はいない
Dialogue: 0,0:28:51.06,0:28:55.70,Japanese,,0,0,0,,あなたは随分と自分の若さに 価値を見いだしているのね
Dialogue: 0,0:28:55.70,0:28:59.57,Japanese,,0,0,0,,お姉さんの半分の年なので
Dialogue: 0,0:29:00.77,0:29:05.21,Japanese,,0,0,0,,私が むなしさを 感じることがあるとすれば
Dialogue: 0,0:29:05.21,0:29:07.62,Japanese,,0,0,0,,あなたと同じように感じている 女性が
Dialogue: 0,0:29:07.65,0:29:11.32,Japanese,,0,0,0,,この国には たくさんいる ということ
Dialogue: 0,0:29:11.32,0:29:14.45,Japanese,,0,0,0,,今 あなたが 価値がないと切り捨てたものは
Dialogue: 0,0:29:14.45,0:29:17.56,Japanese,,0,0,0,,この先 あなたが向かっていく 未来でもあるのよ
Dialogue: 0,0:29:17.56,0:29:20.49,Japanese,,0,0,0,,自分がバカにしていたものに 自分がなる
Dialogue: 0,0:29:20.49,0:29:23.73,Japanese,,0,0,0,,それって つらいんじゃないかな？
Dialogue: 0,0:29:23.73,0:29:28.27,Japanese,,0,0,0,,私達の周りにはね たくさんの呪いがあるの
Dialogue: 0,0:29:28.27,0:29:32.54,Japanese,,0,0,0,,あなたが感じているのも その一つ
Dialogue: 0,0:29:33.80,0:29:37.14,Japanese,,0,0,0,,自分に呪いをかけないで
Dialogue: 0,0:29:37.14,0:29:42.21,Japanese,,0,0,0,,そんな恐ろしい呪いからは さっさと逃げてしまいなさい
Dialogue: 0,0:30:01.63,0:30:03.74,Japanese,,0,0,0,,お待たせしました
Dialogue: 0,0:30:03.74,0:30:06.24,Japanese,,0,0,0,,お風呂場 狭くないですか？
Dialogue: 0,0:30:06.24,0:30:08.64,Japanese,,0,0,0,,集中できるので
Dialogue: 0,0:30:11.18,0:30:13.91,Japanese,,0,0,0,,よろしくお願いします
Dialogue: 0,0:30:13.91,0:30:18.82,Japanese,,0,0,0,,分担の変更から１週間 率直な感想は？
Dialogue: 0,0:30:21.82,0:30:23.96,Japanese,,0,0,0,,じゃあ僕から
Dialogue: 0,0:30:23.96,0:30:30.36,Japanese,,0,0,0,,僕が思ったのは分担って 結構やっかいだなということです
Dialogue: 0,0:30:30.36,0:30:35.17,Japanese,,0,0,0,,分担した仕事を相手ができていないと マイナスに感じる
Dialogue: 0,0:30:35.17,0:30:37.54,Japanese,,0,0,0,,一方 できている場合でも
Dialogue: 0,0:30:37.54,0:30:40.90,Japanese,,0,0,0,,担当なんだし やって当然 と思ってしまって
Dialogue: 0,0:30:40.90,0:30:43.64,Japanese,,0,0,0,,感謝の気持ちが持てない
Dialogue: 0,0:30:43.64,0:30:47.88,Japanese,,0,0,0,,もしかすると 相手を 積極的に評価するｼｽﾃﾑが必要で
Dialogue: 0,0:30:47.88,0:30:49.71,Japanese,,0,0,0,,食事
Dialogue: 0,0:30:49.71,0:30:54.25,Japanese,,0,0,0,,私の担当なのに 満足に作れてなくてごめんなさい
Dialogue: 0,0:30:54.25,0:30:57.62,Japanese,,0,0,0,,いや 責めているわけでは……
Dialogue: 0,0:30:57.62,0:31:01.36,Japanese,,0,0,0,,いっそ 役割分担をやめましょうか
Dialogue: 0,0:31:01.36,0:31:05.76,Japanese,,0,0,0,,シェアハウスみたいに 自分のことは自分でやるんです
Dialogue: 0,0:31:05.76,0:31:09.43,Japanese,,0,0,0,,一人でも ご飯を作ったり 掃除したりしますよね
Dialogue: 0,0:31:09.43,0:31:12.97,Japanese,,0,0,0,,それだと 共通スペースを どちらも掃除しない可能性が
Dialogue: 0,0:31:12.97,0:31:16.61,Japanese,,0,0,0,,じゃ家事の全部 私がやります
Dialogue: 0,0:31:16.61,0:31:20.21,Japanese,,0,0,0,,でも それはボランティアです
Dialogue: 0,0:31:20.21,0:31:21.04,Japanese,,0,0,0,,ボ…… ボランティア
Dialogue: 0,0:31:21.04,0:31:23.11,Japanese,,0,0,0,,あくまで ボランティアなので
Dialogue: 0,0:31:23.11,0:31:27.75,Japanese,,0,0,0,,私が｢今日はご飯作りたくない｣ と思ったら作らないし
Dialogue: 0,0:31:27.75,0:31:31.32,Japanese,,0,0,0,,｢今日は掃除したくない｣ と思ったら掃除しません
Dialogue: 0,0:31:31.32,0:31:32.39,Japanese,,0,0,0,,ﾎﾞﾗﾝﾃｨｱだから
Dialogue: 0,0:31:32.39,0:31:34.66,Japanese,,0,0,0,,｢ご飯ないんですか｣ とか言わないで
Dialogue: 0,0:31:34.66,0:31:36.76,Japanese,,0,0,0,,｢部屋が汚い｣とか言わないで
Dialogue: 0,0:31:36.76,0:31:40.70,Japanese,,0,0,0,,だってボランティアだから 仕事じゃないから
Dialogue: 0,0:31:42.67,0:31:46.24,Japanese,,0,0,0,,み…… みくりさん 話の方向性が
Dialogue: 0,0:31:55.95,0:31:58.65,Japanese,,0,0,0,,やめるなら
Dialogue: 0,0:31:58.65,0:32:00.55,Japanese,,0,0,0,,今です
Dialogue: 0,0:32:01.52,0:32:07.69,Japanese,,0,0,0,,平匡さんだって 面倒ですよね こんな生活
Dialogue: 0,0:32:09.26,0:32:11.90,Japanese,,0,0,0,,私と暮らす前みたいに
Dialogue: 0,0:32:11.90,0:32:14.26,Japanese,,0,0,0,,外部の家事代行業者に
Dialogue: 0,0:32:14.26,0:32:18.57,Japanese,,0,0,0,,週に一度頼む程度のお給料なら あるはずです
Dialogue: 0,0:32:19.84,0:32:22.57,Japanese,,0,0,0,,一人なら
Dialogue: 0,0:32:22.57,0:32:29.05,Japanese,,0,0,0,,主婦の労働の対価がどうとか 小賢しいこと言わないで
Dialogue: 0,0:32:29.05,0:32:34.60,Japanese,,0,0,0,,平匡さんのプロポーズを 素直に喜んでくれる女性は
Dialogue: 0,0:32:34.63,0:32:36.78,Japanese,,0,0,0,,たくさんいます
Dialogue: 0,0:32:38.29,0:32:42.23,Japanese,,0,0,0,,それが 普通です
Dialogue: 0,0:32:44.10,0:32:49.47,Japanese,,0,0,0,,面倒を背負う必要はありません
Dialogue: 0,0:33:17.43,0:33:20.60,Japanese,,0,0,0,,みくりさんが閉じたシャッターは
Dialogue: 0,0:33:20.60,0:33:22.70,Japanese,,0,0,0,,風見さんと交代しても いいですよ
Dialogue: 0,0:33:22.70,0:33:25.24,Japanese,,0,0,0,,詮索も分析も やめてください
Dialogue: 0,0:33:25.24,0:33:30.88,Japanese,,0,0,0,,いつか 僕が閉じた物と同じかもしれない
Dialogue: 0,0:33:30.88,0:33:33.38,Japanese,,0,0,0,,だとしたら
Dialogue: 0,0:33:34.54,0:33:39.42,Japanese,,0,0,0,,開け方を知っている。
Dialogue: 0,0:33:39.42,0:33:41.79,Japanese,,0,0,0,,私の恋人になってもらえませんか。
Dialogue: 0,0:33:41.79,0:33:44.12,Japanese,,0,0,0,,何度も何度も飽きれるほど
Dialogue: 0,0:33:44.12,0:33:45.76,Japanese,,0,0,0,,スキンシップはどうでしょう？
Dialogue: 0,0:33:45.76,0:33:47.26,Japanese,,0,0,0,,まずは ハグから
Dialogue: 0,0:33:47.26,0:33:50.60,Japanese,,0,0,0,,見捨てずに ノックしてくれたのは
Dialogue: 0,0:33:50.60,0:33:52.90,Japanese,,0,0,0,,どんどん好きになっちゃうじゃ ないですか
Dialogue: 0,0:33:52.90,0:33:53.86,Japanese,,0,0,0,,バカ！
Dialogue: 0,0:33:53.86,0:33:57.77,Japanese,,0,0,0,,他の誰でもない
Dialogue: 0,0:33:57.77,0:34:00.10,Japanese,,0,0,0,,みくりさんだ。
Dialogue: 0,0:34:04.88,0:34:07.54,Japanese,,0,0,0,,お仕事中すいません
Dialogue: 0,0:34:07.54,0:34:10.01,Japanese,,0,0,0,,話してもいいですか？
Dialogue: 0,0:34:18.02,0:34:21.93,Japanese,,0,0,0,,面倒を避けて 避けて
Dialogue: 0,0:34:21.93,0:34:25.83,Japanese,,0,0,0,,極限まで避け続けたら
Dialogue: 0,0:34:25.83,0:34:31.14,Japanese,,0,0,0,,歩くのも食べるのも面倒になって
Dialogue: 0,0:34:31.14,0:34:35.94,Japanese,,0,0,0,,息をするのも面倒になって
Dialogue: 0,0:34:37.31,0:34:42.51,Japanese,,0,0,0,,限りなく死に近づくんじゃ ないでしょうか？
Dialogue: 0,0:34:49.72,0:34:51.66,Japanese,,0,0,0,,はい？
Dialogue: 0,0:34:54.76,0:34:58.70,Japanese,,0,0,0,,生きていくのって 面倒くさいんです
Dialogue: 0,0:35:00.50,0:35:04.54,Japanese,,0,0,0,,それは一人でも二人でも同じで
Dialogue: 0,0:35:04.54,0:35:09.61,Japanese,,0,0,0,,それぞれ別の面倒くささがあって
Dialogue: 0,0:35:09.61,0:35:14.41,Japanese,,0,0,0,,どっちにしても 面倒くさいんだったら
Dialogue: 0,0:35:14.41,0:35:18.42,Japanese,,0,0,0,,一緒にいるのも 手じゃないでしょうか？
Dialogue: 0,0:35:19.65,0:35:21.85,Japanese,,0,0,0,,話し合ったり
Dialogue: 0,0:35:21.85,0:35:26.96,Japanese,,0,0,0,,無理なときは時間をおいたり
Dialogue: 0,0:35:26.96,0:35:29.93,Japanese,,0,0,0,,だましだましでも
Dialogue: 0,0:35:29.93,0:35:33.03,Japanese,,0,0,0,,何とか やっていけないでしょうか？
Dialogue: 0,0:35:33.03,0:35:37.24,Japanese,,0,0,0,,やってやれないことは ないんじゃないでしょうか
Dialogue: 0,0:35:37.24,0:35:44.21,Japanese,,0,0,0,,みくりさんは 自分のことを 普通じゃないと言ったけど
Dialogue: 0,0:35:44.21,0:35:46.74,Japanese,,0,0,0,,僕からしたら
Dialogue: 0,0:35:46.74,0:35:49.81,Japanese,,0,0,0,,今さらです
Dialogue: 0,0:35:49.81,0:35:52.42,Japanese,,0,0,0,,とっくに知ってました
Dialogue: 0,0:35:53.48,0:35:56.59,Japanese,,0,0,0,,大したことじゃありません
Dialogue: 0,0:35:58.19,0:36:01.12,Japanese,,0,0,0,,世間の常識からすれば
Dialogue: 0,0:36:02.49,0:36:04.66,Japanese,,0,0,0,,僕達は
Dialogue: 0,0:36:04.66,0:36:07.83,Japanese,,0,0,0,,最初から普通じゃなかった
Dialogue: 0,0:36:12.50,0:36:15.34,Japanese,,0,0,0,,今さらですよ
Dialogue: 0,0:36:24.38,0:36:29.12,Japanese,,0,0,0,,青空市 楽しみにしてます
Dialogue: 0,0:36:34.99,0:36:38.76,Japanese,,0,0,0,,おやすみなさい
Dialogue: 0,0:36:47.64,0:36:50.44,Japanese,,0,0,0,,うまく行かない時
Dialogue: 0,0:36:52.54,0:36:55.61,Japanese,,0,0,0,,待っていてくれる人
Dialogue: 0,0:36:55.61,0:36:58.35,Japanese,,0,0,0,,信じてくれる人
Dialogue: 0,0:36:59.72,0:37:02.35,Japanese,,0,0,0,,見失っちゃいけない
Dialogue: 0,0:37:07.19,0:37:11.20,Japanese,,0,0,0,,立て直そう 一つ一つ
Dialogue: 0,0:37:13.40,0:37:15.87,Japanese,,0,0,0,,立て直そう
Dialogue: 0,0:37:15.87,0:37:17.64,Japanese,,0,0,0,,ゆっくりでも
Dialogue: 0,0:37:18.34,0:37:20.87,Japanese,,0,0,0,,靴 お安くなってま～す
Dialogue: 0,0:37:21.57,0:37:24.38,Japanese,,0,0,0,,３本で200円ですよ お得ですよ～
Dialogue: 0,0:37:24.38,0:37:25.61,Japanese,,0,0,0,,いらっしゃいませ
Dialogue: 0,0:37:25.61,0:37:26.58,Japanese,,0,0,0,,おせんべい いかがですか～
Dialogue: 0,0:37:26.58,0:37:30.08,Japanese,,0,0,0,,どういうことよ！
Dialogue: 0,0:37:30.08,0:37:31.45,Japanese,,0,0,0,,みくりさん 大変
Dialogue: 0,0:37:31.45,0:37:33.35,Japanese,,0,0,0,,チラシ行方不明
Dialogue: 0,0:37:33.35,0:37:34.62,Japanese,,0,0,0,,ホントに持ってきたの？
Dialogue: 0,0:37:34.62,0:37:37.29,Japanese,,0,0,0,,商店街の案内 配らないと意味ない
Dialogue: 0,0:37:37.29,0:37:38.36,Japanese,,0,0,0,,そうなんだよね～
Dialogue: 0,0:37:38.36,0:37:41.12,Japanese,,0,0,0,,分かったぞ！
Dialogue: 0,0:37:44.36,0:37:47.80,Japanese,,0,0,0,,チラシを 軽トラの荷台に積んでて
Dialogue: 0,0:37:47.80,0:37:50.43,Japanese,,0,0,0,,風で 全部飛んだ！
Dialogue: 0,0:37:50.43,0:37:51.44,Japanese,,0,0,0,,アホか
Dialogue: 0,0:37:51.44,0:37:53.60,Japanese,,0,0,0,,１枚だけ
Dialogue: 0,0:37:54.84,0:37:55.91,Japanese,,0,0,0,,コピーしてきます
Dialogue: 0,0:37:55.91,0:37:58.51,Japanese,,0,0,0,,皆さんは自分のお店を
Dialogue: 0,0:37:58.51,0:38:00.04,Japanese,,0,0,0,,ごめんね
Dialogue: 0,0:38:00.04,0:38:01.78,Japanese,,0,0,0,,みくり～
Dialogue: 0,0:38:01.78,0:38:03.28,Japanese,,0,0,0,,百合ちゃん 沼田さん
Dialogue: 0,0:38:03.28,0:38:06.25,Japanese,,0,0,0,,すごいじゃない 楽しそう～
Dialogue: 0,0:38:06.25,0:38:09.65,Japanese,,0,0,0,,ごめん百合ちゃん 行ってくる
Dialogue: 0,0:38:09.65,0:38:12.52,Japanese,,0,0,0,,触り足りな～い
Dialogue: 0,0:38:12.52,0:38:15.03,Japanese,,0,0,0,,百合さん 沼田さん
Dialogue: 0,0:38:15.03,0:38:16.19,Japanese,,0,0,0,,日野君は？
Dialogue: 0,0:38:16.19,0:38:18.56,Japanese,,0,0,0,,また お子さんが熱を出したそうで
Dialogue: 0,0:38:18.56,0:38:19.60,Japanese,,0,0,0,,また～
Dialogue: 0,0:38:19.60,0:38:20.86,Japanese,,0,0,0,,残念です
Dialogue: 0,0:38:20.86,0:38:24.20,Japanese,,0,0,0,,そういう運命なんだろうな～
Dialogue: 0,0:38:24.20,0:38:25.74,Japanese,,0,0,0,,みくり どっか行っちゃったよ
Dialogue: 0,0:38:25.74,0:38:29.67,Japanese,,0,0,0,,さっき 走ってくところ見ました
Dialogue: 0,0:38:29.67,0:38:33.21,Japanese,,0,0,0,,みくりさん あんな走れたんだなあ
Dialogue: 0,0:38:33.21,0:38:35.41,Japanese,,0,0,0,,何よ その感想
Dialogue: 0,0:38:35.41,0:38:37.45,Japanese,,0,0,0,,愛だね
Dialogue: 0,0:38:40.28,0:38:44.22,Japanese,,0,0,0,,誰だよ ゴミ捨てたヤツ
Dialogue: 0,0:38:44.22,0:38:45.22,Japanese,,0,0,0,,どうする？
Dialogue: 0,0:38:45.22,0:38:48.22,Japanese,,0,0,0,,土屋さんだったら拾うな
Dialogue: 0,0:38:48.22,0:38:50.36,Japanese,,0,0,0,,よしッ じゃあ拾うか
Dialogue: 0,0:38:50.36,0:38:52.10,Japanese,,0,0,0,,何だかんだ言って
Dialogue: 0,0:38:52.12,0:38:56.69,Japanese,,0,0,0,,年齢っていう呪縛に 一番縛られてたのは私なのよね
Dialogue: 0,0:38:57.97,0:39:00.77,Japanese,,0,0,0,,おじけづいちゃったのよ
Dialogue: 0,0:39:00.77,0:39:04.18,Japanese,,0,0,0,,自分の年に引け目を感じて つきあうよりも
Dialogue: 0,0:39:04.18,0:39:07.18,Japanese,,0,0,0,,友達でいた方がいいかな って
Dialogue: 0,0:39:07.18,0:39:11.55,Japanese,,0,0,0,,そう都合良くいかなかった
Dialogue: 0,0:39:11.55,0:39:15.22,Japanese,,0,0,0,,俺も おじけづいてたとこある
Dialogue: 0,0:39:15.22,0:39:17.76,Japanese,,0,0,0,,いつもフラれちゃうから
Dialogue: 0,0:39:17.76,0:39:21.19,Japanese,,0,0,0,,決定的なメールは送らなくて
Dialogue: 0,0:39:21.19,0:39:25.46,Japanese,,0,0,0,,避けて 避けて 引き延ばしてた
Dialogue: 0,0:39:25.46,0:39:27.80,Japanese,,0,0,0,,お互い ダメな大人
Dialogue: 0,0:39:27.80,0:39:30.67,Japanese,,0,0,0,,何を守ってんだかねえ
Dialogue: 0,0:39:30.67,0:39:34.04,Japanese,,0,0,0,,ねえ メールしてみる？
Dialogue: 0,0:39:34.04,0:39:36.54,Japanese,,0,0,0,,私もするから
Dialogue: 0,0:39:39.58,0:39:43.65,Japanese,,0,0,0,,みじめな結果に終わったら 骨を拾ってちょうだい
Dialogue: 0,0:39:43.65,0:39:46.15,Japanese,,0,0,0,,じゃあ 俺の骨も
Dialogue: 0,0:39:46.15,0:39:49.35,Japanese,,0,0,0,,拾う 任せて
Dialogue: 0,0:39:49.35,0:39:52.16,Japanese,,0,0,0,,コピー機がトナー切れって 全然ありえないんですけど
Dialogue: 0,0:39:52.16,0:39:54.62,Japanese,,0,0,0,,他にコピーできる場所って……
Dialogue: 0,0:40:00.30,0:40:03.40,Japanese,,0,0,0,,チラシ！
Dialogue: 0,0:40:03.40,0:40:07.47,Japanese,,0,0,0,,ありがとうございます 百合ちゃんの部下の方達
Dialogue: 0,0:40:11.08,0:40:14.34,Japanese,,0,0,0,,私も｢百合さん｣って 呼んじゃおっかな～
Dialogue: 0,0:40:14.34,0:40:15.71,Japanese,,0,0,0,,やめて
Dialogue: 0,0:40:15.71,0:40:18.85,Japanese,,0,0,0,,それ 俺のハンドルネームだから
Dialogue: 0,0:40:20.12,0:40:24.46,Japanese,,0,0,0,,土屋さんの名前 勝手に借りてんの ゲイアプリで
Dialogue: 0,0:40:25.72,0:40:27.46,Japanese,,0,0,0,,えッ ゲイなの！？
Dialogue: 0,0:40:29.03,0:40:31.13,Japanese,,0,0,0,,内緒な
Dialogue: 0,0:40:31.13,0:40:34.40,Japanese,,0,0,0,,カミングアウトする勇気ないし
Dialogue: 0,0:40:39.74,0:40:43.01,Japanese,,0,0,0,,ゲイアプリで知り合った すげえ気の合う人がさ
Dialogue: 0,0:40:43.01,0:40:47.41,Japanese,,0,0,0,,近くで働いてるはずなんだけど 絶対会ってくんないの
Dialogue: 0,0:40:47.41,0:40:51.15,Japanese,,0,0,0,,俺のことは死んでると思ってくれ とか言って……
Dialogue: 0,0:40:53.02,0:40:53.85,Japanese,,0,0,0,,何？
Dialogue: 0,0:41:10.03,0:41:12.27,Japanese,,0,0,0,,ウソ……
Dialogue: 0,0:41:19.11,0:41:22.01,Japanese,,0,0,0,,ありました 配ってください！
Dialogue: 0,0:41:24.65,0:41:26.68,Japanese,,0,0,0,,250円のお返しです
Dialogue: 0,0:41:26.68,0:41:29.49,Japanese,,0,0,0,,ありがとうございました
Dialogue: 0,0:41:29.49,0:41:31.49,Japanese,,0,0,0,,やっさん 何させてんの！
Dialogue: 0,0:41:31.49,0:41:33.19,Japanese,,0,0,0,,一人でボーッとしてたから
Dialogue: 0,0:41:33.19,0:41:35.33,Japanese,,0,0,0,,ボーッとしてるようで してないの
Dialogue: 0,0:41:35.33,0:41:36.93,Japanese,,0,0,0,,あッ ノロケ
Dialogue: 0,0:41:36.93,0:41:39.30,Japanese,,0,0,0,,今のは ノロケではないと思います
Dialogue: 0,0:41:39.30,0:41:41.26,Japanese,,0,0,0,,津崎さん！
Dialogue: 0,0:41:44.20,0:41:45.07,Japanese,,0,0,0,,驚いた
Dialogue: 0,0:41:45.07,0:41:46.54,Japanese,,0,0,0,,-驚いた？ -はい！
Dialogue: 0,0:41:46.54,0:41:49.14,Japanese,,0,0,0,,子供が熱出したっての ウソ
Dialogue: 0,0:41:49.14,0:41:50.61,Japanese,,0,0,0,,日野さんですか？
Dialogue: 0,0:41:50.61,0:41:52.28,Japanese,,0,0,0,,-みくりちゃん？ -はい！
Dialogue: 0,0:41:52.28,0:41:54.34,Japanese,,0,0,0,,はあ もうついに会えた～
Dialogue: 0,0:41:54.34,0:41:55.75,Japanese,,0,0,0,,一生会えないかと思ってた
Dialogue: 0,0:41:55.75,0:41:58.22,Japanese,,0,0,0,,私もです～
Dialogue: 0,0:41:58.22,0:42:00.62,Japanese,,0,0,0,,わッ どうも会えて嬉しいです 何で感動してるの？
Dialogue: 0,0:42:00.62,0:42:02.89,Japanese,,0,0,0,,運命が覆った瞬間です
Dialogue: 0,0:42:02.89,0:42:04.96,Japanese,,0,0,0,,津崎さん
Dialogue: 0,0:42:07.49,0:42:09.39,Japanese,,0,0,0,,お久しぶりです
Dialogue: 0,0:42:09.39,0:42:10.66,Japanese,,0,0,0,,どうも
Dialogue: 0,0:42:12.43,0:42:13.96,Japanese,,0,0,0,,僕の奥さん
Dialogue: 0,0:42:13.96,0:42:16.13,Japanese,,0,0,0,,はじめまして はじめまして
Dialogue: 0,0:42:16.13,0:42:18.14,Japanese,,0,0,0,,日野の家内です
Dialogue: 0,0:42:20.37,0:42:22.24,Japanese,,0,0,0,,何 まだ送信してないの？
Dialogue: 0,0:42:22.24,0:42:24.61,Japanese,,0,0,0,,俺 もう送ったよ
Dialogue: 0,0:42:24.61,0:42:27.71,Japanese,,0,0,0,,青空市に来ませんか？ って 誘うだけでしょ
Dialogue: 0,0:42:27.71,0:42:31.05,Japanese,,0,0,0,,いや いざとなると指が動かなくて
Dialogue: 0,0:42:31.05,0:42:31.78,Japanese,,0,0,0,,ちょっと貸して 俺が送ってあげる
Dialogue: 0,0:42:31.78,0:42:33.12,Japanese,,0,0,0,,いい
Dialogue: 0,0:42:33.12,0:42:35.89,Japanese,,0,0,0,,風見君 連れてきたよ
Dialogue: 0,0:42:46.60,0:42:48.26,Japanese,,0,0,0,,沼ちゃん ちょっと
Dialogue: 0,0:42:48.26,0:42:50.87,Japanese,,0,0,0,,ちょっと 山さん どうした？
Dialogue: 0,0:42:50.87,0:42:52.97,Japanese,,0,0,0,,あっち あっち
Dialogue: 0,0:42:55.57,0:42:58.61,Japanese,,0,0,0,,千木通り商店街を よろしくお願いします
Dialogue: 0,0:42:58.61,0:42:59.91,Japanese,,0,0,0,,顔 知らないの？
Dialogue: 0,0:42:59.91,0:43:02.71,Japanese,,0,0,0,,写真の交換してねえもん
Dialogue: 0,0:43:02.71,0:43:07.08,Japanese,,0,0,0,,目印は 特大のりせんべい
Dialogue: 0,0:43:16.03,0:43:18.06,Japanese,,0,0,0,,｢百合さんにケンカを売った｣って
Dialogue: 0,0:43:18.06,0:43:22.00,Japanese,,0,0,0,,ポジティブモンスターが 自己申告してきました
Dialogue: 0,0:43:22.00,0:43:24.13,Japanese,,0,0,0,,すごい あだ名
Dialogue: 0,0:43:24.13,0:43:26.37,Japanese,,0,0,0,,彼女 何て？
Dialogue: 0,0:43:26.37,0:43:29.61,Japanese,,0,0,0,,｢幸せな50歳を見せてみろ｣
Dialogue: 0,0:43:31.81,0:43:34.81,Japanese,,0,0,0,,改めてケンカ売ってるじゃない
Dialogue: 0,0:43:34.81,0:43:35.59,Japanese,,0,0,0,,それと
Dialogue: 0,0:43:35.62,0:43:40.18,Japanese,,0,0,0,,あのお姉さんは風見さんのことが 好きだと思います
Dialogue: 0,0:43:40.18,0:43:44.46,Japanese,,0,0,0,,二人とも いい年してバカみたい だそうです
Dialogue: 0,0:43:47.99,0:43:49.83,Japanese,,0,0,0,,だから来たの？
Dialogue: 0,0:43:49.83,0:43:51.76,Japanese,,0,0,0,,そんな話でもなきゃ
Dialogue: 0,0:43:51.76,0:43:57.23,Japanese,,0,0,0,,こっぴどくフラれたあとに のこのこと顔を出せません
Dialogue: 0,0:43:57.23,0:43:59.14,Japanese,,0,0,0,,勝算があって来たんだ？
Dialogue: 0,0:43:59.14,0:44:01.24,Japanese,,0,0,0,,そこまでは
Dialogue: 0,0:44:01.24,0:44:05.64,Japanese,,0,0,0,,いちるの望み程度
Dialogue: 0,0:44:05.64,0:44:07.68,Japanese,,0,0,0,,そうよね
Dialogue: 0,0:44:07.68,0:44:11.05,Japanese,,0,0,0,,何もなきゃ動けないわよね
Dialogue: 0,0:44:11.05,0:44:13.62,Japanese,,0,0,0,,不自由な大人達は
Dialogue: 0,0:44:19.89,0:44:22.09,Japanese,,0,0,0,,この年になると
Dialogue: 0,0:44:22.09,0:44:25.30,Japanese,,0,0,0,,空気を読んで 何となく関係を結んだり
Dialogue: 0,0:44:25.30,0:44:27.76,Japanese,,0,0,0,,いつの間にか つきあったりしますけど
Dialogue: 0,0:44:27.76,0:44:29.07,Japanese,,0,0,0,,しないわよ
Dialogue: 0,0:44:29.07,0:44:33.64,Japanese,,0,0,0,,僕は百合さんが好きです
Dialogue: 0,0:44:35.97,0:44:38.31,Japanese,,0,0,0,,きちんと言いたくて
Dialogue: 0,0:44:39.51,0:44:41.41,Japanese,,0,0,0,,私も好きよ
Dialogue: 0,0:44:47.05,0:44:50.19,Japanese,,0,0,0,,甥っ子じゃない風見君が
Dialogue: 0,0:44:54.02,0:44:57.39,Japanese,,0,0,0,,先のことは分からないけど
Dialogue: 0,0:44:57.39,0:45:01.56,Japanese,,0,0,0,,今の気持ちに素直になってみても いいかな って
Dialogue: 0,0:45:22.75,0:45:25.86,Japanese,,0,0,0,,会えなくて寂しかった
Dialogue: 0,0:45:42.91,0:45:45.18,Japanese,,0,0,0,,いきなり？
Dialogue: 0,0:45:55.32,0:45:59.72,Japanese,,0,0,0,,現実に こういうことする人 初めて見た
Dialogue: 0,0:45:59.72,0:46:03.26,Japanese,,0,0,0,,じゃあ どこにキスすればいいんですか？
Dialogue: 0,0:46:03.26,0:46:05.80,Japanese,,0,0,0,,えッ どこ？
Dialogue: 0,0:46:05.80,0:46:09.50,Japanese,,0,0,0,,そんなに驚かなくても
Dialogue: 0,0:46:14.44,0:46:15.84,Japanese,,0,0,0,,みくりちゃん
Dialogue: 0,0:46:15.84,0:46:18.51,Japanese,,0,0,0,,休んで せんべい 好きなだけ食べて
Dialogue: 0,0:46:18.51,0:46:20.74,Japanese,,0,0,0,,ありがとう あとで来ますね
Dialogue: 0,0:46:20.74,0:46:23.05,Japanese,,0,0,0,,おう 待ってるよ
Dialogue: 0,0:46:24.35,0:46:26.42,Japanese,,0,0,0,,すいません こんな仕事まで
Dialogue: 0,0:46:26.42,0:46:28.28,Japanese,,0,0,0,,いえ
Dialogue: 0,0:46:28.28,0:46:32.56,Japanese,,0,0,0,,みくりさん 人気者ですね
Dialogue: 0,0:46:32.56,0:46:36.73,Japanese,,0,0,0,,ここに来るまでに 長～い道のりが
Dialogue: 0,0:46:41.26,0:46:44.37,Japanese,,0,0,0,,また やりたいですか？
Dialogue: 0,0:46:44.37,0:46:47.00,Japanese,,0,0,0,,条件次第ですね
Dialogue: 0,0:46:47.00,0:46:50.11,Japanese,,0,0,0,,交渉は大事です
Dialogue: 0,0:46:50.11,0:46:52.68,Japanese,,0,0,0,,発見はありました
Dialogue: 0,0:46:52.68,0:46:57.68,Japanese,,0,0,0,,派遣社員だったとき よく上司に あれこれ提案してたんです
Dialogue: 0,0:46:57.68,0:47:02.49,Japanese,,0,0,0,,こうした方が効率的 とか なぜこうしないんですか とか
Dialogue: 0,0:47:02.49,0:47:06.99,Japanese,,0,0,0,,でも向こうは そんなの求めてなくて
Dialogue: 0,0:47:06.99,0:47:10.43,Japanese,,0,0,0,,ウザがられて切られる っていう
Dialogue: 0,0:47:12.63,0:47:18.64,Japanese,,0,0,0,,私の小賢しさは どこに行っても 嫌われるんだなって思ってたけど
Dialogue: 0,0:47:18.64,0:47:23.64,Japanese,,0,0,0,,青空市の仕事では むしろ喜んでもらえて
Dialogue: 0,0:47:23.64,0:47:28.28,Japanese,,0,0,0,,小賢しいからできる仕事も あるのかもしれません
Dialogue: 0,0:47:32.42,0:47:36.72,Japanese,,0,0,0,,小賢しいって何ですか？
Dialogue: 0,0:47:36.72,0:47:39.76,Japanese,,0,0,0,,言葉の意味は分かるんです
Dialogue: 0,0:47:39.76,0:47:44.93,Japanese,,0,0,0,,小賢しいって 相手を下に見て言う言葉でしょ
Dialogue: 0,0:47:46.10,0:47:49.80,Japanese,,0,0,0,,僕は みくりさんを 下に見たことはないし
Dialogue: 0,0:47:49.80,0:47:54.80,Japanese,,0,0,0,,小賢しいなんて思ったこと 一度もありません
Dialogue: 0,0:48:00.78,0:48:02.91,Japanese,,0,0,0,,津崎さん こっちで飲もう！
Dialogue: 0,0:48:02.91,0:48:04.92,Japanese,,0,0,0,,はい 今
Dialogue: 0,0:48:15.96,0:48:19.20,Japanese,,0,0,0,,あの みくりさん？
Dialogue: 0,0:48:21.20,0:48:24.20,Japanese,,0,0,0,,み…… みなさんが こ…… こっちを見て
Dialogue: 0,0:48:56.23,0:48:58.30,Japanese,,0,0,0,,ありがとう
Dialogue: 0,0:48:59.44,0:49:03.11,Japanese,,0,0,0,,何の ありがとうで？
Dialogue: 0,0:49:04.88,0:49:07.61,Japanese,,0,0,0,,大好き
Dialogue: 0,0:49:17.32,0:49:21.22,Japanese,,0,0,0,,私達を縛る 全てのものから
Dialogue: 0,0:49:21.99,0:49:22.83,Japanese,,0,0,0,,紹介する
Dialogue: 0,0:49:22.83,0:49:27.00,Japanese,,0,0,0,,-目に見えない 小さな痛みから -こんにちは
Dialogue: 0,0:49:29.50,0:49:33.60,Japanese,,0,0,0,,いつの日か解き放たれて
Dialogue: 0,0:49:37.44,0:49:40.08,Japanese,,0,0,0,,時に泣いても
Dialogue: 0,0:49:40.08,0:49:43.28,Japanese,,0,0,0,,笑っていけますように
Dialogue: 0,0:49:46.72,0:49:48.02,Japanese,,0,0,0,,ちょっと
Dialogue: 0,0:49:50.29,0:49:51.76,Japanese,,0,0,0,,どう
Dialogue: 0,0:49:51.76,0:49:53.19,Japanese,,0,0,0,,バッチリじゃない？
Dialogue: 0,0:49:53.19,0:49:55.46,Japanese,,0,0,0,,｢ダンケ｣って いい言葉でしょ
Dialogue: 0,0:49:55.46,0:49:57.16,Japanese,,0,0,0,,ダンケ？
Dialogue: 0,0:49:57.16,0:50:00.56,Japanese,,0,0,0,,たった３文字で感謝を伝える
Dialogue: 0,0:50:00.56,0:50:03.23,Japanese,,0,0,0,,ダンケ ダンケ
Dialogue: 0,0:50:03.23,0:50:04.43,Japanese,,0,0,0,,ねえねえねえ
Dialogue: 0,0:50:04.43,0:50:06.67,Japanese,,0,0,0,,過去最高の売り上げが出そう
Dialogue: 0,0:50:06.67,0:50:08.07,Japanese,,0,0,0,,おめでとうだよ～
Dialogue: 0,0:50:08.07,0:50:09.47,Japanese,,0,0,0,,ありがとうだよ～
Dialogue: 0,0:50:09.47,0:50:11.41,Japanese,,0,0,0,,みくり～ お仕事お疲れさま～
Dialogue: 0,0:50:11.41,0:50:12.91,Japanese,,0,0,0,,ありがと 百合ちゃん
Dialogue: 0,0:50:12.91,0:50:14.24,Japanese,,0,0,0,,どうしたの？
Dialogue: 0,0:50:14.24,0:50:17.31,Japanese,,0,0,0,,何か いつもよりすごい
Dialogue: 0,0:50:20.65,0:50:23.42,Japanese,,0,0,0,,百合ちゃん 何かいいことあったな 何かあったな～
Dialogue: 0,0:50:27.49,0:50:30.19,Japanese,,0,0,0,,これから どうしましょう？
Dialogue: 0,0:50:31.63,0:50:34.46,Japanese,,0,0,0,,何でもいい気がしてきました
Dialogue: 0,0:50:34.46,0:50:38.94,Japanese,,0,0,0,,籍を入れても 入れなくても
Dialogue: 0,0:50:39.94,0:50:44.34,Japanese,,0,0,0,,私が本格的に就職先を探したら どうします？
Dialogue: 0,0:50:44.34,0:50:48.44,Japanese,,0,0,0,,それに合わせて ライフスタイルを 変えていくしかありません
Dialogue: 0,0:50:48.44,0:50:51.21,Japanese,,0,0,0,,模索は続きます
Dialogue: 0,0:50:51.21,0:50:55.12,Japanese,,0,0,0,,そうですね 続けていきましょう
Dialogue: 0,0:51:01.22,0:51:04.73,Japanese,,0,0,0,,提案があるんですが
Dialogue: 0,0:51:04.73,0:51:08.40,Japanese,,0,0,0,,ハグの日 復活させませんか？
Dialogue: 0,0:51:10.30,0:51:12.87,Japanese,,0,0,0,,忙しいと忘れがちになったり
Dialogue: 0,0:51:12.87,0:51:14.64,Japanese,,0,0,0,,ケンカしたときに
Dialogue: 0,0:51:14.66,0:51:18.70,Japanese,,0,0,0,,どうやって触れたらいいのか 分からなくなるので
Dialogue: 0,0:51:21.01,0:51:22.68,Japanese,,0,0,0,,私もいいですか？
Dialogue: 0,0:51:22.68,0:51:23.75,Japanese,,0,0,0,,はい
Dialogue: 0,0:51:23.75,0:51:26.12,Japanese,,0,0,0,,毎晩とは言いませんが
Dialogue: 0,0:51:26.12,0:51:31.25,Japanese,,0,0,0,,寝る前にハグしてくれたら いい夢が見られそうな
Dialogue: 0,0:51:31.25,0:51:33.79,Japanese,,0,0,0,,そういう おねだりは どんどん言ってください
Dialogue: 0,0:51:33.79,0:51:35.89,Japanese,,0,0,0,,ウエルカムです
Dialogue: 0,0:51:35.89,0:51:37.29,Japanese,,0,0,0,,ウエルカム
Dialogue: 0,0:51:37.29,0:51:39.50,Japanese,,0,0,0,,引っ越しを検討しませんか？
Dialogue: 0,0:51:39.50,0:51:41.53,Japanese,,0,0,0,,みくりさんの部屋が必要だし
Dialogue: 0,0:51:41.53,0:51:44.37,Japanese,,0,0,0,,ダブルベッドが置ける寝室も
Dialogue: 0,0:51:45.47,0:51:50.37,Japanese,,0,0,0,,寝床は別の方が熟睡できるかも
Dialogue: 0,0:51:52.64,0:51:56.01,Japanese,,0,0,0,,そ そこは お…… 応相談で
Dialogue: 0,0:51:57.25,0:52:01.05,Japanese,,0,0,0,,毎朝 起こしにいきます
Dialogue: 0,0:52:01.05,0:52:03.55,Japanese,,0,0,0,,そのとき
Dialogue: 0,0:52:03.55,0:52:06.56,Japanese,,0,0,0,,おはようのチュウは……
Dialogue: 0,0:52:09.26,0:52:12.86,Japanese,,0,0,0,,みくりさんが おねだりするなら 僕だって
Dialogue: 0,0:52:20.80,0:52:26.64,Japanese,,0,0,0,,日曜日は 平匡さんが起こしにきてください
Dialogue: 0,0:52:28.04,0:52:30.25,Japanese,,0,0,0,,そのあとは？
Dialogue: 0,0:52:32.02,0:52:34.62,Japanese,,0,0,0,,応相談で
Dialogue: 0,0:53:05.08,0:53:06.32,Japanese,,0,0,0,,僕に任せてください
Dialogue: 0,0:53:06.32,0:53:08.32,Japanese,,0,0,0,,-頑張ってください -はい
Dialogue: 0,0:53:22.60,0:53:24.87,Japanese,,0,0,0,,今さら？
Dialogue: 0,0:53:27.70,0:53:29.61,Japanese,,0,0,0,,大丈夫ですか
Dialogue: 0,0:53:29.61,0:53:32.02,Japanese,,0,0,0,,たくさんの道の中から
Dialogue: 0,0:53:32.04,0:53:36.34,Japanese,,0,0,0,,思い通りの道を選べたり 選べなかったり
Dialogue: 0,0:53:44.42,0:53:46.76,Japanese,,0,0,0,,カツオ イサキ 早く食べちゃいなさい
Dialogue: 0,0:53:46.76,0:53:48.82,Japanese,,0,0,0,,セイゴとハツメも早く食べるよ
Dialogue: 0,0:53:48.82,0:53:50.46,Japanese,,0,0,0,,ハタ君 ばんざい ばんざい はい
Dialogue: 0,0:53:50.46,0:53:52.36,Japanese,,0,0,0,,パパ 止まれ！
Dialogue: 0,0:53:52.36,0:53:54.06,Japanese,,0,0,0,,パパ早く！
Dialogue: 0,0:53:54.06,0:53:54.90,Japanese,,0,0,0,,はい
Dialogue: 0,0:53:54.90,0:53:58.90,Japanese,,0,0,0,,何の道も面倒くさい日々だけど
Dialogue: 0,0:54:04.14,0:54:05.74,Japanese,,0,0,0,,できます？
Dialogue: 0,0:54:05.74,0:54:07.64,Japanese,,0,0,0,,さあ
Dialogue: 0,0:54:07.64,0:54:08.58,Japanese,,0,0,0,,お弁当です
Dialogue: 0,0:54:08.58,0:54:09.71,Japanese,,0,0,0,,ありがとう
Dialogue: 0,0:54:09.71,0:54:10.41,Japanese,,0,0,0,,いってらっしゃい
Dialogue: 0,0:54:10.41,0:54:11.95,Japanese,,0,0,0,,行ってきます。
Dialogue: 0,0:54:11.95,0:54:15.85,Japanese,,0,0,0,,との道も 愛おしい日もあって
Dialogue: 0,0:54:20.36,0:54:21.06,Japanese,,0,0,0,,イヤだ
Dialogue: 0,0:54:21.06,0:54:21.69,Japanese,,0,0,0,,イヤです。
Dialogue: 0,0:54:21.69,0:54:24.09,Japanese,,0,0,0,,-なしなし -なしです。
Dialogue: 0,0:54:24.09,0:54:25.63,Japanese,,0,0,0,,-僕は頑張ります。 -お願いします。
Dialogue: 0,0:54:25.63,0:54:28.10,Japanese,,0,0,0,,逃げてしまう日があっても
Dialogue: 0,0:54:28.10,0:54:30.70,Japanese,,0,0,0,,平匡 平匡...
Dialogue: 0,0:54:40.08,0:54:45.58,Japanese,,0,0,0,,深呼吸して 別の道探して また戻って
Dialogue: 0,0:54:46.72,0:54:49.45,Japanese,,0,0,0,,いい日も 悪い日も
Dialogue: 0,0:54:49.45,0:54:52.12,Japanese,,0,0,0,,平匡さん 大変
Dialogue: 0,0:54:52.12,0:54:55.06,Japanese,,0,0,0,,昨日 火曜日だった！
Dialogue: 0,0:54:55.06,0:54:57.99,Japanese,,0,0,0,,もう６時間も過ぎてる
Dialogue: 0,0:54:57.99,0:54:59.63,Japanese,,0,0,0,,セーフにしましょう
Dialogue: 0,0:54:59.63,0:55:01.40,Japanese,,0,0,0,,そうしましょう
Dialogue: 0,0:55:03.57,0:55:05.50,Japanese,,0,0,0,,-じゃ -はい
Dialogue: 0,0:55:10.84,0:55:14.44,Japanese,,0,0,0,,いつだって また
Dialogue: 0,0:55:14.44,0:55:17.08,Japanese,,0,0,0,,火曜日から始めよう！
Dialogue: 0,0:57:45.27,0:57:49.27,Japanese,,0,0,0,,(c) Tokyo Broadcasting System Television, Inc.
Dialogue: 0,0:00:00.00,0:00:02.47,Default,,0,0,0,,美栗小姐
Dialogue: 0,0:00:02.47,0:00:04.10,Default,,0,0,0,,我们就正式去登记
Dialogue: 0,0:00:04.10,0:00:06.11,Default,,0,0,0,,正式结婚好吗？
Dialogue: 0,0:00:06.11,0:00:09.31,Default,,0,0,0,,如果我们结婚 就再也不需要雇用契约
Dialogue: 0,0:00:09.31,0:00:12.61,Default,,0,0,0,,这样过去支付给你的薪水 就能省下来
Dialogue: 0,0:00:12.61,0:00:16.18,Default,,0,0,0,,而这笔钱能做为生活费 或是储蓄起来
Dialogue: 0,0:00:16.18,0:00:16.88,Default,,0,0,0,,所以……
Dialogue: 0,0:00:16.88,0:00:18.12,Default,,0,0,0,,请等一下
Dialogue: 0,0:00:18.12,0:00:21.29,Default,,0,0,0,,我想知道你为什么 想跟我正式结婚？
Dialogue: 0,0:00:21.29,0:00:22.42,Default,,0,0,0,,我被公司裁员了
Dialogue: 0,0:00:22.42,0:00:25.19,Default,,0,0,0,,因为被裁员 才跟我求婚？
Dialogue: 0,0:00:25.19,0:00:27.63,Default,,0,0,0,,只要结婚就可以不用付薪水
Dialogue: 0,0:00:27.63,0:00:31.33,Default,,0,0,0,,能免费使用我 所以很务实
Dialogue: 0,0:00:31.33,0:00:33.67,Default,,0,0,0,,你是这个意思吧
Dialogue: 0,0:00:33.67,0:00:38.67,Default,,0,0,0,,这就表示你不喜欢我吗？
Dialogue: 0,0:00:38.67,0:00:42.78,Default,,0,0,0,,你这样是剥削我对你的喜欢
Dialogue: 0,0:00:45.51,0:00:48.62,Default,,0,0,0,,最爱的人向自己求婚
Dialogue: 0,0:00:48.62,0:00:50.45,Default,,0,0,0,,我好开心
Dialogue: 0,0:00:50.45,0:00:53.69,Default,,0,0,0,,明明就很开心
Dialogue: 0,0:00:53.69,0:00:57.49,Default,,0,0,0,,为什么心情很郁闷？
Dialogue: 0,0:00:59.02,0:01:02.30,Default,,0,0,0,,这种郁闷感到底是什么？
Dialogue: 0,0:01:06.10,0:01:09.34,Default,,0,0,0,,-晚安 -晚安
Dialogue: 0,0:01:14.67,0:01:17.61,Default,,0,0,0,,今天是……
Dialogue: 0,0:01:17.61,0:01:19.55,Default,,0,0,0,,礼拜二
Dialogue: 0,0:01:19.55,0:01:24.42,Default,,0,0,0,,以后就算不是礼拜二 我也可以抱你吗？
Dialogue: 0,0:01:24.42,0:01:25.55,Default,,0,0,0,,不管礼拜几都可以
Dialogue: 0,0:01:25.55,0:01:28.35,Default,,0,0,0,,后来不再遵守拥抱日
Dialogue: 0,0:01:28.35,0:01:32.76,Default,,0,0,0,,只要想到 我们几乎每天拥抱
Dialogue: 0,0:01:32.76,0:01:35.23,Default,,0,0,0,,可是他的心一远离我
Dialogue: 0,0:01:35.23,0:01:39.33,Default,,0,0,0,,就连我的手都不碰 什么事都没发生
Dialogue: 0,0:01:39.33,0:01:41.13,Default,,0,0,0,,这是理所当然的
Dialogue: 0,0:01:41.13,0:01:46.61,Default,,0,0,0,,人家特地求婚却毁掉一切 像我这种自作聪明的女人
Dialogue: 0,0:01:46.61,0:01:49.78,Default,,0,0,0,,被抛弃是理所当然的
Dialogue: 0,0:01:49.78,0:01:53.31,Default,,0,0,0,,一旦说出口的话
Dialogue: 0,0:01:53.31,0:01:56.58,Default,,0,0,0,,还有感受到的郁闷感
Dialogue: 0,0:01:56.58,0:02:00.19,Default,,0,0,0,,无法装做没发生过
Dialogue: 0,0:02:01.55,0:02:04.26,Default,,0,0,0,,这点彼此都一样
Dialogue: 0,0:02:10.90,0:02:15.27,Default,,0,0,0,,你这样是剥削我对你的喜欢
Dialogue: 0,0:02:15.27,0:02:18.14,Default,,0,0,0,,剥削她对我的喜欢……
Dialogue: 0,0:02:18.14,0:02:21.91,Default,,0,0,0,,听她那么说 我突然被打醒
Dialogue: 0,0:02:21.91,0:02:24.91,Default,,0,0,0,,在内心某处觉得 既然对方喜欢自己
Dialogue: 0,0:02:24.91,0:02:29.58,Default,,0,0,0,,就理所当然会接受我的提议
Dialogue: 0,0:02:29.58,0:02:34.82,Default,,0,0,0,,我是从什么时候开始 变成这么得意忘形的人
Dialogue: 0,0:02:37.49,0:02:40.46,Default,,0,0,0,,我差点吓死
Dialogue: 0,0:02:40.46,0:02:43.16,Default,,0,0,0,,以为这次一定会被降职
Dialogue: 0,0:02:43.16,0:02:45.93,Default,,0,0,0,,因为之前才跟本部长对呛
Dialogue: 0,0:02:48.77,0:02:50.30,Default,,0,0,0,,然后呢？
Dialogue: 0,0:02:52.57,0:02:56.14,Default,,0,0,0,,结果上面说要升我当部长
Dialogue: 0,0:02:58.18,0:02:59.95,Default,,0,0,0,,欢迎光临
Dialogue: 0,0:03:01.48,0:03:03.25,Default,,0,0,0,,你好
Dialogue: 0,0:03:03.25,0:03:07.05,Default,,0,0,0,,我听说你在这里庆祝
Dialogue: 0,0:03:07.05,0:03:09.99,Default,,0,0,0,,因为你同样的话重复跟我说了10次
Dialogue: 0,0:03:09.99,0:03:11.39,Default,,0,0,0,,顶多才5次吧
Dialogue: 0,0:03:11.39,0:03:12.96,Default,,0,0,0,,所以我来代替老板听你说
Dialogue: 0,0:03:12.96,0:03:15.66,Default,,0,0,0,,-风见 老样子吗？ -是的
Dialogue: 0,0:03:18.60,0:03:22.50,Default,,0,0,0,,恭喜你升上部长
Dialogue: 0,0:03:22.50,0:03:25.20,Default,,0,0,0,,不知道值不值得恭喜
Dialogue: 0,0:03:25.20,0:03:27.51,Default,,0,0,0,,这么一来责任又重了不少
Dialogue: 0,0:03:27.51,0:03:32.81,Default,,0,0,0,,而且成为首都圈首位女性部长 也很容易成为攻击目标
Dialogue: 0,0:03:32.81,0:03:39.22,Default,,0,0,0,,我为你过去的努力 得到认同一事恭喜你
Dialogue: 0,0:03:41.65,0:03:44.49,Default,,0,0,0,,至少让我请你喝杯酒
Dialogue: 0,0:03:44.49,0:03:45.92,Default,,0,0,0,,那我要点最贵的
Dialogue: 0,0:03:45.92,0:03:47.33,Default,,0,0,0,,没问题
Dialogue: 0,0:03:47.33,0:03:48.23,Default,,0,0,0,,开玩笑的啦
Dialogue: 0,0:03:48.23,0:03:52.63,Default,,0,0,0,,山哥 我最后要喝一杯啤酒 风见请客
Dialogue: 0,0:03:52.63,0:03:54.43,Default,,0,0,0,,最后一杯？
Dialogue: 0,0:03:54.43,0:03:57.67,Default,,0,0,0,,明天也要早起 我得早点回去
Dialogue: 0,0:04:01.41,0:04:03.48,Default,,0,0,0,,风见
Dialogue: 0,0:04:03.48,0:04:05.91,Default,,0,0,0,,礼拜天有空吗？
Dialogue: 0,0:04:08.18,0:04:12.15,Default,,0,0,0,,问卷的问题是 想不想在青空市场摆摊
Dialogue: 0,0:04:12.15,0:04:14.92,Default,,0,0,0,,如果想的话 想要卖什么 就只是这样而已
Dialogue: 0,0:04:14.92,0:04:18.42,Default,,0,0,0,,所以我在问你到底是怎么回事
Dialogue: 0,0:04:18.42,0:04:20.96,Default,,0,0,0,,目的跟企划动机这上面全都有写
Dialogue: 0,0:04:20.96,0:04:26.53,Default,,0,0,0,,字这么小我看不见 解释给我听
Dialogue: 0,0:04:26.53,0:04:27.57,Default,,0,0,0,,可是……
Dialogue: 0,0:04:27.57,0:04:29.27,Default,,0,0,0,,这不是你的工作吗？
Dialogue: 0,0:04:29.27,0:04:33.64,Default,,0,0,0,,既然有收钱就给我认真做
Dialogue: 0,0:04:33.64,0:04:36.84,Default,,0,0,0,,因为中西先生你们一直拜托我
Dialogue: 0,0:04:36.84,0:04:40.15,Default,,0,0,0,,我才决定在最低工资的时数内 勉为其难帮忙
Dialogue: 0,0:04:40.15,0:04:42.22,Default,,0,0,0,,所以才开始做这份工作
Dialogue: 0,0:04:42.22,0:04:46.02,Default,,0,0,0,,可是现在却觉得很郁闷
Dialogue: 0,0:04:46.02,0:04:47.79,Default,,0,0,0,,很抱歉
Dialogue: 0,0:04:47.79,0:04:50.09,Default,,0,0,0,,我等一下会好好跟他说明
Dialogue: 0,0:04:50.09,0:04:52.46,Default,,0,0,0,,既然接下工作 我也不想抱怨
Dialogue: 0,0:04:52.46,0:04:55.13,Default,,0,0,0,,我想负起责任做下去
Dialogue: 0,0:04:55.13,0:04:58.30,Default,,0,0,0,,我真的很想做下去 可是……
Dialogue: 0,0:04:58.30,0:05:00.40,Default,,0,0,0,,-你懂吗？ -我懂
Dialogue: 0,0:05:01.90,0:05:04.00,Default,,0,0,0,,到处都充满郁闷感
Dialogue: 0,0:05:04.00,0:05:08.54,Default,,0,0,0,,不管是青空市场还是结婚
Dialogue: 0,0:05:08.54,0:05:10.78,Default,,0,0,0,,这种郁闷感……
Dialogue: 0,0:05:10.78,0:05:13.95,Default,,0,0,0,,郁闷感的原因……
Dialogue: 0,0:05:13.95,0:05:15.72,Default,,0,0,0,,好像
Dialogue: 0,0:05:15.72,0:05:18.38,Default,,0,0,0,,青空市场跟结婚
Dialogue: 0,0:05:18.38,0:05:21.05,Default,,0,0,0,,共通点是……
Dialogue: 0,0:05:34.60,0:05:35.74,Default,,0,0,0,,我吃饱了
Dialogue: 0,0:05:35.74,0:05:38.50,Default,,0,0,0,,我有话想跟你说
Dialogue: 0,0:05:41.11,0:05:46.71,Default,,0,0,0,,如果是为了之前那件事 我真的没有强迫你的意思
Dialogue: 0,0:05:46.71,0:05:48.95,Default,,0,0,0,,我一直在思考
Dialogue: 0,0:05:48.95,0:05:52.12,Default,,0,0,0,,主妇的劳动对价问题
Dialogue: 0,0:05:52.12,0:05:52.85,Default,,0,0,0,,什么？
Dialogue: 0,0:05:52.85,0:05:53.79,Default,,0,0,0,,其实……
Dialogue: 0,0:05:53.79,0:05:57.19,Default,,0,0,0,,拿最低工资工作 终于让我领悟到一件事
Dialogue: 0,0:05:57.19,0:05:58.56,Default,,0,0,0,,不好意思 我听不太懂
Dialogue: 0,0:05:58.56,0:06:02.53,Default,,0,0,0,,我现在有在兼差
Dialogue: 0,0:06:02.53,0:06:05.10,Default,,0,0,0,,什么？
Dialogue: 0,0:06:05.10,0:06:09.44,Default,,0,0,0,,小安的商店街 拜托我帮忙筹办青空市场
Dialogue: 0,0:06:13.61,0:06:15.91,Default,,0,0,0,,时薪是930圆
Dialogue: 0,0:06:15.91,0:06:18.44,Default,,0,0,0,,是横滨市的最低工资
Dialogue: 0,0:06:18.44,0:06:21.51,Default,,0,0,0,,很抱歉没告诉你
Dialogue: 0,0:06:24.15,0:06:26.08,Default,,0,0,0,,为什么瞒着我？
Dialogue: 0,0:06:26.08,0:06:30.02,Default,,0,0,0,,原本觉得只是短时间 随便帮帮忙而已
Dialogue: 0,0:06:30.02,0:06:35.26,Default,,0,0,0,,而且周遭都是男人 我怕你会很排斥
Dialogue: 0,0:06:39.13,0:06:41.30,Default,,0,0,0,,对不起
Dialogue: 0,0:06:41.30,0:06:44.17,Default,,0,0,0,,这个消息冲击还蛮大的
Dialogue: 0,0:06:44.17,0:06:45.00,Default,,0,0,0,,对不起
Dialogue: 0,0:06:45.00,0:06:48.31,Default,,0,0,0,,我被裁员一事也瞒着你 所以算是扯平
Dialogue: 0,0:06:51.31,0:06:53.78,Default,,0,0,0,,然后呢？
Dialogue: 0,0:06:53.78,0:06:56.48,Default,,0,0,0,,原本时薪2000圆的话 就能忍受的工作
Dialogue: 0,0:06:56.48,0:07:00.35,Default,,0,0,0,,变成最低工资的话 有时候会无法忍受
Dialogue: 0,0:07:00.35,0:07:03.62,Default,,0,0,0,,你是指对方会要求你做 金额以上的劳动吗？
Dialogue: 0,0:07:03.62,0:07:07.36,Default,,0,0,0,,没错 这里就是我的郁闷点
Dialogue: 0,0:07:14.13,0:07:17.37,Default,,0,0,0,,也就是这样
Dialogue: 0,0:07:17.37,0:07:18.37,Default,,0,0,0,,你连这个都准备好？
Dialogue: 0,0:07:18.37,0:07:19.91,Default,,0,0,0,,我是在百圆商店发现的
Dialogue: 0,0:07:19.91,0:07:22.78,Default,,0,0,0,,可以感受到你很想说明的气概
Dialogue: 0,0:07:22.78,0:07:24.11,Default,,0,0,0,,请继续说
Dialogue: 0,0:07:24.11,0:07:27.61,Default,,0,0,0,,结婚 成为专业主妇就表示
Dialogue: 0,0:07:27.61,0:07:28.92,Default,,0,0,0,,保证生活费
Dialogue: 0,0:07:28.92,0:07:33.62,Default,,0,0,0,,也就等于收取最低工资的意思
Dialogue: 0,0:07:33.62,0:07:37.52,Default,,0,0,0,,不过最低工资 怎么说都是最低工资
Dialogue: 0,0:07:37.52,0:07:40.49,Default,,0,0,0,,就算告诉你“有饭吃就该偷笑” “给我闭嘴乖乖工作”
Dialogue: 0,0:07:40.49,0:07:42.16,Default,,0,0,0,,人还是有忍耐的极限
Dialogue: 0,0:07:42.16,0:07:45.13,Default,,0,0,0,,不过又不是每个雇主都这么蛮横
Dialogue: 0,0:07:45.13,0:07:50.04,Default,,0,0,0,,是的 能在好雇主手下 没压力又没纠纷的工作
Dialogue: 0,0:07:50.04,0:07:53.17,Default,,0,0,0,,也许拿最低工资也无所谓
Dialogue: 0,0:07:53.17,0:07:55.98,Default,,0,0,0,,也就是说要看雇主咯
Dialogue: 0,0:07:55.98,0:08:00.05,Default,,0,0,0,,如果是一般企业 有很多员工 也有人事异动
Dialogue: 0,0:08:00.05,0:08:05.28,Default,,0,0,0,,还有升官 奖金等等 客观奖励员工的制度
Dialogue: 0,0:08:05.28,0:08:08.99,Default,,0,0,0,,不过如果是夫妻 就是一对一的状况
Dialogue: 0,0:08:08.99,0:08:14.03,Default,,0,0,0,,如果丈夫不给奖励 妻子就不会得到任何奖励
Dialogue: 0,0:08:14.03,0:08:18.76,Default,,0,0,0,,也就是以现状而言 主妇的劳动对价
Dialogue: 0,0:08:22.17,0:08:27.61,Default,,0,0,0,,是基本薪资加上雇主的奖励 也就是爱情的意思
Dialogue: 0,0:08:27.61,0:08:29.91,Default,,0,0,0,,不过爱情无法数值化
Dialogue: 0,0:08:29.91,0:08:31.41,Default,,0,0,0,,没错
Dialogue: 0,0:08:31.41,0:08:34.45,Default,,0,0,0,,这是非常不稳定的要素
Dialogue: 0,0:08:34.45,0:08:37.82,Default,,0,0,0,,随着雇主的心情 随时都可能归零
Dialogue: 0,0:08:37.82,0:08:41.85,Default,,0,0,0,,也就是在这种状况下 持续最低工资劳动咯
Dialogue: 0,0:08:41.85,0:08:44.09,Default,,0,0,0,,而且劳动时间也没有上限
Dialogue: 0,0:08:44.09,0:08:47.53,Default,,0,0,0,,如果没处理好 搞不好会变成黑心企业
Dialogue: 0,0:08:47.53,0:08:51.83,Default,,0,0,0,,身为员工 能否在这个劳动环境下做下去
Dialogue: 0,0:08:51.83,0:08:54.00,Default,,0,0,0,,我感到很不安
Dialogue: 0,0:08:58.57,0:09:02.74,Default,,0,0,0,,你向我求婚 我真的很开心
Dialogue: 0,0:09:02.74,0:09:06.34,Default,,0,0,0,,我当然不是不想跟你结婚……
Dialogue: 0,0:09:06.34,0:09:10.85,Default,,0,0,0,,夫妻之间是雇佣关系吗？
Dialogue: 0,0:09:13.42,0:09:16.46,Default,,0,0,0,,当丈夫是雇主 妻子是员工
Dialogue: 0,0:09:16.46,0:09:20.03,Default,,0,0,0,,会不会从这里就搞错了？
Dialogue: 0,0:09:20.03,0:09:23.93,Default,,0,0,0,,主妇也是支持家庭的伟大工作
Dialogue: 0,0:09:23.93,0:09:26.90,Default,,0,0,0,,如果这么想的话
Dialogue: 0,0:09:26.90,0:09:31.07,Default,,0,0,0,,丈夫与妻子都是共同经营负责人
Dialogue: 0,0:09:31.07,0:09:34.14,Default,,0,0,0,,共同经营负责人？
Dialogue: 0,0:09:34.14,0:09:38.48,Default,,0,0,0,,要不要以这个观点 来重建我们的关系？
Dialogue: 0,0:09:40.98,0:09:46.02,Default,,0,0,0,,不是雇用关系 而是重建全新制度
Dialogue: 0,0:09:46.02,0:09:49.99,Default,,0,0,0,,我本来觉得只要有爱就不需要制度
Dialogue: 0,0:09:49.99,0:09:54.69,Default,,0,0,0,,问题好像没这么简单
Dialogue: 0,0:09:54.69,0:09:56.06,Default,,0,0,0,,不过我不知道是否会成功……
Dialogue: 0,0:09:56.06,0:09:57.20,Default,,0,0,0,,我要试
Dialogue: 0,0:09:57.20,0:09:59.40,Default,,0,0,0,,请让我试试看
Dialogue: 0,0:10:01.80,0:10:02.94,Default,,0,0,0,,一起试试看吧
Dialogue: 0,0:10:02.94,0:10:05.24,Default,,0,0,0,,一起当共同经营负责人
Dialogue: 0,0:10:05.24,0:10:08.11,Default,,0,0,0,,一起当CEO
Dialogue: 0,0:10:08.11,0:10:12.21,Default,,0,0,0,,好好发挥 未来的我
Dialogue: 0,0:10:12.21,0:10:14.51,Default,,0,0,0,,一定会面带笑容吧
Dialogue: 0,0:10:14.51,0:10:17.72,Default,,0,0,0,,两人的步宽 呼吸 小动作 会渐渐同步
Dialogue: 0,0:10:17.72,0:10:21.92,Default,,0,0,0,,给我等着瞧 那个时候的我
Dialogue: 0,0:10:21.92,0:10:25.12,Default,,0,0,0,,下次绝对不要停下来
Dialogue: 0,0:10:25.12,0:10:29.36,Default,,0,0,0,,继续迈进 就算逃走也要争取未来
Dialogue: 0,0:10:32.46,0:10:33.03,Default,,0,0,0,,一定要生存下去
Dialogue: 0,0:10:33.03,0:10:35.17,Default,,0,0,0,,津崎跟美栗彼此相爱吗？
Dialogue: 0,0:10:35.17,0:10:36.30,Default,,0,0,0,,十姐妹……
Dialogue: 0,0:10:36.30,0:10:37.67,Default,,0,0,0,,没有昏倒啊
Dialogue: 0,0:10:37.67,0:10:40.64,Default,,0,0,0,,我无法当你是我阿姨
Dialogue: 0,0:10:40.64,0:10:43.94,Default,,0,0,0,,希望被选上 希望得到认同
Dialogue: 0,0:10:43.94,0:10:47.08,Default,,0,0,0,,可是我却……
Dialogue: 0,0:10:50.62,0:10:53.32,Default,,0,0,0,,把家庭当成一间公司
Dialogue: 0,0:10:53.32,0:10:57.49,Default,,0,0,0,,对提出一起当共同经营负责人 来经营的平匡的提议
Dialogue: 0,0:10:57.49,0:10:59.92,Default,,0,0,0,,表示赞同的美栗
Dialogue: 0,0:10:59.92,0:11:04.66,Default,,0,0,0,,而第一次的经营负责人会议 即将展开
Dialogue: 0,0:11:11.54,0:11:15.41,Default,,0,0,0,,A公司的工作内容 与现在几乎一样
Dialogue: 0,0:11:15.41,0:11:18.04,Default,,0,0,0,,薪水是现在的9成
Dialogue: 0,0:11:18.04,0:11:20.31,Default,,0,0,0,,B公司是一间新公司
Dialogue: 0,0:11:20.31,0:11:22.58,Default,,0,0,0,,不过薪水跟安定性都较差
Dialogue: 0,0:11:22.58,0:11:27.02,Default,,0,0,0,,平匡CEO对B公司比较感兴趣咯
Dialogue: 0,0:11:27.02,0:11:29.72,Default,,0,0,0,,如果是以前的我一定会选择A公司
Dialogue: 0,0:11:29.72,0:11:34.49,Default,,0,0,0,,现在却觉得自己 也许能尝试些新事物
Dialogue: 0,0:11:34.49,0:11:38.53,Default,,0,0,0,,不过要是选择B公司 董事报酬只有现在的一半
Dialogue: 0,0:11:38.53,0:11:41.70,Default,,0,0,0,,那就当报酬减少是没办法的事
Dialogue: 0,0:11:41.70,0:11:44.97,Default,,0,0,0,,或是我也到外面去工作贴补家用
Dialogue: 0,0:11:44.97,0:11:46.64,Default,,0,0,0,,到外面工作？
Dialogue: 0,0:11:46.64,0:11:48.67,Default,,0,0,0,,我是指商店街的工作
Dialogue: 0,0:11:48.67,0:11:50.38,Default,,0,0,0,,因为日薪3千圆
Dialogue: 0,0:11:50.38,0:11:53.81,Default,,0,0,0,,我原本希望能控制在 每天3.2小时内做完
Dialogue: 0,0:11:53.81,0:11:57.35,Default,,0,0,0,,不过就是很难办到
Dialogue: 0,0:11:58.62,0:12:01.55,Default,,0,0,0,,所以我才想到这个
Dialogue: 0,0:12:01.55,0:12:03.96,Default,,0,0,0,,区域杂志的写手工作
Dialogue: 0,0:12:03.96,0:12:07.79,Default,,0,0,0,,以写手身份到商店街去 一边写采访报道
Dialogue: 0,0:12:07.79,0:12:10.86,Default,,0,0,0,,一边挑战青空市场的工作
Dialogue: 0,0:12:10.86,0:12:12.83,Default,,0,0,0,,也就是从其他地方找薪水咯
Dialogue: 0,0:12:12.83,0:12:16.07,Default,,0,0,0,,不过这样就得变成全职劳动
Dialogue: 0,0:12:16.07,0:12:20.71,Default,,0,0,0,,在这个家做家事的时间也会减少
Dialogue: 0,0:12:23.48,0:12:29.95,Default,,0,0,0,,美栗CEO接下的工作 也是303公司的工作
Dialogue: 0,0:12:29.95,0:12:33.62,Default,,0,0,0,,我们同心协力 成功完成你的工作吧
Dialogue: 0,0:12:33.62,0:12:37.59,Default,,0,0,0,,既然两人都在外面工作 家事也要彼此分担
Dialogue: 0,0:12:37.59,0:12:39.22,Default,,0,0,0,,谢谢
Dialogue: 0,0:12:40.46,0:12:45.93,Default,,0,0,0,,于是在房间各处双方布设阵营
Dialogue: 0,0:12:45.93,0:12:49.00,Default,,0,0,0,,开始进行家事分担的会战
Dialogue: 0,0:12:50.17,0:12:54.94,Default,,0,0,0,,从现在起将展开持久战
Dialogue: 0,0:13:02.25,0:13:03.98,Default,,0,0,0,,请进
Dialogue: 0,0:13:08.19,0:13:11.96,Default,,0,0,0,,这是我今年的健检结果
Dialogue: 0,0:13:11.96,0:13:17.66,Default,,0,0,0,,你看这里 骨质密度低下
Dialogue: 0,0:13:17.66,0:13:20.93,Default,,0,0,0,,每年出状况的项目越来越多
Dialogue: 0,0:13:20.93,0:13:23.64,Default,,0,0,0,,女性荷尔蒙则是不断减少
Dialogue: 0,0:13:23.64,0:13:27.04,Default,,0,0,0,,眼睛越来越差 疲劳无法消除
Dialogue: 0,0:13:27.04,0:13:30.48,Default,,0,0,0,,你是在考验我的心意吗？
Dialogue: 0,0:13:33.28,0:13:36.28,Default,,0,0,0,,之前在你家听到你那么说的时候
Dialogue: 0,0:13:36.28,0:13:40.45,Default,,0,0,0,,可是我想跟你上床
Dialogue: 0,0:13:40.45,0:13:45.19,Default,,0,0,0,,我本来以为你是在开玩笑
Dialogue: 0,0:13:45.19,0:13:48.63,Default,,0,0,0,,不过你是认真的吧
Dialogue: 0,0:13:48.63,0:13:52.66,Default,,0,0,0,,我是有反省自己的用词太露骨
Dialogue: 0,0:13:54.17,0:13:56.57,Default,,0,0,0,,我真的吓了一大跳
Dialogue: 0,0:13:56.57,0:13:58.34,Default,,0,0,0,,有吗？
Dialogue: 0,0:13:58.34,0:14:00.27,Default,,0,0,0,,当然有啊
Dialogue: 0,0:14:00.27,0:14:01.94,Default,,0,0,0,,心跳差点停止
Dialogue: 0,0:14:05.78,0:14:09.32,Default,,0,0,0,,不过我们不可能
Dialogue: 0,0:14:15.25,0:14:18.66,Default,,0,0,0,,一直以来的人生都很脚踏实地
Dialogue: 0,0:14:18.66,0:14:22.80,Default,,0,0,0,,现在更不可能接受刹那的恋爱
Dialogue: 0,0:14:22.80,0:14:29.27,Default,,0,0,0,,如果问我有没有办法跟你认真交往
Dialogue: 0,0:14:29.27,0:14:34.11,Default,,0,0,0,,当你出生时 我已经17岁
Dialogue: 0,0:14:34.11,0:14:39.04,Default,,0,0,0,,当你20岁时 我已经37岁
Dialogue: 0,0:14:39.04,0:14:46.22,Default,,0,0,0,,等你好不容易年过40时 我都已经60岁了
Dialogue: 0,0:14:46.22,0:14:50.49,Default,,0,0,0,,不管到几岁 你永远都像我的外甥一样
Dialogue: 0,0:14:57.10,0:15:01.47,Default,,0,0,0,,今天看到你这身打扮时 我是这么想的
Dialogue: 0,0:15:05.40,0:15:10.08,Default,,0,0,0,,你是愿意让我看到 我最想看的真实一面
Dialogue: 0,0:15:11.31,0:15:15.25,Default,,0,0,0,,还是只是当我是外甥而找我来
Dialogue: 0,0:15:17.98,0:15:21.52,Default,,0,0,0,,你决定跟单亲爸爸交往吗？
Dialogue: 0,0:15:21.52,0:15:23.56,Default,,0,0,0,,我跟他已经结束了
Dialogue: 0,0:15:23.56,0:15:26.39,Default,,0,0,0,,结束？
Dialogue: 0,0:15:26.39,0:15:32.46,Default,,0,0,0,,田岛想找的是愿意当小孩母亲的人
Dialogue: 0,0:15:32.46,0:15:38.20,Default,,0,0,0,,也就表示你不是选择其他男人
Dialogue: 0,0:15:38.20,0:15:41.51,Default,,0,0,0,,而是我本身对你而言 完全不可能吗？
Dialogue: 0,0:15:44.78,0:15:47.51,Default,,0,0,0,,我明白了
Dialogue: 0,0:15:50.72,0:15:54.72,Default,,0,0,0,,改天再一起到山哥的酒吧喝酒吧
Dialogue: 0,0:15:56.42,0:16:01.36,Default,,0,0,0,,我无法当你是我阿姨
Dialogue: 0,0:16:04.50,0:16:07.00,Default,,0,0,0,,今天是我们最后一次见面
Dialogue: 0,0:16:11.37,0:16:14.87,Default,,0,0,0,,我会慢慢品尝的
Dialogue: 0,0:16:27.55,0:16:29.56,Default,,0,0,0,,好好喝
Dialogue: 0,0:16:39.00,0:16:41.00,Default,,0,0,0,,谢谢
Dialogue: 0,0:16:42.87,0:16:44.80,Default,,0,0,0,,-你好 -是的
Dialogue: 0,0:16:44.80,0:16:46.47,Default,,0,0,0,,幸会
Dialogue: 0,0:16:46.47,0:16:50.84,Default,,0,0,0,,我是社区杂志“乐乐兴兴” 兼青空市场运行委员的森山
Dialogue: 0,0:16:50.84,0:16:52.34,Default,,0,0,0,,请多指教
Dialogue: 0,0:16:52.34,0:16:55.55,Default,,0,0,0,,今天是来拍 要登在下月号的店家照片
Dialogue: 0,0:16:55.55,0:16:59.98,Default,,0,0,0,,同时要请你协助 青空市场的限时拍卖
Dialogue: 0,0:16:59.98,0:17:01.65,Default,,0,0,0,,请收下
Dialogue: 0,0:17:01.65,0:17:04.16,Default,,0,0,0,,谢谢惠顾
Dialogue: 0,0:17:09.36,0:17:10.56,Default,,0,0,0,,累死了
Dialogue: 0,0:17:10.56,0:17:11.60,Default,,0,0,0,,辛苦了
Dialogue: 0,0:17:11.60,0:17:13.23,Default,,0,0,0,,我好饿
Dialogue: 0,0:17:15.77,0:17:17.30,Default,,0,0,0,,张嘴
Dialogue: 0,0:17:19.34,0:17:21.64,Default,,0,0,0,,你煮的蔬菜咖喱最好吃了
Dialogue: 0,0:17:21.64,0:17:23.28,Default,,0,0,0,,每天吃都不会腻
Dialogue: 0,0:17:23.28,0:17:26.54,Default,,0,0,0,,因为你每次都称赞我 让我觉得完全没白做
Dialogue: 0,0:17:26.54,0:17:28.25,Default,,0,0,0,,毕竟我都吃免费的
Dialogue: 0,0:17:28.25,0:17:31.88,Default,,0,0,0,,很抱歉只能供餐当报酬
Dialogue: 0,0:17:31.88,0:17:34.29,Default,,0,0,0,,果酱的邮购贩售顺利吗？
Dialogue: 0,0:17:34.29,0:17:37.42,Default,,0,0,0,,有很多问题要克服
Dialogue: 0,0:17:37.42,0:17:39.16,Default,,0,0,0,,加工地点也是个问题
Dialogue: 0,0:17:39.16,0:17:42.13,Default,,0,0,0,,总不能每次都拜托田中厨房
Dialogue: 0,0:17:42.13,0:17:45.16,Default,,0,0,0,,而且你爸妈也有自己的工作
Dialogue: 0,0:17:45.16,0:17:46.13,Default,,0,0,0,,你那边呢？
Dialogue: 0,0:17:46.13,0:17:47.27,Default,,0,0,0,,卫生所问题
Dialogue: 0,0:17:47.27,0:17:49.00,Default,,0,0,0,,我昨天去问过了
Dialogue: 0,0:17:49.00,0:17:52.74,Default,,0,0,0,,另外还要租器材
Dialogue: 0,0:17:52.74,0:17:55.54,Default,,0,0,0,,恐怕会超出预算
Dialogue: 0,0:17:55.54,0:17:57.21,Default,,0,0,0,,太辛苦了
Dialogue: 0,0:17:57.21,0:17:59.18,Default,,0,0,0,,彼此彼此
Dialogue: 0,0:17:59.18,0:18:00.18,Default,,0,0,0,,那也是没办法的事
Dialogue: 0,0:18:00.18,0:18:01.58,Default,,0,0,0,,加油
Dialogue: 0,0:18:01.58,0:18:02.68,Default,,0,0,0,,求生存
Dialogue: 0,0:18:02.68,0:18:05.05,Default,,0,0,0,,一定要生存下去
Dialogue: 0,0:18:11.52,0:18:12.49,Default,,0,0,0,,好不好吃？
Dialogue: 0,0:18:19.73,0:18:24.84,Default,,0,0,0,,尝试了2个礼拜 请坦白说出真实的感想
Dialogue: 0,0:18:24.84,0:18:27.61,Default,,0,0,0,,可以说实话吗？
Dialogue: 0,0:18:27.61,0:18:29.21,Default,,0,0,0,,请说
Dialogue: 0,0:18:29.21,0:18:32.18,Default,,0,0,0,,由于我赚的钱少很多
Dialogue: 0,0:18:32.18,0:18:35.85,Default,,0,0,0,,因此家事分担分量较重这点 我完全能理解
Dialogue: 0,0:18:35.85,0:18:39.72,Default,,0,0,0,,可是你有时候会忘记 自己该负责的家事
Dialogue: 0,0:18:39.72,0:18:42.05,Default,,0,0,0,,或是做得比较慢的时候
Dialogue: 0,0:18:42.05,0:18:44.49,Default,,0,0,0,,“那是你该负责的家事吧”
Dialogue: 0,0:18:44.49,0:18:47.59,Default,,0,0,0,,“你分担的家事不是比我少吗？”
Dialogue: 0,0:18:47.59,0:18:50.30,Default,,0,0,0,,我会忍不住这么想
Dialogue: 0,0:18:51.56,0:18:53.50,Default,,0,0,0,,很抱歉
Dialogue: 0,0:18:55.47,0:18:58.77,Default,,0,0,0,,换你说了
Dialogue: 0,0:18:58.77,0:19:01.87,Default,,0,0,0,,我可以说实话吗？
Dialogue: 0,0:19:01.87,0:19:03.28,Default,,0,0,0,,请说
Dialogue: 0,0:19:03.28,0:19:06.98,Default,,0,0,0,,我很在意你的打扫质量变低一事
Dialogue: 0,0:19:06.98,0:19:09.52,Default,,0,0,0,,像是房间角落有灰尘
Dialogue: 0,0:19:09.52,0:19:11.12,Default,,0,0,0,,镜子上有水渍等等
Dialogue: 0,0:19:11.12,0:19:17.59,Default,,0,0,0,,坦白说我本来就不是个 做事很仔细的人
Dialogue: 0,0:19:17.59,0:19:19.09,Default,,0,0,0,,如果硬要说
Dialogue: 0,0:19:19.09,0:19:22.53,Default,,0,0,0,,我算是扫过就好 得过且过的类型
Dialogue: 0,0:19:22.53,0:19:24.20,Default,,0,0,0,,可是你以前不是……
Dialogue: 0,0:19:24.20,0:19:27.53,Default,,0,0,0,,因为是工作 我觉得要做得很完美
Dialogue: 0,0:19:27.53,0:19:29.67,Default,,0,0,0,,所以会特别小心谨慎
Dialogue: 0,0:19:29.67,0:19:31.70,Default,,0,0,0,,不过老实说
Dialogue: 0,0:19:31.70,0:19:35.17,Default,,0,0,0,,我是觉得只要是 不影响到生活的干净程度
Dialogue: 0,0:19:35.17,0:19:37.84,Default,,0,0,0,,就能够活下去
Dialogue: 0,0:19:39.74,0:19:43.22,Default,,0,0,0,,很抱歉无法达到你的期待
Dialogue: 0,0:19:46.58,0:19:48.49,Default,,0,0,0,,如果你很在意
Dialogue: 0,0:19:48.49,0:19:50.82,Default,,0,0,0,,可以把那些地方 当做自己的负责范围
Dialogue: 0,0:19:50.82,0:19:52.59,Default,,0,0,0,,其他地方再改由我负责
Dialogue: 0,0:19:52.59,0:19:53.49,Default,,0,0,0,,不用
Dialogue: 0,0:19:53.49,0:19:55.76,Default,,0,0,0,,增加我负责的范围吧
Dialogue: 0,0:20:02.23,0:20:04.54,Default,,0,0,0,,青空市场？
Dialogue: 0,0:20:04.54,0:20:06.67,Default,,0,0,0,,你老婆不是专业主妇啊
Dialogue: 0,0:20:06.67,0:20:09.07,Default,,0,0,0,,没多久之前还是
Dialogue: 0,0:20:09.07,0:20:12.88,Default,,0,0,0,,不过现在是社区杂志写手 兼活动筹办人兼主妇
Dialogue: 0,0:20:12.88,0:20:15.41,Default,,0,0,0,,1人分饰3角
Dialogue: 0,0:20:15.41,0:20:18.28,Default,,0,0,0,,怪不得你的便当菜色会变少
Dialogue: 0,0:20:18.28,0:20:20.45,Default,,0,0,0,,跟我的便当没两样 你看
Dialogue: 0,0:20:20.45,0:20:25.29,Default,,0,0,0,,我从之前 就一直在怀疑也许是这样
Dialogue: 0,0:20:25.29,0:20:27.33,Default,,0,0,0,,津崎跟美栗小姐……
Dialogue: 0,0:20:27.33,0:20:29.03,Default,,0,0,0,,彼此相爱吗？
Dialogue: 0,0:20:30.66,0:20:31.96,Default,,0,0,0,,是不是热情国的人？
Dialogue: 0,0:20:31.96,0:20:34.30,Default,,0,0,0,,人家已经结婚了 理所当然是热情国的人啊
Dialogue: 0,0:20:34.30,0:20:35.77,Default,,0,0,0,,日野
Dialogue: 0,0:20:35.77,0:20:38.57,Default,,0,0,0,,有时候理所当然不见得理所当然
Dialogue: 0,0:20:38.57,0:20:42.74,Default,,0,0,0,,世上存在着肉眼看不见的暗物质
Dialogue: 0,0:20:42.74,0:20:45.11,Default,,0,0,0,,我不知道算不算是热情国的人
Dialogue: 0,0:20:45.11,0:20:47.08,Default,,0,0,0,,不过我很喜欢她
Dialogue: 0,0:20:47.08,0:20:53.45,Default,,0,0,0,,不过现在深刻体会到 有些事不是靠喜欢就能撑下去
Dialogue: 0,0:20:53.45,0:20:56.62,Default,,0,0,0,,其实我们现在 以夫妻共同工作模拟之名
Dialogue: 0,0:20:56.62,0:20:58.72,Default,,0,0,0,,进行家事分担
Dialogue: 0,0:20:58.72,0:21:01.09,Default,,0,0,0,,你不是讨厌做家事 讨厌到去找家事帮手吗？
Dialogue: 0,0:21:01.09,0:21:04.00,Default,,0,0,0,,坦白说真的觉得很麻烦
Dialogue: 0,0:21:04.00,0:21:06.36,Default,,0,0,0,,如果可以 我真的很不想做
Dialogue: 0,0:21:11.77,0:21:17.18,Default,,0,0,0,,如果今晚能准时下班 能不能帮我炊饭？
Dialogue: 0,0:21:41.33,0:21:42.30,Default,,0,0,0,,你回来啦
Dialogue: 0,0:21:42.30,0:21:43.64,Default,,0,0,0,,很抱歉 这么晚回来
Dialogue: 0,0:21:43.64,0:21:44.44,Default,,0,0,0,,没关系
Dialogue: 0,0:21:44.44,0:21:48.01,Default,,0,0,0,,我直接要了商店街的剩菜回来 马上开饭吧
Dialogue: 0,0:21:48.01,0:21:49.54,Default,,0,0,0,,好的
Dialogue: 0,0:21:54.28,0:21:55.38,Default,,0,0,0,,饭炊好了吧
Dialogue: 0,0:21:55.38,0:21:57.35,Default,,0,0,0,,美栗小姐
Dialogue: 0,0:21:57.35,0:22:01.05,Default,,0,0,0,,今天叫外卖吧
Dialogue: 0,0:22:01.05,0:22:04.42,Default,,0,0,0,,我好想吃披萨
Dialogue: 0,0:22:04.42,0:22:08.49,Default,,0,0,0,,可是有现成的配菜啊
Dialogue: 0,0:22:08.49,0:22:11.00,Default,,0,0,0,,我不太想吃炸的
Dialogue: 0,0:22:11.00,0:22:11.76,Default,,0,0,0,,不太想吃？
Dialogue: 0,0:22:11.76,0:22:13.86,Default,,0,0,0,,感觉好像对胃负担太大
Dialogue: 0,0:22:13.86,0:22:16.90,Default,,0,0,0,,披萨对胃的负担才大吧
Dialogue: 0,0:22:16.90,0:22:18.10,Default,,0,0,0,,外食如何？
Dialogue: 0,0:22:18.10,0:22:20.30,Default,,0,0,0,,之前说过每个月要外食一次
Dialogue: 0,0:22:20.30,0:22:21.11,Default,,0,0,0,,现在出去吃？
Dialogue: 0,0:22:21.11,0:22:22.94,Default,,0,0,0,,而且你看起来也很累的样子
Dialogue: 0,0:22:22.94,0:22:26.81,Default,,0,0,0,,就是因为很累 所以我想马上吃饭
Dialogue: 0,0:22:29.01,0:22:32.05,Default,,0,0,0,,出去吃饭吧
Dialogue: 0,0:22:35.45,0:22:37.39,Default,,0,0,0,,十姐妹……
Dialogue: 0,0:22:37.39,0:22:39.39,Default,,0,0,0,,佩罗雄 佩罗子
Dialogue: 0,0:22:39.39,0:22:40.62,Default,,0,0,0,,什么时候取了名字？
Dialogue: 0,0:22:40.62,0:22:42.86,Default,,0,0,0,,佩罗子昏倒了
Dialogue: 0,0:22:44.40,0:22:45.66,Default,,0,0,0,,没有昏倒啊
Dialogue: 0,0:22:50.94,0:22:53.34,Default,,0,0,0,,我就知道是这样
Dialogue: 0,0:22:54.61,0:22:58.31,Default,,0,0,0,,又不是3岁小孩 瞒我也没用吧
Dialogue: 0,0:22:58.31,0:23:00.95,Default,,0,0,0,,对不起 我不是故意的
Dialogue: 0,0:23:03.52,0:23:04.82,Default,,0,0,0,,我去买微波加热的饭回来
Dialogue: 0,0:23:04.82,0:23:05.72,Default,,0,0,0,,我去好了
Dialogue: 0,0:23:05.72,0:23:07.52,Default,,0,0,0,,不用 反正我还穿着外套
Dialogue: 0,0:23:07.52,0:23:09.02,Default,,0,0,0,,不然我们一起去买
Dialogue: 0,0:23:09.02,0:23:12.39,Default,,0,0,0,,做饭是我负责的工作 拜托你帮忙是我的错
Dialogue: 0,0:23:12.39,0:23:14.56,Default,,0,0,0,,所以我去买回来
Dialogue: 0,0:23:33.78,0:23:37.15,Default,,0,0,0,,我今天想跟你说清楚
Dialogue: 0,0:23:38.42,0:23:43.36,Default,,0,0,0,,我绝对不可能喜欢你
Dialogue: 0,0:23:43.36,0:23:45.12,Default,,0,0,0,,绝对不可能吗？
Dialogue: 0,0:23:45.12,0:23:48.09,Default,,0,0,0,,因为我觉得我们很像
Dialogue: 0,0:23:48.09,0:23:54.97,Default,,0,0,0,,就是如果被男人消费 你宁可消费对方的这个想法
Dialogue: 0,0:23:54.97,0:23:58.30,Default,,0,0,0,,觉得男女之间不过是这样
Dialogue: 0,0:23:58.30,0:24:00.97,Default,,0,0,0,,只要彼此开心 好好享乐就好
Dialogue: 0,0:24:00.97,0:24:04.18,Default,,0,0,0,,你是不是这么想？
Dialogue: 0,0:24:04.18,0:24:07.41,Default,,0,0,0,,既然你了解 那就好说了
Dialogue: 0,0:24:07.41,0:24:09.92,Default,,0,0,0,,你不觉得我们很登对吗？
Dialogue: 0,0:24:09.92,0:24:12.05,Default,,0,0,0,,以前我会这么想
Dialogue: 0,0:24:12.05,0:24:17.49,Default,,0,0,0,,不过我睽违十几年再度坠入情网
Dialogue: 0,0:24:18.76,0:24:25.36,Default,,0,0,0,,爱一个人爱到 连自己都觉得自己很可笑
Dialogue: 0,0:24:26.20,0:24:28.83,Default,,0,0,0,,土屋部长
Dialogue: 0,0:24:28.83,0:24:32.37,Default,,0,0,0,,恭喜你升官
Dialogue: 0,0:24:32.37,0:24:33.40,Default,,0,0,0,,我还不是部长啦
Dialogue: 0,0:24:33.40,0:24:35.14,Default,,0,0,0,,堀内 快上车
Dialogue: 0,0:24:35.14,0:24:38.71,Default,,0,0,0,,遵命 堀内上车咯
Dialogue: 0,0:24:42.95,0:24:45.02,Default,,0,0,0,,很少看她喝得这么醉
Dialogue: 0,0:24:45.02,0:24:46.78,Default,,0,0,0,,我也蛮醉的
Dialogue: 0,0:24:46.78,0:24:49.02,Default,,0,0,0,,我也是
Dialogue: 0,0:24:49.02,0:24:51.29,Default,,0,0,0,,百合小姐怎么说？
Dialogue: 0,0:24:51.29,0:24:52.52,Default,,0,0,0,,没回信
Dialogue: 0,0:24:52.52,0:24:54.56,Default,,0,0,0,,还在工作吗？
Dialogue: 0,0:24:54.56,0:24:58.70,Default,,0,0,0,,我们公司前阵子也是一直乱哄哄的
Dialogue: 0,0:24:58.70,0:25:00.66,Default,,0,0,0,,我现在好不容易才能过来
Dialogue: 0,0:25:00.66,0:25:01.87,Default,,0,0,0,,很辛苦吗？
Dialogue: 0,0:25:01.87,0:25:05.00,Default,,0,0,0,,很辛苦
Dialogue: 0,0:25:05.00,0:25:09.34,Default,,0,0,0,,心中唯一的慰藉就只有传LINE
Dialogue: 0,0:25:13.14,0:25:16.35,Default,,0,0,0,,你跟那个型男
Dialogue: 0,0:25:16.35,0:25:18.88,Default,,0,0,0,,结果没有克服难关吗？
Dialogue: 0,0:25:22.95,0:25:26.36,Default,,0,0,0,,如果喜欢他 就勇敢投入他的怀抱啊
Dialogue: 0,0:25:26.36,0:25:27.86,Default,,0,0,0,,如果我年轻就敢这么做
Dialogue: 0,0:25:27.86,0:25:32.50,Default,,0,0,0,,你就是想太多才会失败
Dialogue: 0,0:25:32.50,0:25:35.03,Default,,0,0,0,,你以前也这么说过
Dialogue: 0,0:25:35.03,0:25:42.51,Default,,0,0,0,,因为我就算想见自己喜欢的人 也见不到
Dialogue: 0,0:25:48.95,0:25:51.85,Default,,0,0,0,,我好嫉妒 好羡慕
Dialogue: 0,0:25:52.88,0:25:58.39,Default,,0,0,0,,全世界能自由见到 自己喜欢的人的那些人
Dialogue: 0,0:26:39.30,0:26:44.14,Default,,0,0,0,,今天的我好差劲
Dialogue: 0,0:26:44.14,0:26:49.57,Default,,0,0,0,,一旦无路可退 马上露出本性
Dialogue: 0,0:26:49.57,0:26:51.88,Default,,0,0,0,,你太自作聪明了
Dialogue: 0,0:26:51.88,0:26:54.61,Default,,0,0,0,,骄傲 自以为是
Dialogue: 0,0:26:54.61,0:26:57.15,Default,,0,0,0,,薰 我劝你最好改一下
Dialogue: 0,0:26:57.15,0:27:01.09,Default,,0,0,0,,自作聪明的美栗
Dialogue: 0,0:27:02.62,0:27:06.96,Default,,0,0,0,,我好讨厌自己
Dialogue: 0,0:27:08.26,0:27:13.26,Default,,0,0,0,,低自尊的人其实是我
Dialogue: 0,0:27:14.26,0:27:19.10,Default,,0,0,0,,平匡先生爱上的是能完美做好家事
Dialogue: 0,0:27:19.10,0:27:24.68,Default,,0,0,0,,总是面带笑容 很温柔的完美妻子
Dialogue: 0,0:27:24.68,0:27:30.08,Default,,0,0,0,,才不是因为没煮饭 就马上变脸的女人
Dialogue: 0,0:27:34.75,0:27:37.66,Default,,0,0,0,,好想被选上
Dialogue: 0,0:27:37.66,0:27:41.43,Default,,0,0,0,,好想被认同
Dialogue: 0,0:27:41.43,0:27:43.73,Default,,0,0,0,,可是……
Dialogue: 0,0:27:43.73,0:27:47.13,Default,,0,0,0,,我却离想成为的那个自己
Dialogue: 0,0:27:47.13,0:27:49.40,Default,,0,0,0,,越来越遥远
Dialogue: 0,0:28:12.89,0:28:15.53,Default,,0,0,0,,可以一起坐吗？
Dialogue: 0,0:28:15.53,0:28:17.86,Default,,0,0,0,,还有其他空位吧
Dialogue: 0,0:28:17.86,0:28:21.93,Default,,0,0,0,,你跟风见先生到底是什么关系？
Dialogue: 0,0:28:21.93,0:28:24.07,Default,,0,0,0,,相差17岁这么多
Dialogue: 0,0:28:24.07,0:28:28.47,Default,,0,0,0,,应该不至于当他是恋爱对象吧
Dialogue: 0,0:28:28.47,0:28:30.88,Default,,0,0,0,,你连我的年龄都知道啊
Dialogue: 0,0:28:30.88,0:28:35.95,Default,,0,0,0,,都快50岁还勾引年轻男人 你不觉得很空虚吗？
Dialogue: 0,0:28:35.95,0:28:37.95,Default,,0,0,0,,需要订正的地方太多
Dialogue: 0,0:28:37.95,0:28:39.48,Default,,0,0,0,,我都不知道该从哪里纠正
Dialogue: 0,0:28:39.48,0:28:41.49,Default,,0,0,0,,正确年龄是49岁
Dialogue: 0,0:28:41.49,0:28:44.16,Default,,0,0,0,,不过别人看起来都一样
Dialogue: 0,0:28:44.16,0:28:46.92,Default,,0,0,0,,我有看过出钱抗老的女人
Dialogue: 0,0:28:46.92,0:28:51.06,Default,,0,0,0,,不过没见过花钱让自己变老的女人
Dialogue: 0,0:28:51.06,0:28:55.70,Default,,0,0,0,,你好像把自己的年轻看得很有价值
Dialogue: 0,0:28:55.70,0:28:59.57,Default,,0,0,0,,毕竟我的年龄只有你的一半
Dialogue: 0,0:29:00.77,0:29:05.21,Default,,0,0,0,,如果问我为什么感到空虚
Dialogue: 0,0:29:05.21,0:29:11.32,Default,,0,0,0,,那就是在日本有很多 跟你有同样想法的女人
Dialogue: 0,0:29:11.32,0:29:14.45,Default,,0,0,0,,你现在觉得毫无价值而摒弃的东西
Dialogue: 0,0:29:14.45,0:29:17.56,Default,,0,0,0,,也是你将来会走上的未来
Dialogue: 0,0:29:17.56,0:29:20.49,Default,,0,0,0,,自己有一天会成为 自己瞧不起的人
Dialogue: 0,0:29:20.49,0:29:23.73,Default,,0,0,0,,不觉得这样很心酸吗？
Dialogue: 0,0:29:23.73,0:29:28.27,Default,,0,0,0,,在我们周遭有许多诅咒
Dialogue: 0,0:29:28.27,0:29:32.54,Default,,0,0,0,,你感受到的也是其中一种诅咒
Dialogue: 0,0:29:33.80,0:29:37.14,Default,,0,0,0,,不要对自己下诅咒
Dialogue: 0,0:29:37.14,0:29:42.21,Default,,0,0,0,,快点逃离那么可怕的诅咒
Dialogue: 0,0:30:01.63,0:30:03.74,Default,,0,0,0,,久等了
Dialogue: 0,0:30:03.74,0:30:06.24,Default,,0,0,0,,浴室空间不会很小吗？
Dialogue: 0,0:30:06.24,0:30:08.64,Default,,0,0,0,,在里面比较能专心
Dialogue: 0,0:30:11.18,0:30:13.91,Default,,0,0,0,,请多指教
Dialogue: 0,0:30:13.91,0:30:18.82,Default,,0,0,0,,家事分担变更后1个礼拜 请老实说出感想
Dialogue: 0,0:30:21.82,0:30:23.96,Default,,0,0,0,,那我先说
Dialogue: 0,0:30:23.96,0:30:30.36,Default,,0,0,0,,我觉得分担还蛮麻烦的
Dialogue: 0,0:30:30.36,0:30:35.17,Default,,0,0,0,,如果对方没做好分担的工作 就会觉得很扣分
Dialogue: 0,0:30:35.17,0:30:37.54,Default,,0,0,0,,不过当对方有做好的时候
Dialogue: 0,0:30:37.54,0:30:40.90,Default,,0,0,0,,又会觉得本来就是对方该负责 做好是理所当然的事
Dialogue: 0,0:30:40.90,0:30:43.64,Default,,0,0,0,,不会有感谢的心情
Dialogue: 0,0:30:43.64,0:30:47.88,Default,,0,0,0,,我在想是不是需要 能积极奖励对方的制度
Dialogue: 0,0:30:47.88,0:30:49.71,Default,,0,0,0,,做饭……
Dialogue: 0,0:30:49.71,0:30:54.25,Default,,0,0,0,,明明是我该负责 可是却没做好 我很抱歉
Dialogue: 0,0:30:54.25,0:30:57.62,Default,,0,0,0,,不 我不是在责备你
Dialogue: 0,0:30:57.62,0:31:01.36,Default,,0,0,0,,我看干脆取消家事分担好了
Dialogue: 0,0:31:01.36,0:31:05.76,Default,,0,0,0,,像分租公寓一样 自己的事情自己做
Dialogue: 0,0:31:05.76,0:31:09.43,Default,,0,0,0,,一个人也会自己做饭 打扫吧
Dialogue: 0,0:31:09.43,0:31:12.97,Default,,0,0,0,,不过这样的话 共用空间可能会都不去打扫
Dialogue: 0,0:31:12.97,0:31:16.61,Default,,0,0,0,,不然家事全部由我来做
Dialogue: 0,0:31:16.61,0:31:20.21,Default,,0,0,0,,不过那是志工性质
Dialogue: 0,0:31:20.21,0:31:21.04,Default,,0,0,0,,志工？
Dialogue: 0,0:31:21.04,0:31:23.11,Default,,0,0,0,,因为我是志工
Dialogue: 0,0:31:23.11,0:31:27.75,Default,,0,0,0,,所以只要觉得今天不想煮饭 我就不会煮
Dialogue: 0,0:31:27.75,0:31:31.32,Default,,0,0,0,,今天不想打扫就不打扫
Dialogue: 0,0:31:31.32,0:31:32.39,Default,,0,0,0,,因为我是志工
Dialogue: 0,0:31:32.39,0:31:34.66,Default,,0,0,0,,所以不想听到你问我 “今天怎么没做饭”
Dialogue: 0,0:31:34.66,0:31:36.76,Default,,0,0,0,,也不要跟我抱怨家里很脏乱
Dialogue: 0,0:31:36.76,0:31:40.70,Default,,0,0,0,,因为我是志工 这不是我的工作
Dialogue: 0,0:31:42.67,0:31:46.24,Default,,0,0,0,,美栗小姐 好像离题了
Dialogue: 0,0:31:55.95,0:31:58.65,Default,,0,0,0,,如果要结束
Dialogue: 0,0:31:58.65,0:32:00.55,Default,,0,0,0,,就要趁现在
Dialogue: 0,0:32:01.52,0:32:07.69,Default,,0,0,0,,你也觉得这样的生活很麻烦吧
Dialogue: 0,0:32:09.26,0:32:11.90,Default,,0,0,0,,像跟我一起生活之前那样
Dialogue: 0,0:32:11.90,0:32:14.26,Default,,0,0,0,,你的薪水应该够请
Dialogue: 0,0:32:14.26,0:32:18.57,Default,,0,0,0,,外面的家事帮手每周来打扫一次
Dialogue: 0,0:32:19.84,0:32:22.57,Default,,0,0,0,,你一个人一定没问题
Dialogue: 0,0:32:22.57,0:32:29.05,Default,,0,0,0,,不会说什么主妇的劳动对价 这种自作聪明的话
Dialogue: 0,0:32:29.05,0:32:36.75,Default,,0,0,0,,坦率的开心接受你求婚的女性 一定很多
Dialogue: 0,0:32:38.29,0:32:42.23,Default,,0,0,0,,那是很正常的
Dialogue: 0,0:32:44.10,0:32:49.47,Default,,0,0,0,,你完全没必要给自己找麻烦
Dialogue: 0,0:33:17.43,0:33:20.60,Default,,0,0,0,,美栗小姐关上的心门
Dialogue: 0,0:33:20.60,0:33:22.70,Default,,0,0,0,,要跟风见先生交换也行
Dialogue: 0,0:33:22.70,0:33:25.24,Default,,0,0,0,,请不要揣测或是分析我
Dialogue: 0,0:33:25.24,0:33:30.88,Default,,0,0,0,,也许跟我之前关上的一样
Dialogue: 0,0:33:30.88,0:33:33.38,Default,,0,0,0,,如果是这样的话
Dialogue: 0,0:33:34.54,0:33:39.42,Default,,0,0,0,,我知道该怎么打开
Dialogue: 0,0:33:39.42,0:33:41.79,Default,,0,0,0,,可不可以成为我的恋人？
Dialogue: 0,0:33:41.79,0:33:44.12,Default,,0,0,0,,不管几次都努力尝试 甚至让人快受不了
Dialogue: 0,0:33:44.12,0:33:45.76,Default,,0,0,0,,身体接触怎么样？
Dialogue: 0,0:33:45.76,0:33:47.26,Default,,0,0,0,,从拥抱开始
Dialogue: 0,0:33:47.26,0:33:50.60,Default,,0,0,0,,不放弃 不断敲门的……
Dialogue: 0,0:33:50.60,0:33:52.90,Default,,0,0,0,,这样会害我越来越喜欢你
Dialogue: 0,0:33:52.90,0:33:53.86,Default,,0,0,0,,笨蛋
Dialogue: 0,0:33:53.86,0:33:57.77,Default,,0,0,0,,不是别人
Dialogue: 0,0:33:57.77,0:34:00.10,Default,,0,0,0,,就是美栗小姐
Dialogue: 0,0:34:04.88,0:34:07.54,Default,,0,0,0,,很抱歉打扰你工作
Dialogue: 0,0:34:07.54,0:34:10.01,Default,,0,0,0,,可以跟你谈一下吗？
Dialogue: 0,0:34:18.02,0:34:21.93,Default,,0,0,0,,如果一直逃避麻烦
Dialogue: 0,0:34:21.93,0:34:25.83,Default,,0,0,0,,逃避到极限的话
Dialogue: 0,0:34:25.83,0:34:31.14,Default,,0,0,0,,就连走路 吃饭也会觉得麻烦
Dialogue: 0,0:34:31.14,0:34:35.94,Default,,0,0,0,,甚至连呼吸都觉得麻烦
Dialogue: 0,0:34:37.31,0:34:42.51,Default,,0,0,0,,这样不就跟死掉没两样吗？
Dialogue: 0,0:34:49.72,0:34:51.66,Default,,0,0,0,,什么意思？
Dialogue: 0,0:34:54.76,0:34:58.70,Default,,0,0,0,,要活下去 本来就很麻烦
Dialogue: 0,0:35:00.50,0:35:04.54,Default,,0,0,0,,不管是一个人还是两个人都一样
Dialogue: 0,0:35:04.54,0:35:09.61,Default,,0,0,0,,彼此有各自嫌麻烦的地方
Dialogue: 0,0:35:09.61,0:35:14.41,Default,,0,0,0,,反正不管怎么样都很麻烦
Dialogue: 0,0:35:14.41,0:35:18.42,Default,,0,0,0,,那么在一起也是一个方法吧
Dialogue: 0,0:35:19.65,0:35:21.85,Default,,0,0,0,,可以彼此商量
Dialogue: 0,0:35:21.85,0:35:26.96,Default,,0,0,0,,觉得没办法时就隔一阵子再说
Dialogue: 0,0:35:26.96,0:35:29.93,Default,,0,0,0,,就算很勉强
Dialogue: 0,0:35:29.93,0:35:33.03,Default,,0,0,0,,应该还是能撑下去才对
Dialogue: 0,0:35:33.03,0:35:37.24,Default,,0,0,0,,我觉得不可能无法撑下去
Dialogue: 0,0:35:37.24,0:35:44.21,Default,,0,0,0,,美栗小姐说自己不正常
Dialogue: 0,0:35:44.21,0:35:46.74,Default,,0,0,0,,不过在我看来
Dialogue: 0,0:35:46.74,0:35:49.81,Default,,0,0,0,,会觉得你现在才发现吗？
Dialogue: 0,0:35:49.81,0:35:52.42,Default,,0,0,0,,我早就知道你是这样
Dialogue: 0,0:35:53.48,0:35:56.59,Default,,0,0,0,,这根本没什么大不了的
Dialogue: 0,0:35:58.19,0:36:01.12,Default,,0,0,0,,如果以社会常识来看
Dialogue: 0,0:36:02.49,0:36:04.66,Default,,0,0,0,,我们两个……
Dialogue: 0,0:36:04.66,0:36:07.83,Default,,0,0,0,,从一开始就不正常
Dialogue: 0,0:36:12.50,0:36:15.34,Default,,0,0,0,,你也太后知后觉了吧
Dialogue: 0,0:36:24.38,0:36:29.12,Default,,0,0,0,,我很期待青空市场
Dialogue: 0,0:36:34.99,0:36:38.76,Default,,0,0,0,,晚安
Dialogue: 0,0:36:47.64,0:36:50.44,Default,,0,0,0,,每当感到不顺利的时候
Dialogue: 0,0:36:52.54,0:36:55.61,Default,,0,0,0,,有人等着自己
Dialogue: 0,0:36:55.61,0:36:58.35,Default,,0,0,0,,有人相信自己
Dialogue: 0,0:36:59.72,0:37:02.35,Default,,0,0,0,,不能迷失方向
Dialogue: 0,0:37:07.19,0:37:11.20,Default,,0,0,0,,一步步的重建起来
Dialogue: 0,0:37:13.40,0:37:15.87,Default,,0,0,0,,一定要重建起来
Dialogue: 0,0:37:15.87,0:37:17.64,Default,,0,0,0,,慢慢来也没关系
Dialogue: 0,0:37:18.34,0:37:20.87,Default,,0,0,0,,鞋子很便宜哦
Dialogue: 0,0:37:21.57,0:37:24.38,Default,,0,0,0,,3根200圆 很划算哦
Dialogue: 0,0:37:24.38,0:37:25.61,Default,,0,0,0,,欢迎光临
Dialogue: 0,0:37:25.61,0:37:26.58,Default,,0,0,0,,要不要买仙贝？
Dialogue: 0,0:37:26.58,0:37:30.08,Default,,0,0,0,,到底是怎么回事啊
Dialogue: 0,0:37:30.08,0:37:31.45,Default,,0,0,0,,美栗小姐 不好了
Dialogue: 0,0:37:31.45,0:37:33.35,Default,,0,0,0,,传单失踪了
Dialogue: 0,0:37:33.35,0:37:34.62,Default,,0,0,0,,真的有拿来吗？
Dialogue: 0,0:37:34.62,0:37:37.29,Default,,0,0,0,,那是商店街的介绍传单 不发出去不就白办了
Dialogue: 0,0:37:37.29,0:37:38.36,Default,,0,0,0,,说得也是
Dialogue: 0,0:37:38.36,0:37:41.12,Default,,0,0,0,,我知道了
Dialogue: 0,0:37:44.36,0:37:47.80,Default,,0,0,0,,我把传单放在货车的货架上
Dialogue: 0,0:37:47.80,0:37:50.43,Default,,0,0,0,,然后被风全吹跑了
Dialogue: 0,0:37:50.43,0:37:51.44,Default,,0,0,0,,你白痴啊
Dialogue: 0,0:37:51.44,0:37:53.60,Default,,0,0,0,,只剩下1张
Dialogue: 0,0:37:54.84,0:37:55.91,Default,,0,0,0,,我去影印
Dialogue: 0,0:37:55.91,0:37:58.51,Default,,0,0,0,,大家顾好自己的店
Dialogue: 0,0:37:58.51,0:38:00.04,Default,,0,0,0,,不好意思
Dialogue: 0,0:38:00.04,0:38:01.78,Default,,0,0,0,,美栗
Dialogue: 0,0:38:01.78,0:38:03.28,Default,,0,0,0,,百合 沼田先生
Dialogue: 0,0:38:03.28,0:38:06.25,Default,,0,0,0,,这里好棒 好像很好玩
Dialogue: 0,0:38:06.25,0:38:09.65,Default,,0,0,0,,抱歉 百合 我去去就回
Dialogue: 0,0:38:09.65,0:38:12.52,Default,,0,0,0,,我还没摸够
Dialogue: 0,0:38:12.52,0:38:15.03,Default,,0,0,0,,百合小姐 沼田先生
Dialogue: 0,0:38:15.03,0:38:16.19,Default,,0,0,0,,日野呢？
Dialogue: 0,0:38:16.19,0:38:18.56,Default,,0,0,0,,好像小孩又发烧了
Dialogue: 0,0:38:18.56,0:38:19.60,Default,,0,0,0,,怎么又这样
Dialogue: 0,0:38:19.60,0:38:20.86,Default,,0,0,0,,好可惜
Dialogue: 0,0:38:20.86,0:38:24.20,Default,,0,0,0,,可能注定是这样的命运吧
Dialogue: 0,0:38:24.20,0:38:25.74,Default,,0,0,0,,美栗不知道跑去哪里了
Dialogue: 0,0:38:25.74,0:38:29.67,Default,,0,0,0,,我刚刚有看到她跑过去
Dialogue: 0,0:38:29.67,0:38:33.21,Default,,0,0,0,,没想到美栗小姐跑这么快
Dialogue: 0,0:38:33.21,0:38:35.41,Default,,0,0,0,,这是什么感想啊
Dialogue: 0,0:38:35.41,0:38:37.45,Default,,0,0,0,,这就是爱吧
Dialogue: 0,0:38:40.28,0:38:44.22,Default,,0,0,0,,是谁乱丢垃圾啊
Dialogue: 0,0:38:44.22,0:38:45.22,Default,,0,0,0,,怎么办？
Dialogue: 0,0:38:45.22,0:38:48.22,Default,,0,0,0,,土屋小姐一定会捡起来吧
Dialogue: 0,0:38:48.22,0:38:50.36,Default,,0,0,0,,那就来捡吧
Dialogue: 0,0:38:50.36,0:38:56.67,Default,,0,0,0,,说来说去 最被年龄这个诅咒 束缚住的是我自己吧
Dialogue: 0,0:38:57.97,0:39:00.77,Default,,0,0,0,,我变得好胆小
Dialogue: 0,0:39:00.77,0:39:04.18,Default,,0,0,0,,与其对年龄感到自卑 跟他交往下去
Dialogue: 0,0:39:04.18,0:39:07.18,Default,,0,0,0,,宁可当朋友就好
Dialogue: 0,0:39:07.18,0:39:11.55,Default,,0,0,0,,结果还是无法随心所愿
Dialogue: 0,0:39:11.55,0:39:15.22,Default,,0,0,0,,我也很胆小
Dialogue: 0,0:39:15.22,0:39:17.76,Default,,0,0,0,,因为常被甩的关系
Dialogue: 0,0:39:17.76,0:39:21.19,Default,,0,0,0,,无法传出最关键的简讯
Dialogue: 0,0:39:21.19,0:39:25.46,Default,,0,0,0,,一直逃避 拖延时间
Dialogue: 0,0:39:25.46,0:39:27.80,Default,,0,0,0,,看来我们都是没用的大人
Dialogue: 0,0:39:27.80,0:39:30.67,Default,,0,0,0,,真不知道自己在保护什么
Dialogue: 0,0:39:30.67,0:39:34.04,Default,,0,0,0,,要不要传简讯看看？
Dialogue: 0,0:39:34.04,0:39:36.54,Default,,0,0,0,,我也传
Dialogue: 0,0:39:39.58,0:39:43.65,Default,,0,0,0,,如果结果很惨烈 你再帮我捡骨
Dialogue: 0,0:39:43.65,0:39:46.15,Default,,0,0,0,,那我的骨头也拜托你了
Dialogue: 0,0:39:46.15,0:39:49.35,Default,,0,0,0,,我会捡的 包在我身上
Dialogue: 0,0:39:49.35,0:39:52.16,Default,,0,0,0,,影印机竟然碳粉用光 有够离谱的
Dialogue: 0,0:39:52.16,0:39:54.62,Default,,0,0,0,,还有哪里能影印啊
Dialogue: 0,0:40:00.30,0:40:03.40,Default,,0,0,0,,传单
Dialogue: 0,0:40:03.40,0:40:07.47,Default,,0,0,0,,谢谢你们 百合的部下们
Dialogue: 0,0:40:11.08,0:40:14.34,Default,,0,0,0,,我以后也叫她百合好了
Dialogue: 0,0:40:14.34,0:40:15.71,Default,,0,0,0,,千万不要
Dialogue: 0,0:40:15.71,0:40:18.85,Default,,0,0,0,,百合是我的昵称
Dialogue: 0,0:40:20.12,0:40:24.46,Default,,0,0,0,,我擅自借用土屋小姐的名字 上同志APP
Dialogue: 0,0:40:25.72,0:40:27.46,Default,,0,0,0,,你是同志吗？
Dialogue: 0,0:40:29.03,0:40:31.13,Default,,0,0,0,,不能说出去哦
Dialogue: 0,0:40:31.13,0:40:34.40,Default,,0,0,0,,我还没有勇气出柜
Dialogue: 0,0:40:39.74,0:40:43.01,Default,,0,0,0,,在同志APP认识一个很谈得来的人
Dialogue: 0,0:40:43.01,0:40:47.41,Default,,0,0,0,,明明也在附近工作 可是就是不肯跟我见面
Dialogue: 0,0:40:47.41,0:40:51.15,Default,,0,0,0,,还叫我当他已经死了……
Dialogue: 0,0:40:53.02,0:40:53.85,Default,,0,0,0,,怎么了？
Dialogue: 0,0:41:10.03,0:41:12.27,Default,,0,0,0,,不会吧
Dialogue: 0,0:41:19.11,0:41:22.01,Default,,0,0,0,,找到传单了 请拿去发
Dialogue: 0,0:41:24.65,0:41:26.68,Default,,0,0,0,,找您250圆
Dialogue: 0,0:41:26.68,0:41:29.49,Default,,0,0,0,,-谢谢惠顾 -谢谢
Dialogue: 0,0:41:29.49,0:41:31.49,Default,,0,0,0,,小安 你怎么叫他帮忙
Dialogue: 0,0:41:31.49,0:41:33.19,Default,,0,0,0,,因为他一直在发呆
Dialogue: 0,0:41:33.19,0:41:35.33,Default,,0,0,0,,他看起来像发呆 其实并没有
Dialogue: 0,0:41:35.33,0:41:36.93,Default,,0,0,0,,晒恩爱啊
Dialogue: 0,0:41:36.93,0:41:39.30,Default,,0,0,0,,刚刚应该不是晒恩爱
Dialogue: 0,0:41:39.30,0:41:41.26,Default,,0,0,0,,津崎先生
Dialogue: 0,0:41:44.20,0:41:45.07,Default,,0,0,0,,有吓到吗？
Dialogue: 0,0:41:45.07,0:41:46.54,Default,,0,0,0,,-有吓到吧 -吓到了
Dialogue: 0,0:41:46.54,0:41:49.14,Default,,0,0,0,,我说小孩发烧是骗你的
Dialogue: 0,0:41:49.14,0:41:50.61,Default,,0,0,0,,你是日野先生吗？
Dialogue: 0,0:41:50.61,0:41:52.28,Default,,0,0,0,,-你是美栗吗？ -是的
Dialogue: 0,0:41:52.28,0:41:54.34,Default,,0,0,0,,我们终于见面了
Dialogue: 0,0:41:54.34,0:41:55.75,Default,,0,0,0,,我还以为永远见不到面
Dialogue: 0,0:41:55.75,0:41:58.22,Default,,0,0,0,,我也是
Dialogue: 0,0:41:58.22,0:42:00.62,Default,,0,0,0,,-能见到你太开心了 -为什么这么感动？
Dialogue: 0,0:42:00.62,0:42:02.89,Default,,0,0,0,,这是颠覆命运的瞬间
Dialogue: 0,0:42:02.89,0:42:04.96,Default,,0,0,0,,津崎先生
Dialogue: 0,0:42:07.49,0:42:09.39,Default,,0,0,0,,好久不见
Dialogue: 0,0:42:09.39,0:42:10.66,Default,,0,0,0,,你好
Dialogue: 0,0:42:12.43,0:42:13.96,Default,,0,0,0,,她是我老婆
Dialogue: 0,0:42:13.96,0:42:16.13,Default,,0,0,0,,-幸会 -幸会
Dialogue: 0,0:42:16.13,0:42:18.14,Default,,0,0,0,,我是日野的妻子
Dialogue: 0,0:42:20.37,0:42:22.24,Default,,0,0,0,,你还没传出去吗？
Dialogue: 0,0:42:22.24,0:42:24.61,Default,,0,0,0,,我都已经传了
Dialogue: 0,0:42:24.61,0:42:27.71,Default,,0,0,0,,只是要问他 要不要来青空市场而已吧
Dialogue: 0,0:42:27.71,0:42:31.05,Default,,0,0,0,,一旦真的要传 手指就动不了
Dialogue: 0,0:42:31.05,0:42:31.78,Default,,0,0,0,,手机给我 我帮你传
Dialogue: 0,0:42:31.78,0:42:33.12,Default,,0,0,0,,-不用啦 -拿给我啦
Dialogue: 0,0:42:33.12,0:42:35.89,Default,,0,0,0,,我带风见来了
Dialogue: 0,0:42:46.60,0:42:48.26,Default,,0,0,0,,小沼 过来一下
Dialogue: 0,0:42:48.26,0:42:50.87,Default,,0,0,0,,-干嘛？山哥 怎么了？ -过来一下
Dialogue: 0,0:42:50.87,0:42:52.97,Default,,0,0,0,,-怎么回事？ -到那边去啦
Dialogue: 0,0:42:55.57,0:42:58.61,Default,,0,0,0,,请多关照千木通商店街
Dialogue: 0,0:42:58.61,0:42:59.91,Default,,0,0,0,,你不知道他长怎样吗？
Dialogue: 0,0:42:59.91,0:43:02.71,Default,,0,0,0,,我们没有交换照片
Dialogue: 0,0:43:02.71,0:43:07.08,Default,,0,0,0,,他说标记是特大海苔仙贝
Dialogue: 0,0:43:16.03,0:43:18.06,Default,,0,0,0,,她说去找你呛声
Dialogue: 0,0:43:18.06,0:43:22.00,Default,,0,0,0,,那个乐观怪兽自己来跟我这样自首
Dialogue: 0,0:43:22.00,0:43:24.13,Default,,0,0,0,,好夸张的绰号
Dialogue: 0,0:43:24.13,0:43:26.37,Default,,0,0,0,,她怎么说？
Dialogue: 0,0:43:26.37,0:43:29.61,Default,,0,0,0,,她叫你让她看看什么叫幸福的50岁
Dialogue: 0,0:43:31.81,0:43:34.81,Default,,0,0,0,,竟然又来挑衅我
Dialogue: 0,0:43:34.81,0:43:40.18,Default,,0,0,0,,她还说 “那个大姐应该喜欢风见先生”
Dialogue: 0,0:43:40.18,0:43:44.46,Default,,0,0,0,,还说“你们老大不小的” “真是有够蠢”
Dialogue: 0,0:43:47.99,0:43:49.83,Default,,0,0,0,,所以你才来吗？
Dialogue: 0,0:43:49.83,0:43:51.76,Default,,0,0,0,,要不是因为这样
Dialogue: 0,0:43:51.76,0:43:57.23,Default,,0,0,0,,被狠狠甩掉后 我哪好意思厚着脸皮出现
Dialogue: 0,0:43:57.23,0:43:59.14,Default,,0,0,0,,因为有胜算才来啊
Dialogue: 0,0:43:59.14,0:44:01.24,Default,,0,0,0,,还没这么夸张
Dialogue: 0,0:44:01.24,0:44:05.64,Default,,0,0,0,,只是抱着一丝希望
Dialogue: 0,0:44:05.64,0:44:07.68,Default,,0,0,0,,说得也是
Dialogue: 0,0:44:07.68,0:44:11.05,Default,,0,0,0,,如果毫无机会 怎么可能行动
Dialogue: 0,0:44:11.05,0:44:13.62,Default,,0,0,0,,谁叫我们是不自由的大人
Dialogue: 0,0:44:19.89,0:44:22.09,Default,,0,0,0,,活到这个年纪
Dialogue: 0,0:44:22.09,0:44:25.30,Default,,0,0,0,,会看气氛跟对方发生关系
Dialogue: 0,0:44:25.30,0:44:27.76,Default,,0,0,0,,也许不知不觉开始交往
Dialogue: 0,0:44:27.76,0:44:29.07,Default,,0,0,0,,我才不会
Dialogue: 0,0:44:29.07,0:44:33.64,Default,,0,0,0,,我喜欢你
Dialogue: 0,0:44:35.97,0:44:38.31,Default,,0,0,0,,我想说清楚这点
Dialogue: 0,0:44:39.51,0:44:41.41,Default,,0,0,0,,我也喜欢你
Dialogue: 0,0:44:47.05,0:44:50.19,Default,,0,0,0,,不是当你是外甥
Dialogue: 0,0:44:54.02,0:44:57.39,Default,,0,0,0,,虽然不知道以后会怎么样
Dialogue: 0,0:44:57.39,0:45:01.56,Default,,0,0,0,,不过我想试着忠于现在的心情
Dialogue: 0,0:45:22.75,0:45:25.86,Default,,0,0,0,,见不到你 我好痛苦
Dialogue: 0,0:45:42.91,0:45:45.18,Default,,0,0,0,,这么突然？
Dialogue: 0,0:45:55.32,0:45:59.72,Default,,0,0,0,,在现实生活中这么做的人 我还是第一次看到
Dialogue: 0,0:45:59.72,0:46:03.26,Default,,0,0,0,,不然应该亲哪里？
Dialogue: 0,0:46:03.26,0:46:05.80,Default,,0,0,0,,应该亲哪里？
Dialogue: 0,0:46:05.80,0:46:09.50,Default,,0,0,0,,不用这么惊讶吧
Dialogue: 0,0:46:14.44,0:46:15.84,Default,,0,0,0,,美栗
Dialogue: 0,0:46:15.84,0:46:18.51,Default,,0,0,0,,你休息一下 想吃多少仙贝都没问题
Dialogue: 0,0:46:18.51,0:46:20.74,Default,,0,0,0,,谢谢 我等一下再来
Dialogue: 0,0:46:20.74,0:46:23.05,Default,,0,0,0,,等你来哦
Dialogue: 0,0:46:24.35,0:46:26.42,Default,,0,0,0,,不好意思 连这种工作都要你帮忙
Dialogue: 0,0:46:26.42,0:46:28.28,Default,,0,0,0,,没关系
Dialogue: 0,0:46:28.28,0:46:32.56,Default,,0,0,0,,你好受欢迎
Dialogue: 0,0:46:32.56,0:46:36.73,Default,,0,0,0,,能有今天可是经过了漫漫长路啊
Dialogue: 0,0:46:41.26,0:46:44.37,Default,,0,0,0,,你会想再做一次吗？
Dialogue: 0,0:46:44.37,0:46:47.00,Default,,0,0,0,,要看条件怎么样
Dialogue: 0,0:46:47.00,0:46:50.11,Default,,0,0,0,,交涉很重要
Dialogue: 0,0:46:50.11,0:46:52.68,Default,,0,0,0,,我发现一件事
Dialogue: 0,0:46:52.68,0:46:57.68,Default,,0,0,0,,以前当派遣员工时 我经常给上司提建议
Dialogue: 0,0:46:57.68,0:47:02.49,Default,,0,0,0,,像是怎么做比较有效率 或是问他为什么不这么做
Dialogue: 0,0:47:02.49,0:47:06.99,Default,,0,0,0,,不过对方根本不想我做这些
Dialogue: 0,0:47:06.99,0:47:10.43,Default,,0,0,0,,觉得我很烦就把我开除掉了
Dialogue: 0,0:47:12.63,0:47:18.64,Default,,0,0,0,,本来以为自己的自作聪明 不管到哪里都被人讨厌
Dialogue: 0,0:47:18.64,0:47:23.64,Default,,0,0,0,,不过青空市场的工作 反而很欢迎我的自作聪明
Dialogue: 0,0:47:23.64,0:47:28.28,Default,,0,0,0,,也许有些工作就是自作聪明才适合
Dialogue: 0,0:47:32.42,0:47:36.72,Default,,0,0,0,,你说自作聪明是什么意思？
Dialogue: 0,0:47:36.72,0:47:39.76,Default,,0,0,0,,我明白字面上的意思
Dialogue: 0,0:47:39.76,0:47:44.93,Default,,0,0,0,,不过自作聪明 是瞧不起对方的说法吧
Dialogue: 0,0:47:46.10,0:47:49.80,Default,,0,0,0,,我从来没有瞧不起你
Dialogue: 0,0:47:49.80,0:47:54.80,Default,,0,0,0,,更不曾觉得你自作聪明
Dialogue: 0,0:48:00.78,0:48:02.91,Default,,0,0,0,,津崎先生 过来一起喝酒
Dialogue: 0,0:48:02.91,0:48:04.92,Default,,0,0,0,,好 我马上过去
Dialogue: 0,0:48:15.96,0:48:19.20,Default,,0,0,0,,美栗小姐……
Dialogue: 0,0:48:21.20,0:48:24.20,Default,,0,0,0,,大家……都在看这边
Dialogue: 0,0:48:56.23,0:48:58.30,Default,,0,0,0,,谢谢
Dialogue: 0,0:48:59.44,0:49:03.11,Default,,0,0,0,,为什么说谢谢？
Dialogue: 0,0:49:04.88,0:49:07.61,Default,,0,0,0,,我好喜欢你
Dialogue: 0,0:49:17.32,0:49:21.22,Default,,0,0,0,,从所有束缚住我们的东西……
Dialogue: 0,0:49:21.99,0:49:22.83,Default,,0,0,0,,我来介绍一下
Dialogue: 0,0:49:22.83,0:49:25.43,Default,,0,0,0,,还有眼睛看不到的小小伤痛…… 他们是我的部下
Dialogue: 0,0:49:25.43,0:49:27.00,Default,,0,0,0,,大家好
Dialogue: 0,0:49:29.50,0:49:33.60,Default,,0,0,0,,有一天能从中得到解放
Dialogue: 0,0:49:37.44,0:49:40.08,Default,,0,0,0,,就算有时哭泣
Dialogue: 0,0:49:40.08,0:49:43.28,Default,,0,0,0,,也希望有一天能笑逐颜开
Dialogue: 0,0:49:46.72,0:49:48.02,Default,,0,0,0,,等一下
Dialogue: 0,0:49:50.29,0:49:51.76,Default,,0,0,0,,怎么样？
Dialogue: 0,0:49:51.76,0:49:53.19,Default,,0,0,0,,可以吧
Dialogue: 0,0:49:53.19,0:49:55.46,Default,,0,0,0,,不觉得“danke”这个词汇很棒吗？
Dialogue: 0,0:49:55.46,0:49:57.16,Default,,0,0,0,,danke？
Dialogue: 0,0:49:57.16,0:50:00.56,Default,,0,0,0,,短短一个字汇就能表达感谢
Dialogue: 0,0:50:00.56,0:50:03.23,Default,,0,0,0,,danke
Dialogue: 0,0:50:03.23,0:50:04.43,Default,,0,0,0,,你听我说
Dialogue: 0,0:50:04.43,0:50:06.67,Default,,0,0,0,,好像会创下有史以来最高营收
Dialogue: 0,0:50:06.67,0:50:08.07,Default,,0,0,0,,恭喜你
Dialogue: 0,0:50:08.07,0:50:09.47,Default,,0,0,0,,谢谢
Dialogue: 0,0:50:09.47,0:50:11.41,Default,,0,0,0,,美栗 工作辛苦了
Dialogue: 0,0:50:11.41,0:50:12.91,Default,,0,0,0,,谢谢你 百合
Dialogue: 0,0:50:12.91,0:50:14.24,Default,,0,0,0,,怎么回事？
Dialogue: 0,0:50:14.24,0:50:17.31,Default,,0,0,0,,好像比平常夸张很多
Dialogue: 0,0:50:20.65,0:50:23.42,Default,,0,0,0,,百合 是不是有什么开心的事？
Dialogue: 0,0:50:27.49,0:50:30.19,Default,,0,0,0,,以后要怎么办？
Dialogue: 0,0:50:31.63,0:50:34.46,Default,,0,0,0,,我开始觉得怎样都好
Dialogue: 0,0:50:34.46,0:50:38.94,Default,,0,0,0,,要正式登记或不登记都好
Dialogue: 0,0:50:39.94,0:50:44.34,Default,,0,0,0,,如果我真的去找正式工作 你会怎么样？
Dialogue: 0,0:50:44.34,0:50:48.44,Default,,0,0,0,,那只好配合你 改变生活方式
Dialogue: 0,0:50:48.44,0:50:51.21,Default,,0,0,0,,我们要继续摸索下去
Dialogue: 0,0:50:51.21,0:50:55.12,Default,,0,0,0,,就是啊 我们就继续摸索下去
Dialogue: 0,0:51:01.22,0:51:04.73,Default,,0,0,0,,我有个提议
Dialogue: 0,0:51:04.73,0:51:08.40,Default,,0,0,0,,让拥抱日复活怎么样？
Dialogue: 0,0:51:10.30,0:51:12.87,Default,,0,0,0,,太忙时会经常忘记拥抱
Dialogue: 0,0:51:12.87,0:51:18.68,Default,,0,0,0,,如果吵架又会不知道如何接触对方
Dialogue: 0,0:51:21.01,0:51:22.68,Default,,0,0,0,,我也可以提议吗？
Dialogue: 0,0:51:22.68,0:51:23.75,Default,,0,0,0,,可以
Dialogue: 0,0:51:23.75,0:51:26.12,Default,,0,0,0,,我不要求每晚
Dialogue: 0,0:51:26.12,0:51:31.25,Default,,0,0,0,,只要睡前抱抱我 感觉我就能做个好梦
Dialogue: 0,0:51:31.25,0:51:33.79,Default,,0,0,0,,像这样的要求请尽管提出来
Dialogue: 0,0:51:33.79,0:51:35.89,Default,,0,0,0,,非常Welcome
Dialogue: 0,0:51:35.89,0:51:37.29,Default,,0,0,0,,Welcome？
Dialogue: 0,0:51:37.29,0:51:39.50,Default,,0,0,0,,要不要考虑搬家？
Dialogue: 0,0:51:39.50,0:51:41.53,Default,,0,0,0,,你需要自己的房间
Dialogue: 0,0:51:41.53,0:51:44.37,Default,,0,0,0,,也需要放得下双人床的寝室
Dialogue: 0,0:51:45.47,0:51:50.37,Default,,0,0,0,,我觉得不要同床比较能睡得好
Dialogue: 0,0:51:52.64,0:51:56.01,Default,,0,0,0,,这点……再讨论
Dialogue: 0,0:51:57.25,0:52:01.05,Default,,0,0,0,,我每天早上会去叫你起床
Dialogue: 0,0:52:01.05,0:52:03.55,Default,,0,0,0,,叫我起床时……
Dialogue: 0,0:52:03.55,0:52:06.56,Default,,0,0,0,,会给我早安的亲亲吗？
Dialogue: 0,0:52:09.26,0:52:12.86,Default,,0,0,0,,既然美栗小姐提出要求 那我应该也可以
Dialogue: 0,0:52:20.80,0:52:26.64,Default,,0,0,0,,礼拜天是你来叫我起床
Dialogue: 0,0:52:28.04,0:52:30.25,Default,,0,0,0,,在那之后呢？
Dialogue: 0,0:52:32.02,0:52:34.62,Default,,0,0,0,,再讨论
Dialogue: 0,0:52:51.07,0:52:55.34,Default,,0,0,0,,美栗 美栗……
Dialogue: 0,0:53:05.08,0:53:06.32,Default,,0,0,0,,包在我身上
Dialogue: 0,0:53:06.32,0:53:08.32,Default,,0,0,0,,请加油 好的
Dialogue: 0,0:53:11.86,0:53:15.66,Default,,0,0,0,,平匡 平匡……
Dialogue: 0,0:53:22.60,0:53:24.87,Default,,0,0,0,,现在才办婚礼？
Dialogue: 0,0:53:27.70,0:53:29.61,Default,,0,0,0,,不要紧吧
Dialogue: 0,0:53:29.61,0:53:36.31,Default,,0,0,0,,从许多道路当中 不管有没有 选择理想中的道路
Dialogue: 0,0:53:44.42,0:53:46.76,Default,,0,0,0,,鲣 石鲈 快点吃啦
Dialogue: 0,0:53:46.76,0:53:48.82,Default,,0,0,0,,小鲈 八目也快点吃啊
Dialogue: 0,0:53:48.82,0:53:50.46,Default,,0,0,0,,石斑 手举起来
Dialogue: 0,0:53:50.46,0:53:52.36,Default,,0,0,0,,爸爸 停下来
Dialogue: 0,0:53:52.36,0:53:54.06,Default,,0,0,0,,老公 快点啦
Dialogue: 0,0:53:54.06,0:53:54.90,Default,,0,0,0,,是的
Dialogue: 0,0:53:54.90,0:53:58.90,Default,,0,0,0,,不管是哪一条道路 都得过着麻烦的每一天
Dialogue: 0,0:54:04.14,0:54:05.74,Default,,0,0,0,,你有办法吗？
Dialogue: 0,0:54:05.74,0:54:07.64,Default,,0,0,0,,不知道耶
Dialogue: 0,0:54:07.64,0:54:08.58,Default,,0,0,0,,你的便当
Dialogue: 0,0:54:08.58,0:54:09.71,Default,,0,0,0,,谢谢
Dialogue: 0,0:54:09.71,0:54:10.41,Default,,0,0,0,,路上小心
Dialogue: 0,0:54:10.41,0:54:11.95,Default,,0,0,0,,我去上班了
Dialogue: 0,0:54:11.95,0:54:15.85,Default,,0,0,0,,不管哪一条道路 都会碰到很甜蜜的日子
Dialogue: 0,0:54:20.36,0:54:21.06,Default,,0,0,0,,我不要
Dialogue: 0,0:54:21.06,0:54:21.69,Default,,0,0,0,,我不要 不要
Dialogue: 0,0:54:21.69,0:54:24.09,Default,,0,0,0,,-这次不算 -不算 不算
Dialogue: 0,0:54:24.09,0:54:25.63,Default,,0,0,0,,-我会加油 -拜托你了
Dialogue: 0,0:54:25.63,0:54:28.10,Default,,0,0,0,,就算碰到想逃避的日子
Dialogue: 0,0:54:28.10,0:54:30.70,Default,,0,0,0,,平匡 平匡……
Dialogue: 0,0:54:40.08,0:54:45.58,Default,,0,0,0,,只要深呼吸 查找其他道路 然后再回来
Dialogue: 0,0:54:46.72,0:54:49.45,Default,,0,0,0,,不管是好日子还是坏日子
Dialogue: 0,0:54:49.45,0:54:52.12,Default,,0,0,0,,平匡先生 不好了
Dialogue: 0,0:54:52.12,0:54:55.06,Default,,0,0,0,,昨天是礼拜二
Dialogue: 0,0:54:55.06,0:54:57.99,Default,,0,0,0,,已经过了6小时
Dialogue: 0,0:54:57.99,0:54:59.63,Default,,0,0,0,,就当作勉强赶上
Dialogue: 0,0:54:59.63,0:55:01.40,Default,,0,0,0,,就这么办
Dialogue: 0,0:55:03.57,0:55:05.50,Default,,0,0,0,,来吧
Dialogue: 0,0:55:10.84,0:55:14.44,Default,,0,0,0,,随时都可以……
Dialogue: 0,0:55:14.44,0:55:17.08,Default,,0,0,0,,从礼拜二重新开始
Dialogue: 0,0:55:32.93,0:55:38.87,Default,,0,0,0,,忙碌的城市夜一深就变得更活跃
Dialogue: 0,0:55:38.87,0:55:45.04,Default,,0,0,0,,风儿们带来乌鸦与人群
Dialogue: 0,0:55:45.04,0:55:50.88,Default,,0,0,0,,没有什么特别意义 就只是生活
Dialogue: 0,0:55:50.88,0:55:57.19,Default,,0,0,0,,只是让肚子变饿 回到你身边
Dialogue: 0,0:55:57.19,0:56:03.16,Default,,0,0,0,,懂事以后一直仰望思索的事
Dialogue: 0,0:56:03.16,0:56:08.86,Default,,0,0,0,,就是世上人们是从成双成对开始
Dialogue: 0,0:56:08.86,0:56:12.00,Default,,0,0,0,,存在于心中的东西
Dialogue: 0,0:56:12.00,0:56:15.00,Default,,0,0,0,,有一天不再看到的东西
Dialogue: 0,0:56:15.00,0:56:17.97,Default,,0,0,0,,那就是陪在你身边
Dialogue: 0,0:56:17.97,0:56:21.11,Default,,0,0,0,,总是让我想起
Dialogue: 0,0:56:21.11,0:56:24.18,Default,,0,0,0,,存在于你心中的东西
Dialogue: 0,0:56:24.18,0:56:27.18,Default,,0,0,0,,存在于距离中的鼓动
Dialogue: 0,0:56:27.18,0:56:30.12,Default,,0,0,0,,曾经恋上的你
Dialogue: 0,0:56:30.12,0:56:33.12,Default,,0,0,0,,十指交叠 脸庞的香味
Dialogue: 0,0:56:33.12,0:56:36.86,Default,,0,0,0,,超越夫妇
Dialogue: 0,0:56:49.24,0:56:52.34,Default,,0,0,0,,哭泣的脸庞
Dialogue: 0,0:56:52.34,0:56:55.48,Default,,0,0,0,,沉默的夜晚
Dialogue: 0,0:56:55.48,0:56:57.31,Default,,0,0,0,,摇曳的笑容
Dialogue: 0,0:56:57.31,0:57:03.75,Default,,0,0,0,,持续到永远 持续到永远
Dialogue: 0,0:57:03.75,0:57:06.62,Default,,0,0,0,,存在于心中的东西
Dialogue: 0,0:57:06.62,0:57:09.69,Default,,0,0,0,,有一天不再看到的东西
Dialogue: 0,0:57:09.69,0:57:12.73,Default,,0,0,0,,那就是陪在你身边
Dialogue: 0,0:57:12.73,0:57:15.83,Default,,0,0,0,,总是让我想起
Dialogue: 0,0:57:15.83,0:57:18.87,Default,,0,0,0,,存在于你心中的东西
Dialogue: 0,0:57:18.87,0:57:21.87,Default,,0,0,0,,存在于距离中的鼓动
Dialogue: 0,0:57:21.87,0:57:24.77,Default,,0,0,0,,曾经恋上的你
Dialogue: 0,0:57:24.77,0:57:27.84,Default,,0,0,0,,十指交叠 脸庞的香味
Dialogue: 0,0:57:27.84,0:57:30.88,Default,,0,0,0,,超越夫妇
Dialogue: 0,0:57:30.88,0:57:33.88,Default,,0,0,0,,超越两人
Dialogue: 0,0:57:33.88,0:57:36.08,Default,,0,0,0,,超越一人
Dialogue: 0,0:11:05.40,0:11:11.54,Note,,0,0,0,,（303公司）\N（第一次经营负责人会议）
Dialogue: 0,0:18:14.06,0:18:19.06,Note,,0,0,0,,（303公司）\N（第二次经营负责人会议）
Dialogue: 0,0:25:09.34,0:25:12.14,Note,,0,0,0,,（百合）
Dialogue: 0,0:30:10.44,0:30:11.18,Note,,0,0,0,,（303公司）\N（第三次经营负责人会议）
Dialogue: 0,0:40:53.85,0:40:55.75,Note,,0,0,0,,（要不要过来？）
Dialogue: 0,0:40:55.75,0:40:58.52,Note,,0,0,0,,（百合）
