Dialogue: 0,0:00:07.11,0:00:08.11,Japanese,,0,0,0,,あれ？
Dialogue: 0,0:00:08.11,0:00:10.11,Japanese,,0,0,0,,今日も弁当なし？
Dialogue: 0,0:00:10.11,0:00:11.58,Japanese,,0,0,0,,奥さん 怒らせちゃった？
Dialogue: 0,0:00:11.58,0:00:12.61,Japanese,,0,0,0,,俺もある
Dialogue: 0,0:00:12.61,0:00:14.78,Japanese,,0,0,0,,弁当開けたら白米オンリー
Dialogue: 0,0:00:14.78,0:00:16.12,Japanese,,0,0,0,,塩昆布すら入ってないの
Dialogue: 0,0:00:16.12,0:00:19.49,Japanese,,0,0,0,,日野君は何も分かってないな
Dialogue: 0,0:00:19.49,0:00:23.02,Japanese,,0,0,0,,津崎君の今までの弁当の からくりを まるで分かってない
Dialogue: 0,0:00:23.02,0:00:24.59,Japanese,,0,0,0,,からくり？
Dialogue: 0,0:00:24.59,0:00:27.36,Japanese,,0,0,0,,津崎君の弁当は今まで
Dialogue: 0,0:00:27.36,0:00:30.46,Japanese,,0,0,0,,津崎君自身が作っていた
Dialogue: 0,0:00:30.46,0:00:33.81,Japanese,,0,0,0,,バレンタインデーに自ら チョコレートを買って
Dialogue: 0,0:00:33.83,0:00:35.80,Japanese,,0,0,0,,自らの げた箱に入れる
Dialogue: 0,0:00:35.80,0:00:36.80,Japanese,,0,0,0,,あれと同じだ
Dialogue: 0,0:00:36.80,0:00:37.97,Japanese,,0,0,0,,そんなことしない
Dialogue: 0,0:00:37.97,0:00:39.34,Japanese,,0,0,0,,しませんね
Dialogue: 0,0:00:39.34,0:00:43.28,Japanese,,0,0,0,,ともかく これではっきりした
Dialogue: 0,0:00:43.28,0:00:45.44,Japanese,,0,0,0,,みくりさんは……
Dialogue: 0,0:00:46.75,0:00:49.05,Japanese,,0,0,0,,日雇い妻だったんだ
Dialogue: 0,0:00:51.05,0:00:54.55,Japanese,,0,0,0,,俺らが会うときだけ 雇っていたにすぎない
Dialogue: 0,0:00:56.69,0:00:58.06,Japanese,,0,0,0,,沼田さん
Dialogue: 0,0:00:58.06,0:01:00.73,Japanese,,0,0,0,,津崎さんとみくりさんは こう見えてラブラブなんですよ
Dialogue: 0,0:01:00.73,0:01:01.76,Japanese,,0,0,0,,またまた～
Dialogue: 0,0:01:01.76,0:01:03.76,Japanese,,0,0,0,,よくある夫婦げんかだって
Dialogue: 0,0:01:03.76,0:01:05.96,Japanese,,0,0,0,,ねえ？
Dialogue: 0,0:01:05.96,0:01:08.57,Japanese,,0,0,0,,あの夜
Dialogue: 0,0:01:19.58,0:01:22.95,Japanese,,0,0,0,,あれからというもの みくりさんは
Dialogue: 0,0:01:25.58,0:01:29.59,Japanese,,0,0,0,,何もなかったように 接してくれていた
Dialogue: 0,0:01:29.59,0:01:30.66,Japanese,,0,0,0,,行ってらっしゃい
Dialogue: 0,0:01:30.66,0:01:33.06,Japanese,,0,0,0,,行ってきます
Dialogue: 0,0:01:36.20,0:01:40.13,Japanese,,0,0,0,,だけど その夜
Dialogue: 0,0:01:40.13,0:01:45.17,Japanese,,0,0,0,,家に帰ると みくりさんは いなくなっていた。
Dialogue: 0,0:01:45.17,0:01:46.74,Japanese,,0,0,0,,僕もよく知らないんです
Dialogue: 0,0:01:46.74,0:01:50.81,Japanese,,0,0,0,,月曜に家事代行で来たときは 何も言ってなくて
Dialogue: 0,0:01:50.81,0:01:52.68,Japanese,,0,0,0,,百合さんが最後に会ったのは？
Dialogue: 0,0:01:52.68,0:01:53.81,Japanese,,0,0,0,,同じ
Dialogue: 0,0:01:53.81,0:01:57.18,Japanese,,0,0,0,,月曜の夜 あなたのとこの帰りに駅前で
Dialogue: 0,0:01:57.18,0:01:58.82,Japanese,,0,0,0,,みくり
Dialogue: 0,0:01:58.82,0:02:02.49,Japanese,,0,0,0,,もらったアイスワインを 返したいって
Dialogue: 0,0:02:02.49,0:02:05.49,Japanese,,0,0,0,,ごめん これ返す
Dialogue: 0,0:02:06.63,0:02:08.33,Japanese,,0,0,0,,高かったって言ってたし
Dialogue: 0,0:02:08.33,0:02:11.46,Japanese,,0,0,0,,いっぱい残ってるのに 捨てるの忍びなくて
Dialogue: 0,0:02:11.46,0:02:12.83,Japanese,,0,0,0,,口に合わなかった？
Dialogue: 0,0:02:12.83,0:02:14.60,Japanese,,0,0,0,,おいしかった
Dialogue: 0,0:02:14.60,0:02:16.87,Japanese,,0,0,0,,えッ じゃ何で？
Dialogue: 0,0:02:18.17,0:02:21.84,Japanese,,0,0,0,,見てると 死にたくなる
Dialogue: 0,0:02:22.91,0:02:28.28,Japanese,,0,0,0,,ｱｲｽﾜｲﾝに人をそこまで追い詰める 何かがあるとは思えないんだけど
Dialogue: 0,0:02:28.28,0:02:31.48,Japanese,,0,0,0,,津崎さんと 何かあったんでしょうね
Dialogue: 0,0:02:31.48,0:02:33.12,Japanese,,0,0,0,,やっぱり？
Dialogue: 0,0:02:33.12,0:02:35.92,Japanese,,0,0,0,,もし相手が僕なら ﾋﾞｼﾞﾈｽﾗｲｸに徹して
Dialogue: 0,0:02:35.92,0:02:38.92,Japanese,,0,0,0,,うまくいったと思いますが
Dialogue: 0,0:02:38.92,0:02:40.43,Japanese,,0,0,0,,うん？ 何の話？
Dialogue: 0,0:02:40.43,0:02:44.43,Japanese,,0,0,0,,簡単なもんだ 気持ち以外は
Dialogue: 0,0:02:46.03,0:02:51.64,Japanese,,0,0,0,,あなたさ そういう意味深に意味深を 重ねるような話し方やめなさいね
Dialogue: 0,0:02:51.64,0:02:54.87,Japanese,,0,0,0,,気になるなら連絡してみては？
Dialogue: 0,0:03:00.21,0:03:02.22,Japanese,,0,0,0,,みくり？
Dialogue: 0,0:03:04.22,0:03:07.42,Japanese,,0,0,0,,いつ こっちに戻ってくるの？
Dialogue: 0,0:03:07.42,0:03:10.62,Japanese,,0,0,0,,今は 帰れない
Dialogue: 0,0:03:10.62,0:03:12.56,Japanese,,0,0,0,,どうして？
Dialogue: 0,0:03:12.56,0:03:15.46,Japanese,,0,0,0,,離婚危機だから
Dialogue: 0,0:03:15.46,0:03:17.46,Japanese,,0,0,0,,離婚危機！？
Dialogue: 0,0:03:17.46,0:03:19.73,Japanese,,0,0,0,,やっぱり そうなっちゃったの？
Dialogue: 0,0:03:19.73,0:03:22.17,Japanese,,0,0,0,,うん 思いのほか深刻みたいで
Dialogue: 0,0:03:22.17,0:03:23.77,Japanese,,0,0,0,,どうして一緒に洗うの？
Dialogue: 0,0:03:23.77,0:03:27.34,Japanese,,0,0,0,,書いてあるでしょ 色落ち危険って
Dialogue: 0,0:03:27.34,0:03:29.61,Japanese,,0,0,0,,一つ一つ見てたら日が暮れちゃう
Dialogue: 0,0:03:29.61,0:03:33.75,Japanese,,0,0,0,,分かってない人は見るの 見て洗うの そういうものなの
Dialogue: 0,0:03:33.75,0:03:37.18,Japanese,,0,0,0,,これ 高くてお気に入りだったのに
Dialogue: 0,0:03:37.18,0:03:37.85,Japanese,,0,0,0,,みくり？
Dialogue: 0,0:03:37.85,0:03:39.45,Japanese,,0,0,0,,10年間ﾎﾞﾀﾝを取り替えて 大事に着てたの！
Dialogue: 0,0:03:39.45,0:03:42.46,Japanese,,0,0,0,,ごめん あとでメールする
Dialogue: 0,0:03:42.46,0:03:44.62,Japanese,,0,0,0,,お母さん そんな言い方しなくても
Dialogue: 0,0:03:44.62,0:03:46.93,Japanese,,0,0,0,,この人 おとといも同じことしたの
Dialogue: 0,0:03:46.93,0:03:48.23,Japanese,,0,0,0,,うっかりして
Dialogue: 0,0:03:48.23,0:03:50.53,Japanese,,0,0,0,,うっかりもヘチマもない！
Dialogue: 0,0:03:50.53,0:03:52.40,Japanese,,0,0,0,,お母さん
Dialogue: 0,0:04:01.24,0:04:03.98,Japanese,,0,0,0,,気にすることないって
Dialogue: 0,0:04:03.98,0:04:07.68,Japanese,,0,0,0,,お母さん ちょっと イライラしてるだけだよ
Dialogue: 0,0:04:07.68,0:04:09.98,Japanese,,0,0,0,,ちょっと？
Dialogue: 0,0:04:09.98,0:04:12.85,Japanese,,0,0,0,,うん かなりだけど
Dialogue: 0,0:04:12.85,0:04:17.92,Japanese,,0,0,0,,お母さん 体丈夫で今まで ケガ一つしたことなかったから
Dialogue: 0,0:04:17.92,0:04:21.16,Japanese,,0,0,0,,自分でも 戸惑ってるんじゃないかな
Dialogue: 0,0:04:21.16,0:04:24.33,Japanese,,0,0,0,,みくりが来てくれてよかった
Dialogue: 0,0:04:24.33,0:04:28.43,Japanese,,0,0,0,,私こそ 助かったよ
Dialogue: 0,0:04:28.43,0:04:31.00,Japanese,,0,0,0,,あの夜
Dialogue: 0,0:04:33.37,0:04:41.71,Japanese,,0,0,0,,あれからというもの 私は 何もなかったように暮らそうとした
Dialogue: 0,0:04:41.71,0:04:48.42,Japanese,,0,0,0,,でも 何をしていても あの夜の記憶が
Dialogue: 0,0:05:08.07,0:05:12.61,Japanese,,0,0,0,,それでも何とか乗り切ろうと 頑張って妄想した
Dialogue: 0,0:05:12.61,0:05:14.55,Japanese,,0,0,0,,森山 森山...
Dialogue: 0,0:05:14.55,0:05:17.05,Japanese,,0,0,0,,ええ～ 放送席 放送席
Dialogue: 0,0:05:17.05,0:05:19.15,Japanese,,0,0,0,,森山みくり選手です
Dialogue: 0,0:05:19.15,0:05:23.26,Japanese,,0,0,0,,お疲れさまでした お疲れさまでした
Dialogue: 0,0:05:23.26,0:05:27.33,Japanese,,0,0,0,,試合を振り返って いかがですか？
Dialogue: 0,0:05:27.33,0:05:29.10,Japanese,,0,0,0,,やってしまいました
Dialogue: 0,0:05:29.10,0:05:30.83,Japanese,,0,0,0,,痛恨のミスです
Dialogue: 0,0:05:30.83,0:05:32.70,Japanese,,0,0,0,,いいですよ 私は
Dialogue: 0,0:05:32.70,0:05:36.44,Japanese,,0,0,0,,平匡さんとなら
Dialogue: 0,0:05:36.44,0:05:39.50,Japanese,,0,0,0,,そういうことをしても
Dialogue: 0,0:05:49.92,0:05:52.62,Japanese,,0,0,0,,ごめんなさい
Dialogue: 0,0:05:55.02,0:05:57.79,Japanese,,0,0,0,,無理です 僕には
Dialogue: 0,0:05:57.79,0:06:00.13,Japanese,,0,0,0,,あの一言さえ言わなければ
Dialogue: 0,0:06:00.13,0:06:05.46,Japanese,,0,0,0,,いい雰囲気のまま 一日を終われたのに
Dialogue: 0,0:06:05.46,0:06:08.67,Japanese,,0,0,0,,もっと近づきたいと 欲をかいてしまって
Dialogue: 0,0:06:08.67,0:06:13.71,Japanese,,0,0,0,,受け入れられていると 思い込んだ自分が
Dialogue: 0,0:06:13.71,0:06:15.88,Japanese,,0,0,0,,痛い女だなと……
Dialogue: 0,0:06:15.88,0:06:18.04,Japanese,,0,0,0,,頑張れ！ 頑張れ！
Dialogue: 0,0:06:18.04,0:06:20.05,Japanese,,0,0,0,,ごめんなさい
Dialogue: 0,0:06:20.05,0:06:24.75,Japanese,,0,0,0,,では津崎選手に対して 今 どんなお気持ちですか？
Dialogue: 0,0:06:24.75,0:06:28.62,Japanese,,0,0,0,,素晴らしい方で 尊敬もしているので
Dialogue: 0,0:06:28.62,0:06:32.26,Japanese,,0,0,0,,今後は 一定の距離を保って
Dialogue: 0,0:06:32.26,0:06:35.13,Japanese,,0,0,0,,慎重に働いていきたいと思います
Dialogue: 0,0:06:35.13,0:06:38.73,Japanese,,0,0,0,,そうだ！ 頑張れ！
Dialogue: 0,0:06:38.73,0:06:39.60,Japanese,,0,0,0,,ありがとうございました
Dialogue: 0,0:06:39.60,0:06:42.70,Japanese,,0,0,0,,行ける この調子だ。
Dialogue: 0,0:06:45.20,0:06:48.14,Japanese,,0,0,0,,あの夜のことは 面白おかしい出来事として
Dialogue: 0,0:06:48.14,0:06:50.24,Japanese,,0,0,0,,妄想でちゃかし通していけば
Dialogue: 0,0:06:50.24,0:06:51.84,Japanese,,0,0,0,,きっと乗り切れる。
Dialogue: 0,0:06:56.55,0:07:00.02,Japanese,,0,0,0,,だけどハグの日は 容赦なくやってくる。
Dialogue: 0,0:07:01.65,0:07:02.79,Japanese,,0,0,0,,行ってらっしゃい
Dialogue: 0,0:07:02.79,0:07:04.96,Japanese,,0,0,0,,行ってきます
Dialogue: 0,0:07:18.47,0:07:19.91,Japanese,,0,0,0,,遠くへ行きたい
Dialogue: 0,0:07:19.91,0:07:21.04,Japanese,,0,0,0,,どこでも
Dialogue: 0,0:07:21.04,0:07:22.84,Japanese,,0,0,0,,いい遠くへ
Dialogue: 0,0:07:25.11,0:07:26.75,Japanese,,0,0,0,,母さん 骨折したって
Dialogue: 0,0:07:26.75,0:07:28.55,Japanese,,0,0,0,,脚立から落ちて全治２ヵ月
Dialogue: 0,0:07:28.55,0:07:29.75,Japanese,,0,0,0,,大変じゃん
Dialogue: 0,0:07:29.75,0:07:31.05,Japanese,,0,0,0,,家のことは？
Dialogue: 0,0:07:31.05,0:07:32.68,Japanese,,0,0,0,,父さんがやってる
Dialogue: 0,0:07:32.68,0:07:33.75,Japanese,,0,0,0,,足以外はピンピンしてるし
Dialogue: 0,0:07:33.75,0:07:36.59,Japanese,,0,0,0,,心配しなくていいから来るなって
Dialogue: 0,0:07:48.27,0:07:53.14,Japanese,,0,0,0,,バイトも部活も学校も 休んだことがない
Dialogue: 0,0:07:58.84,0:08:02.38,Japanese,,0,0,0,,それだけが自慢だった。
Dialogue: 0,0:08:02.38,0:08:05.32,Japanese,,0,0,0,,生まれて初めての職場放棄
Dialogue: 0,0:08:05.32,0:08:08.65,Japanese,,0,0,0,,せめて準備は半端に
Dialogue: 0,0:08:13.96,0:08:16.20,Japanese,,0,0,0,,平匡さんへ
Dialogue: 0,0:08:16.20,0:08:19.73,Japanese,,0,0,0,,母が骨折してどうしても 帰ってきてくれと言うので
Dialogue: 0,0:08:19.73,0:08:21.97,Japanese,,0,0,0,,館山に行ってきます
Dialogue: 0,0:08:21.97,0:08:24.04,Japanese,,0,0,0,,冷蔵庫に 食事が入れてあります
Dialogue: 0,0:08:25.80,0:08:28.04,Japanese,,0,0,0,,何だってよかった。
Dialogue: 0,0:08:28.04,0:08:31.14,Japanese,,0,0,0,,逃げ出せるのなら
Dialogue: 0,0:08:33.85,0:08:37.48,Japanese,,0,0,0,,火曜日から逃げ出せるのなら
Dialogue: 0,0:08:59.24,0:09:03.68,Japanese,,0,0,0,,惨めな自分を 見なくて済むのなら
Dialogue: 0,0:09:10.78,0:09:14.82,Japanese,,0,0,0,,もう 戻れないかもしれない。
Dialogue: 0,0:09:14.82,0:09:20.29,Japanese,,0,0,0,,それも人生だと もう一人の私がうそぶいていた。
Dialogue: 0,0:10:04.00,0:10:08.31,Japanese,,0,0,0,,こんなに何にも できない人だとは思ってなかった
Dialogue: 0,0:10:08.31,0:10:10.48,Japanese,,0,0,0,,ｷｬﾝﾌﾟで料理してなかったっけ？
Dialogue: 0,0:10:10.48,0:10:13.51,Japanese,,0,0,0,,よくよく考えたら 野菜切ってたの私だし
Dialogue: 0,0:10:13.51,0:10:16.42,Japanese,,0,0,0,,カレー作ってたの私だし
Dialogue: 0,0:10:16.42,0:10:18.35,Japanese,,0,0,0,,お父さん 火おこして 焼いてるだけだった
Dialogue: 0,0:10:18.35,0:10:20.95,Japanese,,0,0,0,,だまされたわ
Dialogue: 0,0:10:20.95,0:10:23.39,Japanese,,0,0,0,,だまされたはないでしょ
Dialogue: 0,0:10:23.39,0:10:25.86,Japanese,,0,0,0,,桜さんが勝手に勘違いしただけで
Dialogue: 0,0:10:25.86,0:10:28.66,Japanese,,0,0,0,,もっと家事やらせとくんだった
Dialogue: 0,0:10:28.66,0:10:31.03,Japanese,,0,0,0,,少しは手伝ってたよね？
Dialogue: 0,0:10:31.03,0:10:33.60,Japanese,,0,0,0,,ゴミ出しはしてた
Dialogue: 0,0:10:35.10,0:10:37.30,Japanese,,0,0,0,,ゴミ出しは家事とは言わないよ
Dialogue: 0,0:10:37.30,0:10:38.30,Japanese,,0,0,0,,風呂掃除もした
Dialogue: 0,0:10:38.30,0:10:39.07,Japanese,,0,0,0,,どれぐらい？
Dialogue: 0,0:10:39.07,0:10:41.81,Japanese,,0,0,0,,月２回 だったかな
Dialogue: 0,0:10:45.04,0:10:49.15,Japanese,,0,0,0,,たまの風呂掃除で ドヤ顔されてもね
Dialogue: 0,0:10:49.15,0:10:50.98,Japanese,,0,0,0,,葵ちゃん
Dialogue: 0,0:10:50.98,0:10:53.65,Japanese,,0,0,0,,すいません つい ちがやさんを思い出して
Dialogue: 0,0:10:53.65,0:10:55.89,Japanese,,0,0,0,,梢ちゃん
Dialogue: 0,0:10:55.89,0:10:58.06,Japanese,,0,0,0,,ジイジだよ
Dialogue: 0,0:10:58.06,0:10:59.62,Japanese,,0,0,0,,おいで 庭からすいません
Dialogue: 0,0:10:59.62,0:11:01.63,Japanese,,0,0,0,,この子が入っちゃって
Dialogue: 0,0:11:01.63,0:11:03.26,Japanese,,0,0,0,,お義母さん 足大丈夫ですか？
Dialogue: 0,0:11:03.26,0:11:04.60,Japanese,,0,0,0,,大丈夫 大丈夫
Dialogue: 0,0:11:04.60,0:11:06.13,Japanese,,0,0,0,,ねえ お兄ちゃん何もしないの？
Dialogue: 0,0:11:06.13,0:11:07.57,Japanese,,0,0,0,,しないしない
Dialogue: 0,0:11:07.57,0:11:10.37,Japanese,,0,0,0,,家に帰ったら ｢疲れた～ 肩もんで～｣って
Dialogue: 0,0:11:10.37,0:11:12.60,Japanese,,0,0,0,,こっちが もんでほしいわよね
Dialogue: 0,0:11:12.60,0:11:16.84,Japanese,,0,0,0,,まあ 今はまだいいんですけど 私 来月から職場復帰するんです
Dialogue: 0,0:11:16.84,0:11:18.44,Japanese,,0,0,0,,保育園 見つかったんだ
Dialogue: 0,0:11:18.44,0:11:19.88,Japanese,,0,0,0,,ようやく
Dialogue: 0,0:11:19.88,0:11:23.95,Japanese,,0,0,0,,でも仕事して 梢の世話して
Dialogue: 0,0:11:23.95,0:11:27.02,Japanese,,0,0,0,,ちがやさんの面倒まで見るのは 自信なくて
Dialogue: 0,0:11:27.02,0:11:29.36,Japanese,,0,0,0,,育て方が悪くてごめんね～
Dialogue: 0,0:11:29.36,0:11:30.62,Japanese,,0,0,0,,そういうつもりじゃ……
Dialogue: 0,0:11:30.62,0:11:34.46,Japanese,,0,0,0,,私は専業主婦だったし 家事が 趣味みたいなところがあって
Dialogue: 0,0:11:34.46,0:11:36.20,Japanese,,0,0,0,,やりすぎてたのかも
Dialogue: 0,0:11:36.20,0:11:37.76,Japanese,,0,0,0,,私は やらされてたよ
Dialogue: 0,0:11:37.76,0:11:40.63,Japanese,,0,0,0,,みくりは自分から お母さんのお手伝いしますって
Dialogue: 0,0:11:40.63,0:11:42.64,Japanese,,0,0,0,,-そうだっけ？ -そうよ
Dialogue: 0,0:11:44.40,0:11:46.60,Japanese,,0,0,0,,洗濯終わったー
Dialogue: 0,0:11:46.60,0:11:47.24,Japanese,,0,0,0,,-手伝うよ -手伝います
Dialogue: 0,0:11:47.24,0:11:50.74,Japanese,,0,0,0,,ダメ お父さんの仕事
Dialogue: 0,0:11:51.88,0:11:54.31,Japanese,,0,0,0,,お父さんが やりまーす
Dialogue: 0,0:11:55.61,0:11:57.78,Japanese,,0,0,0,,シワ伸びてない
Dialogue: 0,0:11:57.78,0:11:59.82,Japanese,,0,0,0,,パンパン！ して
Dialogue: 0,0:11:59.84,0:12:01.32,Japanese,,0,0,0,,パンパン
Dialogue: 0,0:12:02.15,0:12:05.52,Japanese,,0,0,0,,平匡さんはどうなの？ 家事
Dialogue: 0,0:12:05.52,0:12:08.86,Japanese,,0,0,0,,うちは わりと手伝ってくれるかな
Dialogue: 0,0:12:08.86,0:12:11.60,Japanese,,0,0,0,,いいな～
Dialogue: 0,0:12:11.60,0:12:14.70,Japanese,,0,0,0,,お給料をもらって家事をしている だなんて
Dialogue: 0,0:12:14.70,0:12:18.87,Japanese,,0,0,0,,無料奉仕をしている 人達の前で言えない。
Dialogue: 0,0:12:21.31,0:12:23.51,Japanese,,0,0,0,,また一人減るんですか？
Dialogue: 0,0:12:23.51,0:12:24.91,Japanese,,0,0,0,,うん 産休に入るんだって
Dialogue: 0,0:12:24.91,0:12:26.11,Japanese,,0,0,0,,最悪
Dialogue: 0,0:12:26.11,0:12:27.78,Japanese,,0,0,0,,ぶっちゃけ迷惑
Dialogue: 0,0:12:27.78,0:12:29.12,Japanese,,0,0,0,,そういうこと言わないの
Dialogue: 0,0:12:29.12,0:12:30.95,Japanese,,0,0,0,,土屋さんだって仕事増えるでしょ
Dialogue: 0,0:12:30.95,0:12:32.68,Japanese,,0,0,0,,ムカつきませんか？
Dialogue: 0,0:12:32.68,0:12:36.16,Japanese,,0,0,0,,悪いけど もうそんな次元にいない
Dialogue: 0,0:12:38.36,0:12:40.29,Japanese,,0,0,0,,感謝
Dialogue: 0,0:12:41.33,0:12:43.60,Japanese,,0,0,0,,感謝？
Dialogue: 0,0:12:43.60,0:12:46.93,Japanese,,0,0,0,,私の分まで産んでくれて ありがとう
Dialogue: 0,0:12:46.93,0:12:48.93,Japanese,,0,0,0,,そういうもんすか？
Dialogue: 0,0:12:48.93,0:12:52.07,Japanese,,0,0,0,,この年になるとね もう嫉妬なんて通り越してる
Dialogue: 0,0:12:52.07,0:12:53.84,Japanese,,0,0,0,,でも 言われますよね
Dialogue: 0,0:12:53.84,0:12:56.48,Japanese,,0,0,0,,女に生まれたからには どうのこうの
Dialogue: 0,0:12:56.48,0:12:58.41,Japanese,,0,0,0,,気にしなきゃいいのよ
Dialogue: 0,0:12:58.41,0:13:00.61,Japanese,,0,0,0,,だって その分働いてるもの
Dialogue: 0,0:13:00.61,0:13:02.41,Japanese,,0,0,0,,税金 納めてるもの
Dialogue: 0,0:13:02.41,0:13:05.42,Japanese,,0,0,0,,だからね あなた達もブーブー言わないの
Dialogue: 0,0:13:05.42,0:13:09.05,Japanese,,0,0,0,,今どき 産休に理解のある 会社のがいいでしょ
Dialogue: 0,0:13:09.05,0:13:13.53,Japanese,,0,0,0,,それにね 福利厚生があるって いうことは まだ安泰ってことよ
Dialogue: 0,0:13:13.53,0:13:16.93,Japanese,,0,0,0,,社長 本当のところ どうなんですか？
Dialogue: 0,0:13:16.93,0:13:19.43,Japanese,,0,0,0,,うちの会社 大丈夫なんですか？
Dialogue: 0,0:13:19.43,0:13:21.77,Japanese,,0,0,0,,これから 何で沼田さんが知ってんの？
Dialogue: 0,0:13:21.77,0:13:24.94,Japanese,,0,0,0,,すいません 僕が挙動不審だったみたいで
Dialogue: 0,0:13:24.94,0:13:27.11,Japanese,,0,0,0,,怪しまれて 後をつけられて
Dialogue: 0,0:13:27.11,0:13:31.01,Japanese,,0,0,0,,サーバーを全部落とすって 脅されたら逆らえません
Dialogue: 0,0:13:31.01,0:13:32.28,Japanese,,0,0,0,,クソッ
Dialogue: 0,0:13:32.28,0:13:33.28,Japanese,,0,0,0,,インフラエンジニアめ
Dialogue: 0,0:13:33.28,0:13:35.92,Japanese,,0,0,0,,この会社の命綱は俺が握っている
Dialogue: 0,0:13:35.92,0:13:39.32,Japanese,,0,0,0,,沼田さんって昔 国のｲﾝﾌﾗ守ってたんですよね？
Dialogue: 0,0:13:39.32,0:13:41.82,Japanese,,0,0,0,,ハードな仕事だった
Dialogue: 0,0:13:41.82,0:13:45.49,Japanese,,0,0,0,,給料は今の倍 ストレスは５倍
Dialogue: 0,0:13:46.93,0:13:48.53,Japanese,,0,0,0,,大変だったよな あの頃は
Dialogue: 0,0:13:48.53,0:13:51.46,Japanese,,0,0,0,,今も大変なんじゃないの？ どうなのよ
Dialogue: 0,0:13:51.46,0:13:55.97,Japanese,,0,0,0,,単にさ お得意先のＭ社が 買収されるかもってだけ
Dialogue: 0,0:13:55.97,0:13:59.14,Japanese,,0,0,0,,もしそうなって うちとの取引が切られたら
Dialogue: 0,0:13:59.14,0:14:02.27,Japanese,,0,0,0,,うちの売り上げの ４割がなくなります
Dialogue: 0,0:14:02.27,0:14:03.88,Japanese,,0,0,0,,まあね
Dialogue: 0,0:14:03.88,0:14:05.34,Japanese,,0,0,0,,軽いな
Dialogue: 0,0:14:05.34,0:14:06.85,Japanese,,0,0,0,,何とかなるって
Dialogue: 0,0:14:06.85,0:14:09.32,Japanese,,0,0,0,,ﾔﾊﾞかったら ﾘｽﾄﾗくらいはすると思うけど
Dialogue: 0,0:14:09.32,0:14:11.18,Japanese,,0,0,0,,くらい？
Dialogue: 0,0:14:11.18,0:14:14.19,Japanese,,0,0,0,,今すぐサーバー 破壊するぞ この社長様！
Dialogue: 0,0:14:14.19,0:14:16.69,Japanese,,0,0,0,,まだ決定したわけじゃないし
Dialogue: 0,0:14:16.69,0:14:19.06,Japanese,,0,0,0,,みんなを動揺させるとまずいから
Dialogue: 0,0:14:19.06,0:14:20.43,Japanese,,0,0,0,,このことは内密に
Dialogue: 0,0:14:20.43,0:14:21.93,Japanese,,0,0,0,,内密って言われても
Dialogue: 0,0:14:21.93,0:14:25.46,Japanese,,0,0,0,,社内で株やってるやつも多いだろ
Dialogue: 0,0:14:25.46,0:14:30.27,Japanese,,0,0,0,,ｲﾝｻｲﾀﾞｰであげられでもしたら 責任取れる？
Dialogue: 0,0:14:30.27,0:14:32.10,Japanese,,0,0,0,,お口チャック
Dialogue: 0,0:14:32.10,0:14:34.37,Japanese,,0,0,0,,社長命令
Dialogue: 0,0:14:41.41,0:14:42.92,Japanese,,0,0,0,,何してんの？
Dialogue: 0,0:14:42.92,0:14:44.92,Japanese,,0,0,0,,ﾊﾟﾆｰﾆ食べないの？
Dialogue: 0,0:14:44.92,0:14:46.55,Japanese,,0,0,0,,沼田さん
Dialogue: 0,0:14:46.55,0:14:48.25,Japanese,,0,0,0,,頼綱
Dialogue: 0,0:14:49.46,0:14:51.79,Japanese,,0,0,0,,放っといてくれないか
Dialogue: 0,0:14:56.66,0:14:58.90,Japanese,,0,0,0,,津崎さん？
Dialogue: 0,0:15:15.25,0:15:17.72,Japanese,,0,0,0,,｢隣の松本さんちのお孫さん！｣
Dialogue: 0,0:15:17.72,0:15:20.35,Japanese,,0,0,0,,｢うちの孫は いつじゃろね～？｣
Dialogue: 0,0:15:20.35,0:15:23.19,Japanese,,0,0,0,,母さん ごめんなさい。
Dialogue: 0,0:15:23.19,0:15:26.52,Japanese,,0,0,0,,あなたの息子は 子供を作るどころか
Dialogue: 0,0:15:26.52,0:15:29.86,Japanese,,0,0,0,,スタートラインにすら 立てていません。
Dialogue: 0,0:15:29.86,0:15:34.27,Japanese,,0,0,0,,ハグをして キスをするまでがやっと
Dialogue: 0,0:15:34.27,0:15:38.30,Japanese,,0,0,0,,１０歳も年下のみくりさんに ついていけてない
Dialogue: 0,0:15:38.30,0:15:42.01,Japanese,,0,0,0,,進むべきじゃなかった あそこから
Dialogue: 0,0:15:42.01,0:15:43.94,Japanese,,0,0,0,,平匡さんに何かあったら
Dialogue: 0,0:15:43.94,0:15:47.35,Japanese,,0,0,0,,私は 平匡さんの味方です
Dialogue: 0,0:15:47.35,0:15:51.42,Japanese,,0,0,0,,あのまま ずっと いられたら
Dialogue: 0,0:15:51.42,0:15:53.18,Japanese,,0,0,0,,みくりさん
Dialogue: 0,0:15:53.18,0:15:57.56,Japanese,,0,0,0,,みくりさんのように 妄想で気を紛らわせたいけれど
Dialogue: 0,0:15:58.92,0:16:03.03,Japanese,,0,0,0,,そんなイマジネーション 僕は持ち合わせていません。
Dialogue: 0,0:16:14.07,0:16:17.34,Japanese,,0,0,0,,平和だ
Dialogue: 0,0:16:17.34,0:16:20.98,Japanese,,0,0,0,,だが この辺りに仕事はない
Dialogue: 0,0:16:20.98,0:16:23.75,Japanese,,0,0,0,,このまま ここで暮らす
Dialogue: 0,0:16:23.75,0:16:26.05,Japanese,,0,0,0,,もし そうなったら
Dialogue: 0,0:16:36.80,0:16:38.86,Japanese,,0,0,0,,そうですね
Dialogue: 0,0:16:38.86,0:16:42.20,Japanese,,0,0,0,,もう半年かな 外 出てません
Dialogue: 0,0:16:47.11,0:16:48.91,Japanese,,0,0,0,,ハッピーですよ
Dialogue: 0,0:16:48.91,0:16:52.38,Japanese,,0,0,0,,三食昼寝付きでゲーム三昧
Dialogue: 0,0:16:52.38,0:16:55.11,Japanese,,0,0,0,,毎日 充実してます
Dialogue: 0,0:16:57.92,0:16:59.58,Japanese,,0,0,0,,仕事だ
Dialogue: 0,0:17:02.25,0:17:04.72,Japanese,,0,0,0,,仕事は探さねば
Dialogue: 0,0:17:19.17,0:17:21.31,Japanese,,0,0,0,,この手があったか
Dialogue: 0,0:17:31.65,0:17:33.22,Japanese,,0,0,0,,野口まゆさん！
Dialogue: 0,0:17:33.22,0:17:34.99,Japanese,,0,0,0,,はッ はい
Dialogue: 0,0:17:34.99,0:17:37.22,Japanese,,0,0,0,,お会いしたかったです
Dialogue: 0,0:17:38.46,0:17:39.66,Japanese,,0,0,0,,どうも……
Dialogue: 0,0:17:39.66,0:17:41.49,Japanese,,0,0,0,,はじめまして
Dialogue: 0,0:17:43.93,0:17:45.03,Japanese,,0,0,0,,これで全部
Dialogue: 0,0:17:48.23,0:17:49.30,Japanese,,0,0,0,,蝶ちゃんは？
Dialogue: 0,0:17:49.30,0:17:50.70,Japanese,,0,0,0,,ばあちゃんが見てくれてる
Dialogue: 0,0:17:50.70,0:17:52.54,Japanese,,0,0,0,,立派なレンコン
Dialogue: 0,0:17:52.54,0:17:53.54,Japanese,,0,0,0,,でしょう？
Dialogue: 0,0:17:53.54,0:17:55.57,Japanese,,0,0,0,,筑前煮 食べたい
Dialogue: 0,0:17:55.57,0:17:56.51,Japanese,,0,0,0,,筑前煮？
Dialogue: 0,0:17:56.51,0:17:59.08,Japanese,,0,0,0,,もっと簡単なのじゃダメ？
Dialogue: 0,0:18:00.45,0:18:02.01,Japanese,,0,0,0,,やっさん
Dialogue: 0,0:18:02.01,0:18:02.68,Japanese,,0,0,0,,よッ
Dialogue: 0,0:18:02.68,0:18:04.12,Japanese,,0,0,0,,ﾎﾝﾄに来るとはね
Dialogue: 0,0:18:04.12,0:18:06.32,Japanese,,0,0,0,,来たら野菜ｼﾞｬﾑ教えるって言った
Dialogue: 0,0:18:06.32,0:18:07.55,Japanese,,0,0,0,,来ないと思った
Dialogue: 0,0:18:07.55,0:18:09.82,Japanese,,0,0,0,,私の機動力なめんなよ
Dialogue: 0,0:18:12.52,0:18:15.09,Japanese,,0,0,0,,契約結婚のことは内緒だからね
Dialogue: 0,0:18:15.09,0:18:16.73,Japanese,,0,0,0,,分かった
Dialogue: 0,0:18:17.66,0:18:19.20,Japanese,,0,0,0,,人 多くない？
Dialogue: 0,0:18:19.20,0:18:20.70,Japanese,,0,0,0,,ちがや 早かったじゃない
Dialogue: 0,0:18:20.70,0:18:22.27,Japanese,,0,0,0,,何で みくりがいんだよ
Dialogue: 0,0:18:22.27,0:18:23.47,Japanese,,0,0,0,,いいでしょ
Dialogue: 0,0:18:23.47,0:18:25.87,Japanese,,0,0,0,,どうも～
Dialogue: 0,0:18:25.87,0:18:27.07,Japanese,,0,0,0,,あッ 何だっけ
Dialogue: 0,0:18:27.07,0:18:28.11,Japanese,,0,0,0,,ヤンキーの やっさん
Dialogue: 0,0:18:28.11,0:18:29.74,Japanese,,0,0,0,,安恵だから やっさん
Dialogue: 0,0:18:29.74,0:18:31.61,Japanese,,0,0,0,,別に似たようなもんじゃん
Dialogue: 0,0:18:31.61,0:18:33.88,Japanese,,0,0,0,,母さん 足どうよ？
Dialogue: 0,0:18:33.88,0:18:35.95,Japanese,,0,0,0,,兄貴 全然変わんないね
Dialogue: 0,0:18:35.95,0:18:38.55,Japanese,,0,0,0,,壁ドンしてもいいよ 次 何か言ったらね
Dialogue: 0,0:18:38.55,0:18:39.58,Japanese,,0,0,0,,壁ドン？
Dialogue: 0,0:18:39.58,0:18:41.12,Japanese,,0,0,0,,ときめかない方
Dialogue: 0,0:18:41.12,0:18:43.79,Japanese,,0,0,0,,こういうね ドーンってやつ
Dialogue: 0,0:18:43.79,0:18:44.72,Japanese,,0,0,0,,ドン？
Dialogue: 0,0:18:44.72,0:18:46.62,Japanese,,0,0,0,,津崎君 呼ぼう
Dialogue: 0,0:18:46.62,0:18:47.76,Japanese,,0,0,0,,明日 休みだし
Dialogue: 0,0:18:47.76,0:18:49.23,Japanese,,0,0,0,,平匡さんにも予定があるし
Dialogue: 0,0:18:49.23,0:18:51.73,Japanese,,0,0,0,,電車でピューッて来たら ピューッだよ
Dialogue: 0,0:18:51.73,0:18:53.76,Japanese,,0,0,0,,擬音でごまかしても そんなに近くない
Dialogue: 0,0:18:53.76,0:18:56.14,Japanese,,0,0,0,,電話で聞くだけならタダじゃない
Dialogue: 0,0:18:56.14,0:18:57.94,Japanese,,0,0,0,,そうしよう
Dialogue: 0,0:18:57.94,0:19:00.24,Japanese,,0,0,0,,電話代がかかる タダじゃない
Dialogue: 0,0:19:00.24,0:19:01.64,Japanese,,0,0,0,,そういう意味じゃないわよ
Dialogue: 0,0:19:01.64,0:19:02.81,Japanese,,0,0,0,,ダメ 絶対
Dialogue: 0,0:19:02.81,0:19:06.74,Japanese,,0,0,0,,電話の乱用禁止 ダメったらダメ
Dialogue: 0,0:19:06.74,0:19:09.38,Japanese,,0,0,0,,まあ そこまで言うなら
Dialogue: 0,0:19:09.38,0:19:11.98,Japanese,,0,0,0,,旦那とケンカしてんの？
Dialogue: 0,0:19:13.82,0:19:15.32,Japanese,,0,0,0,,それで家出
Dialogue: 0,0:19:15.32,0:19:18.06,Japanese,,0,0,0,,何だ そっかそっか
Dialogue: 0,0:19:18.06,0:19:21.73,Japanese,,0,0,0,,どうせまた 小生意気なこと 言ったんだろ
Dialogue: 0,0:19:21.73,0:19:23.73,Japanese,,0,0,0,,もっと 優しくさ
Dialogue: 0,0:19:23.73,0:19:27.27,Japanese,,0,0,0,,疲れた旦那を立てないと
Dialogue: 0,0:19:27.27,0:19:28.43,Japanese,,0,0,0,,みくり
Dialogue: 0,0:19:28.43,0:19:30.27,Japanese,,0,0,0,,お願い
Dialogue: 0,0:19:34.71,0:19:37.21,Japanese,,0,0,0,,いい加減に
Dialogue: 0,0:19:37.21,0:19:39.74,Japanese,,0,0,0,,しなさーい！
Dialogue: 0,0:19:46.22,0:19:48.85,Japanese,,0,0,0,,何で俺がこんなこと……
Dialogue: 0,0:19:48.85,0:19:52.26,Japanese,,0,0,0,,どうして お前は こう育っちゃったんだろうね
Dialogue: 0,0:19:53.52,0:19:55.53,Japanese,,0,0,0,,えッ？ 俺幸せだよ
Dialogue: 0,0:19:55.53,0:19:58.00,Japanese,,0,0,0,,周りの人も幸せにできたらいいね
Dialogue: 0,0:19:58.00,0:20:03.44,Japanese,,0,0,0,,自分が幸せじゃないと 人を幸せにできないよ
Dialogue: 0,0:20:03.44,0:20:06.87,Japanese,,0,0,0,,お前 いいこと言うね
Dialogue: 0,0:20:06.87,0:20:08.41,Japanese,,0,0,0,,父さんの息子ですから
Dialogue: 0,0:20:08.41,0:20:10.24,Japanese,,0,0,0,,だからか
Dialogue: 0,0:20:13.71,0:20:16.22,Japanese,,0,0,0,,ジャムでも 塩もみするんですね
Dialogue: 0,0:20:16.22,0:20:21.05,Japanese,,0,0,0,,あとカボチャは 種つきのまま蒸すのが鉄則ね
Dialogue: 0,0:20:21.05,0:20:24.66,Japanese,,0,0,0,,コクがあって おいしいジャムになるのよ～
Dialogue: 0,0:20:26.19,0:20:28.09,Japanese,,0,0,0,,-はい -ありがとう
Dialogue: 0,0:20:28.09,0:20:31.20,Japanese,,0,0,0,,向こう 男同士褒め合ってて 気持ち悪かった
Dialogue: 0,0:20:32.43,0:20:35.80,Japanese,,0,0,0,,うちはお父さんもお兄ちゃんも 自己肯定感が強いよね
Dialogue: 0,0:20:35.80,0:20:38.40,Japanese,,0,0,0,,みくりも子供の頃は そうだったじゃない
Dialogue: 0,0:20:38.40,0:20:41.67,Japanese,,0,0,0,,私は学校や社会で 折られまくったもん
Dialogue: 0,0:20:41.67,0:20:43.41,Japanese,,0,0,0,,普通そうじゃない？
Dialogue: 0,0:20:43.41,0:20:46.81,Japanese,,0,0,0,,ちがやさんが奇跡的に 折られないまま来ただけで
Dialogue: 0,0:20:46.81,0:20:48.51,Japanese,,0,0,0,,それ 幸せといえば幸せだよね
Dialogue: 0,0:20:48.51,0:20:51.75,Japanese,,0,0,0,,私は蝶に 大ケガはさせたくないけど
Dialogue: 0,0:20:51.75,0:20:53.78,Japanese,,0,0,0,,擦り傷くらいはさせたいかな
Dialogue: 0,0:20:53.78,0:20:56.59,Japanese,,0,0,0,,経験値としては あったほうがいいかもね
Dialogue: 0,0:20:56.59,0:20:58.76,Japanese,,0,0,0,,程度問題ですけどね
Dialogue: 0,0:20:58.76,0:21:01.73,Japanese,,0,0,0,,擦り傷程度の浅い傷
Dialogue: 0,0:21:01.73,0:21:06.40,Japanese,,0,0,0,,だとしても 何度も何度も傷を受ければ
Dialogue: 0,0:21:06.40,0:21:09.53,Japanese,,0,0,0,,深刻なダメージになる
Dialogue: 0,0:21:09.53,0:21:12.74,Japanese,,0,0,0,,くたびれてしまった。
Dialogue: 0,0:21:12.74,0:21:14.17,Japanese,,0,0,0,,僕には関係ありません
Dialogue: 0,0:21:14.17,0:21:18.04,Japanese,,0,0,0,,自尊感情の低いあの人を 好きでいることに
Dialogue: 0,0:21:18.04,0:21:22.25,Japanese,,0,0,0,,詮索するのも分析するのも やめてください
Dialogue: 0,0:21:22.25,0:21:29.35,Japanese,,0,0,0,,拒絶されても平気なふりで 笑い続けることに
Dialogue: 0,0:21:29.35,0:21:35.26,Japanese,,0,0,0,,だからね 市議会議員に立候補する っていう手もあるかなと思って
Dialogue: 0,0:21:35.26,0:21:36.50,Japanese,,0,0,0,,はッ？
Dialogue: 0,0:21:36.50,0:21:37.56,Japanese,,0,0,0,,へえ～ いいじゃない
Dialogue: 0,0:21:37.56,0:21:40.63,Japanese,,0,0,0,,今の｢だからね｣は どこから続いてたの？
Dialogue: 0,0:21:40.63,0:21:42.47,Japanese,,0,0,0,,さっき聞いたの 野口まゆさんに
Dialogue: 0,0:21:42.47,0:21:43.37,Japanese,,0,0,0,,誰？
Dialogue: 0,0:21:43.37,0:21:45.27,Japanese,,0,0,0,,同い年の市議会議員
Dialogue: 0,0:21:45.27,0:21:47.10,Japanese,,0,0,0,,情熱にあふれた大陸な人だった
Dialogue: 0,0:21:47.10,0:21:48.94,Japanese,,0,0,0,,そんな簡単になれるの？
Dialogue: 0,0:21:48.94,0:21:51.04,Japanese,,0,0,0,,選挙演説の妄想ならしたことある
Dialogue: 0,0:21:51.04,0:21:52.44,Japanese,,0,0,0,,ｲﾒﾄﾚは ﾊﾞｯﾁﾘね
Dialogue: 0,0:21:52.44,0:21:54.23,Japanese,,0,0,0,,世のため人のためになりながら
Dialogue: 0,0:21:54.26,0:21:57.35,Japanese,,0,0,0,,お給料がもらえるって 素晴らしいと思わない？
Dialogue: 0,0:21:57.35,0:21:58.22,Japanese,,0,0,0,,はい
Dialogue: 0,0:21:58.22,0:22:00.69,Japanese,,0,0,0,,議員候補のみくりさんに 質問です
Dialogue: 0,0:22:00.69,0:22:04.49,Japanese,,0,0,0,,働く女性の育児について どうお考えでしょう？
Dialogue: 0,0:22:04.49,0:22:06.09,Japanese,,0,0,0,,生討論しちゃう？
Dialogue: 0,0:22:06.09,0:22:06.86,Japanese,,0,0,0,,はあ？
Dialogue: 0,0:22:06.86,0:22:08.93,Japanese,,0,0,0,,私 田原さんやる
Dialogue: 0,0:22:19.97,0:22:20.71,Japanese,,0,0,0,,こんばんは
Dialogue: 0,0:22:20.71,0:22:23.71,Japanese,,0,0,0,,本日の議題は 働く女性の育児問題です
Dialogue: 0,0:22:23.71,0:22:26.31,Japanese,,0,0,0,,今の世間の要求は 無謀ですよ
Dialogue: 0,0:22:26.31,0:22:28.25,Japanese,,0,0,0,,働けよ 産めよ 育てよ
Dialogue: 0,0:22:28.25,0:22:30.35,Japanese,,0,0,0,,女として美しくあれって
Dialogue: 0,0:22:30.35,0:22:31.85,Japanese,,0,0,0,,体がいくつあっても足りません
Dialogue: 0,0:22:31.85,0:22:34.39,Japanese,,0,0,0,,しかし女性が産まないと 少子化は進むわけです
Dialogue: 0,0:22:34.39,0:22:36.89,Japanese,,0,0,0,,一方で働きたい女性もいる
Dialogue: 0,0:22:36.89,0:22:41.19,Japanese,,0,0,0,,いっそのこと みんな 高校生のうちに出産しては？
Dialogue: 0,0:22:41.19,0:22:42.09,Japanese,,0,0,0,,はッ？
Dialogue: 0,0:22:42.09,0:22:43.73,Japanese,,0,0,0,,働きながら育てるより
Dialogue: 0,0:22:43.73,0:22:46.63,Japanese,,0,0,0,,学生時代のほうが 育てやすいと思うんです
Dialogue: 0,0:22:46.63,0:22:50.97,Japanese,,0,0,0,,高校の空き教室に託児所を作って 授業中は預けておく
Dialogue: 0,0:22:50.97,0:22:53.84,Japanese,,0,0,0,,で 休み時間に授乳しにいく
Dialogue: 0,0:22:53.84,0:22:55.51,Japanese,,0,0,0,,出産で休学しても
Dialogue: 0,0:22:55.51,0:22:59.54,Japanese,,0,0,0,,夏休みに補習を受ければ 授業に追いつけます
Dialogue: 0,0:22:59.54,0:23:02.58,Japanese,,0,0,0,,家庭科の授業でベビー服や 離乳食を作ったりしてね
Dialogue: 0,0:23:02.58,0:23:03.42,Japanese,,0,0,0,,ええ
Dialogue: 0,0:23:03.42,0:23:06.88,Japanese,,0,0,0,,そうやって 学校全体で子育てをしていけば
Dialogue: 0,0:23:06.88,0:23:08.69,Japanese,,0,0,0,,-みくりちゃん -はい
Dialogue: 0,0:23:08.69,0:23:10.72,Japanese,,0,0,0,,発想としては面白いけど
Dialogue: 0,0:23:10.72,0:23:14.71,Japanese,,0,0,0,,高校生育児制度を掲げて 立候補しても
Dialogue: 0,0:23:14.74,0:23:16.76,Japanese,,0,0,0,,まず当選できないと思う
Dialogue: 0,0:23:16.76,0:23:17.80,Japanese,,0,0,0,,やっぱり？
Dialogue: 0,0:23:17.80,0:23:19.90,Japanese,,0,0,0,,高校くらい青春したいな～
Dialogue: 0,0:23:19.90,0:23:22.17,Japanese,,0,0,0,,じゃあ いつ産めばいいんだろう？
Dialogue: 0,0:23:22.17,0:23:25.40,Japanese,,0,0,0,,育児しながら社会参加する タイミングって難しくない？
Dialogue: 0,0:23:25.40,0:23:28.01,Japanese,,0,0,0,,協力し合うしか ないんじゃないかな
Dialogue: 0,0:23:28.01,0:23:30.71,Japanese,,0,0,0,,夫婦や 社会や 周囲の人間が
Dialogue: 0,0:23:30.71,0:23:32.71,Japanese,,0,0,0,,そこが うまくいかないんですけどね
Dialogue: 0,0:23:32.71,0:23:36.88,Japanese,,0,0,0,,男もさ 子供産めるように なればいいんだよ
Dialogue: 0,0:23:36.88,0:23:37.65,Japanese,,0,0,0,,いいんじゃない
Dialogue: 0,0:23:37.65,0:23:39.48,Japanese,,0,0,0,,夫と妻で交代に産んだりして
Dialogue: 0,0:23:39.48,0:23:41.99,Japanese,,0,0,0,,選ぶ余地があれば お互いに気を使えそう
Dialogue: 0,0:23:41.99,0:23:44.86,Japanese,,0,0,0,,しまった 科学者の道に 進むべきだった
Dialogue: 0,0:23:44.86,0:23:48.09,Japanese,,0,0,0,,気色悪いこと言ってんな
Dialogue: 0,0:23:48.09,0:23:50.70,Japanese,,0,0,0,,俺も産みたい
Dialogue: 0,0:23:54.17,0:23:56.23,Japanese,,0,0,0,,乾杯！
Dialogue: 0,0:23:58.77,0:24:00.10,Japanese,,0,0,0,,最高！
Dialogue: 0,0:24:00.10,0:24:02.54,Japanese,,0,0,0,,生ビール最高
Dialogue: 0,0:24:02.54,0:24:03.58,Japanese,,0,0,0,,沼田さん
Dialogue: 0,0:24:03.58,0:24:05.58,Japanese,,0,0,0,,オープン お口オープン
Dialogue: 0,0:24:05.58,0:24:07.31,Japanese,,0,0,0,,開いても何もしゃべらないからな
Dialogue: 0,0:24:07.31,0:24:09.78,Japanese,,0,0,0,,しゃべりたいことでも あるんですか？
Dialogue: 0,0:24:09.78,0:24:12.12,Japanese,,0,0,0,,何？ 何？ 何頼む？ 何頼む？
Dialogue: 0,0:24:12.12,0:24:14.02,Japanese,,0,0,0,,え～ これ
Dialogue: 0,0:24:14.02,0:24:15.35,Japanese,,0,0,0,,軟骨の唐揚げ食べたい
Dialogue: 0,0:24:15.35,0:24:16.79,Japanese,,0,0,0,,ｺﾘｺﾘしたい ｺﾘｺﾘｺﾘｺﾘ……
Dialogue: 0,0:24:16.79,0:24:17.52,Japanese,,0,0,0,,日野君
Dialogue: 0,0:24:17.52,0:24:18.72,Japanese,,0,0,0,,一旦落ち着こう
Dialogue: 0,0:24:18.72,0:24:19.86,Japanese,,0,0,0,,たかが居酒屋だ
Dialogue: 0,0:24:19.86,0:24:21.06,Japanese,,0,0,0,,ﾒｯﾁｬ楽しい
Dialogue: 0,0:24:21.06,0:24:23.40,Japanese,,0,0,0,,俺の中では超ｱﾐｭｰｽﾞﾒﾝﾄ
Dialogue: 0,0:24:23.40,0:24:26.03,Japanese,,0,0,0,,飲み会のたんびに 子供が熱出して行けないから
Dialogue: 0,0:24:26.03,0:24:28.03,Japanese,,0,0,0,,｢留守番電話に接続します｣
Dialogue: 0,0:24:28.03,0:24:29.94,Japanese,,0,0,0,,津崎さん？
Dialogue: 0,0:24:29.94,0:24:32.80,Japanese,,0,0,0,,仕事切り上げて 早くこっちに来て
Dialogue: 0,0:24:32.80,0:24:34.17,Japanese,,0,0,0,,奥さんと子供は？
Dialogue: 0,0:24:34.17,0:24:35.94,Japanese,,0,0,0,,実家だって
Dialogue: 0,0:24:35.94,0:24:38.41,Japanese,,0,0,0,,近くで声優さんの ｲﾍﾞﾝﾄがあるんだって
Dialogue: 0,0:24:38.41,0:24:40.41,Japanese,,0,0,0,,奥さんの趣味
Dialogue: 0,0:24:40.41,0:24:44.25,Japanese,,0,0,0,,日野という超ﾚｱｷｬﾗと 飲めるﾁｬﾝｽめったにないからね
Dialogue: 0,0:24:44.25,0:24:47.55,Japanese,,0,0,0,,この留守電聞いたら 速攻で来て
Dialogue: 0,0:24:50.22,0:24:52.86,Japanese,,0,0,0,,いまお酒を飲んだら
Dialogue: 0,0:24:52.86,0:24:56.76,Japanese,,0,0,0,,言わなくていいことまで 言ってしまいそうだった。
Dialogue: 0,0:24:56.76,0:25:00.70,Japanese,,0,0,0,,しかし日野さんには お世話になっている
Dialogue: 0,0:25:00.70,0:25:04.57,Japanese,,0,0,0,,しかし体調もよろしくない
Dialogue: 0,0:25:04.57,0:25:07.94,Japanese,,0,0,0,,しかし日野さん
Dialogue: 0,0:25:07.94,0:25:12.41,Japanese,,0,0,0,,この よどんだ気分では
Dialogue: 0,0:25:12.41,0:25:14.98,Japanese,,0,0,0,,レアキャラ
Dialogue: 0,0:25:21.79,0:25:25.19,Japanese,,0,0,0,,こんなに はっきりしない男
Dialogue: 0,0:25:25.19,0:25:28.93,Japanese,,0,0,0,,みくりさんに愛想を尽かされて 当然だ。
Dialogue: 0,0:25:30.26,0:25:32.20,Japanese,,0,0,0,,やっと来た よッ
Dialogue: 0,0:25:32.20,0:25:33.63,Japanese,,0,0,0,,遅くなってすいません
Dialogue: 0,0:25:33.63,0:25:35.93,Japanese,,0,0,0,,おしぼりとビールください
Dialogue: 0,0:25:35.93,0:25:36.50,Japanese,,0,0,0,,はーい
Dialogue: 0,0:25:36.50,0:25:39.07,Japanese,,0,0,0,,追いついて 早く追いついて よッ
Dialogue: 0,0:25:39.07,0:25:40.57,Japanese,,0,0,0,,いただきます
Dialogue: 0,0:25:43.58,0:25:45.91,Japanese,,0,0,0,,百合ちゃんも誘ったんだけどね
Dialogue: 0,0:25:45.91,0:25:47.75,Japanese,,0,0,0,,百合ちゃん？
Dialogue: 0,0:25:47.75,0:25:50.18,Japanese,,0,0,0,,ああ 俺達 百合ちゃん沼ちゃんの仲だから
Dialogue: 0,0:25:50.18,0:25:51.82,Japanese,,0,0,0,,いつの間に……
Dialogue: 0,0:25:51.82,0:25:53.95,Japanese,,0,0,0,,でも車で来てるからダメだって
Dialogue: 0,0:25:53.95,0:25:55.55,Japanese,,0,0,0,,車通勤オッケーなんですね
Dialogue: 0,0:25:55.55,0:25:58.59,Japanese,,0,0,0,,何かね イベントの荷物がどうとかって
Dialogue: 0,0:25:58.59,0:26:00.19,Japanese,,0,0,0,,俺も会いたい
Dialogue: 0,0:26:00.19,0:26:02.73,Japanese,,0,0,0,,百合ちゃんとみくりちゃん
Dialogue: 0,0:26:04.16,0:26:06.06,Japanese,,0,0,0,,百合さんは分かりませんが
Dialogue: 0,0:26:06.06,0:26:09.33,Japanese,,0,0,0,,みくりさんには会えません きっと
Dialogue: 0,0:26:09.33,0:26:11.84,Japanese,,0,0,0,,会わせろよ～
Dialogue: 0,0:26:15.61,0:26:17.91,Japanese,,0,0,0,,この筑前煮は
Dialogue: 0,0:26:17.91,0:26:20.11,Japanese,,0,0,0,,星 １つ
Dialogue: 0,0:26:20.11,0:26:22.38,Japanese,,0,0,0,,採点 辛ッ
Dialogue: 0,0:26:22.38,0:26:23.82,Japanese,,0,0,0,,いや 星１つだ
Dialogue: 0,0:26:23.82,0:26:28.02,Japanese,,0,0,0,,母さんの筑前煮には 足元にも及ばない へへいッ
Dialogue: 0,0:26:29.52,0:26:32.52,Japanese,,0,0,0,,ちがやさん うちでも作ってね
Dialogue: 0,0:26:32.52,0:26:35.39,Japanese,,0,0,0,,また壁ドンされるよ
Dialogue: 0,0:26:35.39,0:26:37.16,Japanese,,0,0,0,,それ はやんねえからやめろ
Dialogue: 0,0:26:37.16,0:26:38.70,Japanese,,0,0,0,,やっさんのせいだからな
Dialogue: 0,0:26:38.70,0:26:40.53,Japanese,,0,0,0,,ほら冷めちゃうから食べて
Dialogue: 0,0:26:40.53,0:26:43.27,Japanese,,0,0,0,,いただきます
Dialogue: 0,0:26:49.67,0:26:54.38,Japanese,,0,0,0,,ねえ 風見さんちの 家事代行の人どうなったの？
Dialogue: 0,0:26:54.38,0:26:55.51,Japanese,,0,0,0,,どうって？
Dialogue: 0,0:26:55.51,0:26:58.55,Japanese,,0,0,0,,言ってたじゃん 狙ってるって
Dialogue: 0,0:26:58.55,0:27:01.22,Japanese,,0,0,0,,それが 今週急にお休みで
Dialogue: 0,0:27:01.22,0:27:03.29,Japanese,,0,0,0,,気軽に休まれてもね
Dialogue: 0,0:27:03.29,0:27:04.86,Japanese,,0,0,0,,気軽じゃないと思います
Dialogue: 0,0:27:04.86,0:27:08.66,Japanese,,0,0,0,,彼女は自分の言動に 責任を持つタイプだし
Dialogue: 0,0:27:08.66,0:27:12.90,Japanese,,0,0,0,,よほどいたたまれないことが あったんじゃないですか？
Dialogue: 0,0:27:16.33,0:27:17.90,Japanese,,0,0,0,,どんな？
Dialogue: 0,0:27:17.90,0:27:20.67,Japanese,,0,0,0,,そこまでは知りませんけど
Dialogue: 0,0:27:22.34,0:27:25.91,Japanese,,0,0,0,,知らないなら 何も言わないでください
Dialogue: 0,0:27:31.72,0:27:34.12,Japanese,,0,0,0,,事情は知りませんが
Dialogue: 0,0:27:34.12,0:27:36.48,Japanese,,0,0,0,,津崎さんより僕のほうが
Dialogue: 0,0:27:36.50,0:27:38.95,Japanese,,0,0,0,,彼女のことを 知ってるかもしれない
Dialogue: 0,0:27:40.66,0:27:44.20,Japanese,,0,0,0,,見えていると言うべきか
Dialogue: 0,0:27:47.80,0:27:52.27,Japanese,,0,0,0,,何が見えているか知りませんが
Dialogue: 0,0:27:52.27,0:27:55.94,Japanese,,0,0,0,,違うものが見えていて 当然じゃないでしょうか？
Dialogue: 0,0:27:55.94,0:28:00.01,Japanese,,0,0,0,,僕とあなたは あまりにも違う
Dialogue: 0,0:28:00.01,0:28:01.18,Japanese,,0,0,0,,違う？
Dialogue: 0,0:28:01.18,0:28:03.82,Japanese,,0,0,0,,僕はこんな場所で 人に皮肉をふっかけるような
Dialogue: 0,0:28:03.82,0:28:07.72,Japanese,,0,0,0,,自信に満ちあふれた 人間じゃないし
Dialogue: 0,0:28:07.72,0:28:13.06,Japanese,,0,0,0,,生き方も見た目も何もかも違う
Dialogue: 0,0:28:13.06,0:28:16.93,Japanese,,0,0,0,,根本的に違うんです
Dialogue: 0,0:28:20.93,0:28:22.73,Japanese,,0,0,0,,みんな違って みんないい
Dialogue: 0,0:28:22.73,0:28:24.54,Japanese,,0,0,0,,-みんないいよね -ねえ
Dialogue: 0,0:28:24.54,0:28:25.47,Japanese,,0,0,0,,飲んじゃおう
Dialogue: 0,0:28:25.47,0:28:28.11,Japanese,,0,0,0,,いっちゃおう いっちゃおう
Dialogue: 0,0:28:30.54,0:28:32.88,Japanese,,0,0,0,,安いほうがいいでしょ？
Dialogue: 0,0:28:32.88,0:28:34.51,Japanese,,0,0,0,,絶対そうでしょ
Dialogue: 0,0:28:34.51,0:28:35.78,Japanese,,0,0,0,,安いほうがいいでしょ？
Dialogue: 0,0:28:35.78,0:28:38.38,Japanese,,0,0,0,,５千円も うなぎ食うんだったらね……
Dialogue: 0,0:28:46.99,0:28:48.93,Japanese,,0,0,0,,まったく いい年して何やってんの
Dialogue: 0,0:28:48.93,0:28:52.16,Japanese,,0,0,0,,さーせんす しくよろ願いします
Dialogue: 0,0:28:52.16,0:28:56.07,Japanese,,0,0,0,,多少 責任を感じるので つきあいます
Dialogue: 0,0:29:02.51,0:29:03.51,Japanese,,0,0,0,,もう一軒
Dialogue: 0,0:29:03.51,0:29:04.11,Japanese,,0,0,0,,行っちゃうちゃう？
Dialogue: 0,0:29:04.11,0:29:04.81,Japanese,,0,0,0,,ちゃうちゃうちゃう
Dialogue: 0,0:29:04.81,0:29:07.64,Japanese,,0,0,0,,-まだ食べれる？ -食べれる
Dialogue: 0,0:29:07.64,0:29:10.68,Japanese,,0,0,0,,お父さんに厳しすぎない？
Dialogue: 0,0:29:10.68,0:29:12.28,Japanese,,0,0,0,,定年退職したんだから
Dialogue: 0,0:29:12.28,0:29:16.12,Japanese,,0,0,0,,少しは家事手伝ってよって 気持ちは分かるけど
Dialogue: 0,0:29:17.19,0:29:21.26,Japanese,,0,0,0,,先月ね 定期健診受けたの
Dialogue: 0,0:29:21.26,0:29:26.36,Japanese,,0,0,0,,お父さんには言ってないんだけど 再検査の項目があって
Dialogue: 0,0:29:26.36,0:29:30.27,Japanese,,0,0,0,,精密検査してきた
Dialogue: 0,0:29:30.27,0:29:32.17,Japanese,,0,0,0,,それで？
Dialogue: 0,0:29:37.28,0:29:39.54,Japanese,,0,0,0,,何ともなかった
Dialogue: 0,0:29:39.54,0:29:41.25,Japanese,,0,0,0,,何だ！
Dialogue: 0,0:29:41.25,0:29:43.38,Japanese,,0,0,0,,結果が出るまで不安でね
Dialogue: 0,0:29:43.38,0:29:45.38,Japanese,,0,0,0,,あれこれ考えちゃって
Dialogue: 0,0:29:45.38,0:29:51.22,Japanese,,0,0,0,,もし 私が先に死んだら お父さん どうなるんだろう
Dialogue: 0,0:29:51.22,0:29:54.53,Japanese,,0,0,0,,だから いい機会だと思って
Dialogue: 0,0:29:54.53,0:29:56.73,Japanese,,0,0,0,,なら そう言えばいいのに
Dialogue: 0,0:29:56.73,0:30:00.16,Japanese,,0,0,0,,もし先に死んだら…… なんて 言ったら お父さん心配するでしょ
Dialogue: 0,0:30:00.16,0:30:03.33,Japanese,,0,0,0,,ホントに死ぬんじゃないかって
Dialogue: 0,0:30:03.33,0:30:04.64,Japanese,,0,0,0,,いいね 愛されてて
Dialogue: 0,0:30:04.64,0:30:07.24,Japanese,,0,0,0,,愛してるわよ お互いに努力して
Dialogue: 0,0:30:07.24,0:30:08.34,Japanese,,0,0,0,,努力なの？
Dialogue: 0,0:30:08.34,0:30:12.01,Japanese,,0,0,0,,無償の愛なんて注げないわよ 他人なんだし
Dialogue: 0,0:30:12.01,0:30:13.64,Japanese,,0,0,0,,言うね
Dialogue: 0,0:30:13.64,0:30:16.51,Japanese,,0,0,0,,運命の相手ってよく言うけど
Dialogue: 0,0:30:16.51,0:30:18.85,Japanese,,0,0,0,,私そんなのいないと思うのよ
Dialogue: 0,0:30:18.85,0:30:19.92,Japanese,,0,0,0,,夢がない
Dialogue: 0,0:30:19.92,0:30:25.92,Japanese,,0,0,0,,運命の相手に するの
Dialogue: 0,0:30:27.19,0:30:29.33,Japanese,,0,0,0,,意志がなきゃ続かないのは
Dialogue: 0,0:30:29.33,0:30:33.16,Japanese,,0,0,0,,仕事も家庭も同じじゃないかな
Dialogue: 0,0:30:39.77,0:30:44.24,Japanese,,0,0,0,,津崎さんのおかげで 昔のことを思い出しました
Dialogue: 0,0:30:44.24,0:30:46.18,Japanese,,0,0,0,,その話 面白い？
Dialogue: 0,0:30:46.18,0:30:47.51,Japanese,,0,0,0,,ちっとも
Dialogue: 0,0:30:47.51,0:30:49.81,Japanese,,0,0,0,,じゃ 話さなくていい
Dialogue: 0,0:30:49.81,0:30:53.68,Japanese,,0,0,0,,中学の頃 僕はモテたんです
Dialogue: 0,0:30:53.68,0:30:55.39,Japanese,,0,0,0,,話すんだ
Dialogue: 0,0:30:55.39,0:30:57.66,Japanese,,0,0,0,,初めてできた彼女は
Dialogue: 0,0:30:57.66,0:31:01.53,Japanese,,0,0,0,,どちらかというと 地味な女の子でした
Dialogue: 0,0:31:01.53,0:31:04.63,Japanese,,0,0,0,,僕は とても彼女が好きだった
Dialogue: 0,0:31:04.63,0:31:06.40,Japanese,,0,0,0,,ところがある日……
Dialogue: 0,0:31:06.40,0:31:09.97,Japanese,,0,0,0,,風見君といるのが つらいの
Dialogue: 0,0:31:09.97,0:31:15.81,Japanese,,0,0,0,,風見君は かっこよくて スポーツもできて
Dialogue: 0,0:31:15.81,0:31:17.44,Japanese,,0,0,0,,女子に人気で
Dialogue: 0,0:31:17.44,0:31:19.44,Japanese,,0,0,0,,私は地味で かわいくないし
Dialogue: 0,0:31:19.44,0:31:22.51,Japanese,,0,0,0,,何であの二人が…… って みんなに言われて
Dialogue: 0,0:31:22.51,0:31:24.08,Japanese,,0,0,0,,気にしなきゃいいだろ
Dialogue: 0,0:31:24.08,0:31:26.95,Japanese,,0,0,0,,風見君には分かんないよ
Dialogue: 0,0:31:26.95,0:31:31.22,Japanese,,0,0,0,,私と風見君は
Dialogue: 0,0:31:31.22,0:31:34.02,Japanese,,0,0,0,,全然違うんだもの
Dialogue: 0,0:31:34.02,0:31:37.26,Japanese,,0,0,0,,そんなこと 僕にはどうしようもない
Dialogue: 0,0:31:37.26,0:31:43.03,Japanese,,0,0,0,,彼女が自信を持てないことは 彼女の問題なのに
Dialogue: 0,0:31:45.47,0:31:48.27,Japanese,,0,0,0,,あなたに どれだけ拒絶されても
Dialogue: 0,0:31:48.27,0:31:53.08,Japanese,,0,0,0,,大好きだよって 言ってあげれば よかったんでしょうか
Dialogue: 0,0:31:53.08,0:31:57.15,Japanese,,0,0,0,,向こうは僕の気持ちなんか 考えちゃいないのに
Dialogue: 0,0:31:57.15,0:32:00.42,Japanese,,0,0,0,,自分ばかり見ている彼女に
Dialogue: 0,0:32:00.42,0:32:03.02,Japanese,,0,0,0,,何を言えばよかったんでしょう？
Dialogue: 0,0:34:06.18,0:34:09.85,Japanese,,0,0,0,,どんな思いで作ったんだろう
Dialogue: 0,0:34:15.45,0:34:19.82,Japanese,,0,0,0,,どんな思いで ここを出ていたんだろう
Dialogue: 0,0:34:22.86,0:34:26.96,Japanese,,0,0,0,,あの時みくりさんは
Dialogue: 0,0:34:30.00,0:34:33.00,Japanese,,0,0,0,,どんな思いで
Dialogue: 0,0:34:33.00,0:34:35.81,Japanese,,0,0,0,,自分の気持ちで一杯で
Dialogue: 0,0:34:35.81,0:34:42.18,Japanese,,0,0,0,,僕は みくりさんが残していてくれた 料理を手に取ることもしなかった。
Dialogue: 0,0:35:10.84,0:35:16.85,Japanese,,0,0,0,,誰かを誠実に愛し続けることは
Dialogue: 0,0:35:16.85,0:35:20.22,Japanese,,0,0,0,,ものすごく 大変なことなのかもしれない
Dialogue: 0,0:35:24.56,0:35:28.66,Japanese,,0,0,0,,人の気持ちは変えられないけれど
Dialogue: 0,0:35:28.66,0:35:33.66,Japanese,,0,0,0,,人生のハンドルを握るのは 自分自身
Dialogue: 0,0:35:33.66,0:35:37.44,Japanese,,0,0,0,,もしかして 遠回りしてくれてます？
Dialogue: 0,0:35:37.44,0:35:40.80,Japanese,,0,0,0,,たそがれたいかなと思って
Dialogue: 0,0:35:40.80,0:35:42.34,Japanese,,0,0,0,,いいでしょ？ この道
Dialogue: 0,0:35:42.34,0:35:43.67,Japanese,,0,0,0,,はい
Dialogue: 0,0:35:43.67,0:35:47.01,Japanese,,0,0,0,,今の若い子って 車持たないわよね
Dialogue: 0,0:35:47.01,0:35:48.78,Japanese,,0,0,0,,なくても困りません
Dialogue: 0,0:35:48.78,0:35:49.85,Japanese,,0,0,0,,出た
Dialogue: 0,0:35:49.85,0:35:53.12,Japanese,,0,0,0,,電車やバスで大概の所は行けます
Dialogue: 0,0:35:53.12,0:35:54.99,Japanese,,0,0,0,,そうね
Dialogue: 0,0:35:54.99,0:35:58.89,Japanese,,0,0,0,,でもね
Dialogue: 0,0:35:58.89,0:36:02.93,Japanese,,0,0,0,,あなたが思ってるより ずっと遠くまで行けるのよ
Dialogue: 0,0:36:10.77,0:36:12.74,Japanese,,0,0,0,,バサーッ
Dialogue: 0,0:36:13.77,0:36:14.67,Japanese,,0,0,0,,はい あとやってね
Dialogue: 0,0:36:14.67,0:36:16.17,Japanese,,0,0,0,,喜んで
Dialogue: 0,0:36:16.17,0:36:20.04,Japanese,,0,0,0,,みんな一気に帰っちゃって 寂しいな
Dialogue: 0,0:36:20.04,0:36:22.05,Japanese,,0,0,0,,来るなって言ってたくせに
Dialogue: 0,0:36:22.05,0:36:23.61,Japanese,,0,0,0,,みくり
Dialogue: 0,0:36:24.82,0:36:27.95,Japanese,,0,0,0,,ずっといてもいいのよ
Dialogue: 0,0:36:29.99,0:36:32.02,Japanese,,0,0,0,,うん ありがとう
Dialogue: 0,0:36:51.91,0:36:53.58,Japanese,,0,0,0,,もしもし
Dialogue: 0,0:36:55.98,0:36:58.18,Japanese,,0,0,0,,平匡です
Dialogue: 0,0:36:59.32,0:37:01.18,Japanese,,0,0,0,,はい
Dialogue: 0,0:37:03.39,0:37:05.26,Japanese,,0,0,0,,ごめんなさい
Dialogue: 0,0:37:08.66,0:37:10.03,Japanese,,0,0,0,,あの もう
Dialogue: 0,0:37:10.03,0:37:12.56,Japanese,,0,0,0,,謝られるのは おなかいっぱいで
Dialogue: 0,0:37:12.56,0:37:14.40,Japanese,,0,0,0,,すいません
Dialogue: 0,0:37:14.40,0:37:15.87,Japanese,,0,0,0,,あッいや ごめんなさい あッ……
Dialogue: 0,0:37:15.87,0:37:17.64,Japanese,,0,0,0,,いや
Dialogue: 0,0:37:17.64,0:37:20.50,Japanese,,0,0,0,,何の用ですか？
Dialogue: 0,0:37:23.01,0:37:25.91,Japanese,,0,0,0,,みくりさんに 言いたいことがあって
Dialogue: 0,0:37:27.38,0:37:27.91,Japanese,,0,0,0,,僕は……
Dialogue: 0,0:37:27.91,0:37:30.51,Japanese,,0,0,0,,待ってください
Dialogue: 0,0:37:30.51,0:37:33.28,Japanese,,0,0,0,,先に私が話します
Dialogue: 0,0:37:33.28,0:37:38.82,Japanese,,0,0,0,,平匡さんの結論がどうであれ 私の気持ちは固まったんで
Dialogue: 0,0:37:41.79,0:37:47.80,Japanese,,0,0,0,,私 自分の気持ちを 因数分解してみたんです
Dialogue: 0,0:37:47.80,0:37:52.50,Japanese,,0,0,0,,余計なことを とっぱらって 最後に何が残るか
Dialogue: 0,0:37:52.50,0:37:54.30,Japanese,,0,0,0,,素因数分解ですね
Dialogue: 0,0:37:54.30,0:37:56.21,Japanese,,0,0,0,,はい
Dialogue: 0,0:37:56.21,0:37:59.14,Japanese,,0,0,0,,仕事とか収入とか
Dialogue: 0,0:37:59.14,0:38:03.91,Japanese,,0,0,0,,自分のやりたいこととか なりたい自分とか
Dialogue: 0,0:38:03.91,0:38:06.28,Japanese,,0,0,0,,色々考えて それで……
Dialogue: 0,0:38:06.28,0:38:07.58,Japanese,,0,0,0,,ちょっと待ってください
Dialogue: 0,0:38:07.58,0:38:09.82,Japanese,,0,0,0,,やっぱり先に話をさせてください
Dialogue: 0,0:38:09.82,0:38:11.52,Japanese,,0,0,0,,私の気持ちは もう固まって……
Dialogue: 0,0:38:11.52,0:38:13.89,Japanese,,0,0,0,,電話をかけたのは僕です
Dialogue: 0,0:38:13.89,0:38:17.30,Japanese,,0,0,0,,僕が先に話す 権利があると思います
Dialogue: 0,0:38:20.26,0:38:22.33,Japanese,,0,0,0,,確かに
Dialogue: 0,0:38:25.64,0:38:29.97,Japanese,,0,0,0,,僕は……
Dialogue: 0,0:38:29.97,0:38:32.64,Japanese,,0,0,0,,女性経験がありません
Dialogue: 0,0:38:36.55,0:38:40.48,Japanese,,0,0,0,,それでもいいと思って 生きてきました
Dialogue: 0,0:38:40.48,0:38:44.89,Japanese,,0,0,0,,だけど あの夜 真っ先に思ったことは
Dialogue: 0,0:38:44.89,0:38:48.29,Japanese,,0,0,0,,失敗したら どうなるだろうって
Dialogue: 0,0:38:48.29,0:38:53.36,Japanese,,0,0,0,,10歳も年下の女性にﾘｰﾄﾞされる 情けなさもあったと思います
Dialogue: 0,0:38:57.80,0:39:03.54,Japanese,,0,0,0,,拒絶されたみくりさんが どう思うかということは
Dialogue: 0,0:39:03.54,0:39:06.54,Japanese,,0,0,0,,まったく頭にありませんでした
Dialogue: 0,0:39:09.21,0:39:11.42,Japanese,,0,0,0,,ごめんなさい
Dialogue: 0,0:39:13.72,0:39:18.32,Japanese,,0,0,0,,未経験だと知られることが 怖くもありました
Dialogue: 0,0:39:19.46,0:39:21.49,Japanese,,0,0,0,,知ってました
Dialogue: 0,0:39:24.16,0:39:26.03,Japanese,,0,0,0,,知ってました とっくに
Dialogue: 0,0:39:27.20,0:39:30.10,Japanese,,0,0,0,,平匡さんのお母さんから 聞いた話とか
Dialogue: 0,0:39:30.10,0:39:34.04,Japanese,,0,0,0,,色々総合してそうかなって
Dialogue: 0,0:39:37.24,0:39:43.25,Japanese,,0,0,0,,私にとっては 大したことじゃありませんでした
Dialogue: 0,0:39:46.02,0:39:52.96,Japanese,,0,0,0,,でも 拒絶されたのは
Dialogue: 0,0:39:52.96,0:39:57.33,Japanese,,0,0,0,,すごく……
Dialogue: 0,0:39:57.33,0:39:59.80,Japanese,,0,0,0,,すごくショックでした
Dialogue: 0,0:40:05.57,0:40:10.41,Japanese,,0,0,0,,このまま館山で 市議会議員になろうかと
Dialogue: 0,0:40:10.41,0:40:12.28,Japanese,,0,0,0,,市議会議員？
Dialogue: 0,0:40:12.28,0:40:15.08,Japanese,,0,0,0,,同い年の議員の女性に会って
Dialogue: 0,0:40:15.08,0:40:20.28,Japanese,,0,0,0,,そういう人生もアリかなって
Dialogue: 0,0:40:20.28,0:40:23.35,Japanese,,0,0,0,,そう考えたら
Dialogue: 0,0:40:23.35,0:40:25.69,Japanese,,0,0,0,,気が楽になりました
Dialogue: 0,0:40:31.30,0:40:35.06,Japanese,,0,0,0,,他の道もあるんだから
Dialogue: 0,0:40:35.06,0:40:38.24,Japanese,,0,0,0,,今の道で失敗してもいいやって
Dialogue: 0,0:40:41.81,0:40:46.68,Japanese,,0,0,0,,これから 303号室に帰ろうと思います
Dialogue: 0,0:40:47.78,0:40:51.18,Japanese,,0,0,0,,全部とっぱらった 答えがそれです
Dialogue: 0,0:40:51.18,0:40:54.12,Japanese,,0,0,0,,平匡さんは迷惑かもしれないけど
Dialogue: 0,0:40:54.12,0:40:57.02,Japanese,,0,0,0,,このまま終わりなんて 中途半端だし
Dialogue: 0,0:40:57.02,0:40:59.89,Japanese,,0,0,0,,もう一度 会ってちゃんと話を……
Dialogue: 0,0:40:59.89,0:41:02.39,Japanese,,0,0,0,,会えます！
Dialogue: 0,0:41:02.39,0:41:03.83,Japanese,,0,0,0,,今 います
Dialogue: 0,0:41:03.83,0:41:06.00,Japanese,,0,0,0,,すぐ近くに
Dialogue: 0,0:41:06.00,0:41:08.50,Japanese,,0,0,0,,会って
Dialogue: 0,0:41:08.50,0:41:12.07,Japanese,,0,0,0,,火曜の分の ハグを！
Dialogue: 0,0:41:22.75,0:41:24.62,Japanese,,0,0,0,,はい！
Dialogue: 0,0:41:43.60,0:41:45.50,Japanese,,0,0,0,,津崎君！
Dialogue: 0,0:41:45.50,0:41:47.50,Japanese,,0,0,0,,みくりさんは？
Dialogue: 0,0:41:47.50,0:41:48.77,Japanese,,0,0,0,,あッ ちょっと待って
Dialogue: 0,0:41:51.11,0:41:52.78,Japanese,,0,0,0,,平匡さん 今どこにいます？
Dialogue: 0,0:41:52.78,0:41:55.55,Japanese,,0,0,0,,どこって 館山の……
Dialogue: 0,0:41:55.55,0:41:58.48,Japanese,,0,0,0,,私 今 マンションの前です
Dialogue: 0,0:42:01.12,0:42:05.16,Japanese,,0,0,0,,よく来てくれた～ッ
Dialogue: 0,0:42:05.16,0:42:06.49,Japanese,,0,0,0,,平匡さん ハグは？
Dialogue: 0,0:42:06.49,0:42:09.73,Japanese,,0,0,0,,今 されてます
Dialogue: 0,0:42:09.73,0:42:11.16,Japanese,,0,0,0,,お父さんに
Dialogue: 0,0:42:33.05,0:42:34.05,Japanese,,0,0,0,,もっともっともっと
Dialogue: 0,0:42:34.05,0:42:37.59,Japanese,,0,0,0,,いやいや もう 今日中には帰りたいので
Dialogue: 0,0:42:37.59,0:42:40.12,Japanese,,0,0,0,,いいじゃない 明日休みだろ？
Dialogue: 0,0:42:40.12,0:42:41.86,Japanese,,0,0,0,,お布団いっぱいあるから
Dialogue: 0,0:42:41.86,0:42:42.66,Japanese,,0,0,0,,そうだ
Dialogue: 0,0:42:42.66,0:42:44.86,Japanese,,0,0,0,,みくりのアルバム見る？
Dialogue: 0,0:42:44.86,0:42:46.60,Japanese,,0,0,0,,見たいですけども……
Dialogue: 0,0:42:46.60,0:42:47.93,Japanese,,0,0,0,,あッ ビデオもある
Dialogue: 0,0:42:47.93,0:42:48.93,Japanese,,0,0,0,,運動会
Dialogue: 0,0:42:48.93,0:42:50.37,Japanese,,0,0,0,,５時間に まとめたやつ
Dialogue: 0,0:42:50.37,0:42:52.30,Japanese,,0,0,0,,まとめて５時間？
Dialogue: 0,0:42:53.37,0:42:57.17,Japanese,,0,0,0,,すいません。 今日は帰れそうにありません。
Dialogue: 0,0:43:02.11,0:43:05.02,Japanese,,0,0,0,,頑張って 頑張って 頑張って！
Dialogue: 0,0:43:05.02,0:43:07.25,Japanese,,0,0,0,,すいません。 うちの両親強引で。
Dialogue: 0,0:43:07.25,0:43:08.82,Japanese,,0,0,0,,ほらほら
Dialogue: 0,0:43:08.82,0:43:10.49,Japanese,,0,0,0,,あそこ みくり
Dialogue: 0,0:43:10.49,0:43:12.66,Japanese,,0,0,0,,豆粒みたいで分かんないわよね
Dialogue: 0,0:43:12.66,0:43:14.02,Japanese,,0,0,0,,分かるよ ほら見て
Dialogue: 0,0:43:14.02,0:43:16.03,Japanese,,0,0,0,,いや かわいい～
Dialogue: 0,0:43:17.39,0:43:19.80,Japanese,,0,0,0,,明日には帰ります。
Dialogue: 0,0:43:20.90,0:43:24.03,Japanese,,0,0,0,,明日のご飯は何にしようか
Dialogue: 0,0:43:24.03,0:43:26.94,Japanese,,0,0,0,,どんな話をしようか
Dialogue: 0,0:43:26.94,0:43:29.27,Japanese,,0,0,0,,待ってます。
Dialogue: 0,0:43:30.98,0:43:34.21,Japanese,,0,0,0,,子供みたいに ワクワクしながら
Dialogue: 0,0:43:35.41,0:43:37.98,Japanese,,0,0,0,,待っていてください。
Dialogue: 0,0:43:38.88,0:43:42.92,Japanese,,0,0,0,,明日来るのを待ちわびていた。
Dialogue: 0,0:44:31.64,0:44:32.90,Japanese,,0,0,0,,お疲れさまでした。
Dialogue: 0,0:44:32.90,0:44:35.17,Japanese,,0,0,0,,疲れた。
Dialogue: 0,0:44:35.17,0:44:38.08,Japanese,,0,0,0,,リストラするなら 余裕がある人からだって
Dialogue: 0,0:44:38.08,0:44:39.74,Japanese,,0,0,0,,火曜はクビの火
Dialogue: 0,0:44:39.74,0:44:42.05,Japanese,,0,0,0,,システムの再構築は必要です。
Dialogue: 0,0:44:42.05,0:44:44.38,Japanese,,0,0,0,,軽い女と思われている。
Dialogue: 0,0:44:44.38,0:44:47.82,Japanese,,0,0,0,,今の私 完全に悦子市原
Dialogue: 0,0:44:47.82,0:44:49.75,Japanese,,0,0,0,,家政婦は見た。
Dialogue: 0,0:00:07.11,0:00:08.11,Default,,0,0,0,,奇怪？
Dialogue: 0,0:00:08.11,0:00:10.11,Default,,0,0,0,,今天也没带便当吗？
Dialogue: 0,0:00:10.11,0:00:11.58,Default,,0,0,0,,惹你老婆生气吗？
Dialogue: 0,0:00:11.58,0:00:12.61,Default,,0,0,0,,我也碰过
Dialogue: 0,0:00:12.61,0:00:14.78,Default,,0,0,0,,打开便当就只有白饭
Dialogue: 0,0:00:14.78,0:00:16.12,Default,,0,0,0,,就连盐渍昆布都没有
Dialogue: 0,0:00:16.12,0:00:19.49,Default,,0,0,0,,日野 你什么都不懂
Dialogue: 0,0:00:19.49,0:00:23.02,Default,,0,0,0,,津崎到目前为止的便当策略 你完全没看穿
Dialogue: 0,0:00:23.02,0:00:24.59,Default,,0,0,0,,策略？
Dialogue: 0,0:00:24.59,0:00:27.36,Default,,0,0,0,,津崎之前带的便当……
Dialogue: 0,0:00:27.36,0:00:30.46,Default,,0,0,0,,全都是津崎自己做的
Dialogue: 0,0:00:30.46,0:00:35.80,Default,,0,0,0,,就像情人节时自己买巧克力 放在自己的鞋柜里
Dialogue: 0,0:00:35.80,0:00:36.80,Default,,0,0,0,,跟这个一样
Dialogue: 0,0:00:36.80,0:00:37.97,Default,,0,0,0,,我才不会做这种事
Dialogue: 0,0:00:37.97,0:00:39.34,Default,,0,0,0,,我也不会
Dialogue: 0,0:00:39.34,0:00:43.28,Default,,0,0,0,,总之这样就能确定一件事
Dialogue: 0,0:00:43.28,0:00:45.44,Default,,0,0,0,,美栗小姐……
Dialogue: 0,0:00:46.75,0:00:49.05,Default,,0,0,0,,其实是日雇妻
Dialogue: 0,0:00:51.05,0:00:54.55,Default,,0,0,0,,就只有跟我们见面那天 雇用她来假冒
Dialogue: 0,0:00:56.69,0:00:58.06,Default,,0,0,0,,沼田先生
Dialogue: 0,0:00:58.06,0:01:00.73,Default,,0,0,0,,津崎先生跟美栗小姐其实很恩爱的
Dialogue: 0,0:01:00.73,0:01:01.76,Default,,0,0,0,,少来了
Dialogue: 0,0:01:01.76,0:01:03.76,Default,,0,0,0,,只是很常见的夫妻吵架
Dialogue: 0,0:01:03.76,0:01:05.96,Default,,0,0,0,,对不对？
Dialogue: 0,0:01:05.96,0:01:08.57,Default,,0,0,0,,那天晚上……
Dialogue: 0,0:01:19.58,0:01:22.95,Default,,0,0,0,,然后美栗小姐……
Dialogue: 0,0:01:25.58,0:01:29.59,Default,,0,0,0,,好像什么事都没发生 像平常一样对待我
Dialogue: 0,0:01:29.59,0:01:30.66,Default,,0,0,0,,路上小心
Dialogue: 0,0:01:30.66,0:01:33.06,Default,,0,0,0,,我去上班了
Dialogue: 0,0:01:36.20,0:01:40.13,Default,,0,0,0,,不过那天晚上……
Dialogue: 0,0:01:40.13,0:01:45.17,Default,,0,0,0,,我回家后 发现美栗小姐不见了
Dialogue: 0,0:01:45.17,0:01:46.74,Default,,0,0,0,,我也不知道是怎么回事
Dialogue: 0,0:01:46.74,0:01:50.81,Default,,0,0,0,,礼拜一来我家做家事时 她什么都没说
Dialogue: 0,0:01:50.81,0:01:52.68,Default,,0,0,0,,你最后一次见到她是什么时候？
Dialogue: 0,0:01:52.68,0:01:53.81,Default,,0,0,0,,跟你一样
Dialogue: 0,0:01:53.81,0:01:57.18,Default,,0,0,0,,礼拜一晚上 她从你家离开后 跟我约在车站
Dialogue: 0,0:01:57.18,0:01:58.82,Default,,0,0,0,,美栗
Dialogue: 0,0:01:58.82,0:02:02.49,Default,,0,0,0,,说想还我送的冰酒
Dialogue: 0,0:02:02.49,0:02:05.49,Default,,0,0,0,,抱歉 这个还你
Dialogue: 0,0:02:06.63,0:02:08.33,Default,,0,0,0,,因为你说很贵
Dialogue: 0,0:02:08.33,0:02:11.46,Default,,0,0,0,,而且还剩这么多 我不忍心扔掉
Dialogue: 0,0:02:11.46,0:02:12.83,Default,,0,0,0,,你不喜欢喝吗？
Dialogue: 0,0:02:12.83,0:02:14.60,Default,,0,0,0,,很好喝
Dialogue: 0,0:02:14.60,0:02:16.87,Default,,0,0,0,,那为什么还我？
Dialogue: 0,0:02:18.17,0:02:21.84,Default,,0,0,0,,看到它 我就好想死
Dialogue: 0,0:02:22.91,0:02:28.28,Default,,0,0,0,,我不认为冰酒有 把人逼到这个地步的力量
Dialogue: 0,0:02:28.28,0:02:31.48,Default,,0,0,0,,是不是跟津崎先生怎么了？
Dialogue: 0,0:02:31.48,0:02:33.12,Default,,0,0,0,,你也这么觉得啊
Dialogue: 0,0:02:33.12,0:02:35.92,Default,,0,0,0,,如果对方是我 就能贯彻制式关系
Dialogue: 0,0:02:35.92,0:02:38.92,Default,,0,0,0,,一切都会很顺利才对
Dialogue: 0,0:02:38.92,0:02:40.43,Default,,0,0,0,,你在讲什么？
Dialogue: 0,0:02:40.43,0:02:44.43,Default,,0,0,0,,除了人心以外 一切都很好处理
Dialogue: 0,0:02:46.03,0:02:51.64,Default,,0,0,0,,可不可以不要每次都讲些 谜上加谜的话
Dialogue: 0,0:02:51.64,0:02:54.87,Default,,0,0,0,,如果你很好奇 打电话问她不就好了
Dialogue: 0,0:03:00.21,0:03:02.22,Default,,0,0,0,,美栗吗？
Dialogue: 0,0:03:04.22,0:03:07.42,Default,,0,0,0,,你什么时候回来？
Dialogue: 0,0:03:07.42,0:03:10.62,Default,,0,0,0,,我现在没办法回去
Dialogue: 0,0:03:10.62,0:03:12.56,Default,,0,0,0,,为什么？
Dialogue: 0,0:03:12.56,0:03:15.46,Default,,0,0,0,,因为面临离婚危机
Dialogue: 0,0:03:15.46,0:03:17.46,Default,,0,0,0,,离婚危机？
Dialogue: 0,0:03:17.46,0:03:19.73,Default,,0,0,0,,果然是这样吗？
Dialogue: 0,0:03:19.73,0:03:22.17,Default,,0,0,0,,嗯 好像比想象中更严重
Dialogue: 0,0:03:22.17,0:03:23.77,Default,,0,0,0,,为什么会放在一起洗啊
Dialogue: 0,0:03:23.77,0:03:27.34,Default,,0,0,0,,上面不是有写“小心掉色”吗？
Dialogue: 0,0:03:27.34,0:03:29.61,Default,,0,0,0,,要是每件都看 天都黑了
Dialogue: 0,0:03:29.61,0:03:33.75,Default,,0,0,0,,不懂的人就是要看 要看过才能拿去洗
Dialogue: 0,0:03:33.75,0:03:37.18,Default,,0,0,0,,这件衣服很贵 而且人家好喜欢
Dialogue: 0,0:03:37.18,0:03:37.85,Default,,0,0,0,,美栗？
Dialogue: 0,0:03:37.85,0:03:39.45,Default,,0,0,0,,这10年来我还换过扣子 好宝贝这件衣服
Dialogue: 0,0:03:39.45,0:03:42.46,Default,,0,0,0,,抱歉 我再传简讯给你
Dialogue: 0,0:03:42.46,0:03:44.62,Default,,0,0,0,,妈 没必要说得这么难听吧
Dialogue: 0,0:03:44.62,0:03:46.93,Default,,0,0,0,,这个人前天也做过同样的事
Dialogue: 0,0:03:46.93,0:03:48.23,Default,,0,0,0,,因为我太粗心
Dialogue: 0,0:03:48.23,0:03:50.53,Default,,0,0,0,,粗心你个头
Dialogue: 0,0:03:50.53,0:03:52.40,Default,,0,0,0,,妈
Dialogue: 0,0:04:01.24,0:04:03.98,Default,,0,0,0,,不用在意啦
Dialogue: 0,0:04:03.98,0:04:07.68,Default,,0,0,0,,妈妈只是有点暴躁
Dialogue: 0,0:04:07.68,0:04:09.98,Default,,0,0,0,,有点而已吗？
Dialogue: 0,0:04:09.98,0:04:12.85,Default,,0,0,0,,是非常暴躁啦
Dialogue: 0,0:04:12.85,0:04:17.92,Default,,0,0,0,,她的身体一直很好 从没受过伤
Dialogue: 0,0:04:17.92,0:04:21.16,Default,,0,0,0,,所以她自己也不知所措吧
Dialogue: 0,0:04:21.16,0:04:24.33,Default,,0,0,0,,你回来帮忙真是太好了
Dialogue: 0,0:04:24.33,0:04:28.43,Default,,0,0,0,,我才觉得庆幸 这次帮了我大忙
Dialogue: 0,0:04:28.43,0:04:31.00,Default,,0,0,0,,那天晚上……
Dialogue: 0,0:04:33.37,0:04:41.71,Default,,0,0,0,,后来我就假装没事发生 想要正常的生活
Dialogue: 0,0:04:41.71,0:04:48.42,Default,,0,0,0,,不过不管做什么事 那天晚上的记忆……
Dialogue: 0,0:05:08.07,0:05:12.61,Default,,0,0,0,,就算如此还是想克服 所以我很努力幻想
Dialogue: 0,0:05:12.61,0:05:14.55,Default,,0,0,0,,森山 森山……
Dialogue: 0,0:05:14.55,0:05:17.05,Default,,0,0,0,,请注意转播席这边
Dialogue: 0,0:05:17.05,0:05:19.15,Default,,0,0,0,,这位是森山美栗选手
Dialogue: 0,0:05:19.15,0:05:23.26,Default,,0,0,0,,-辛苦你了 -辛苦了
Dialogue: 0,0:05:23.26,0:05:27.33,Default,,0,0,0,,回顾今天的比赛觉得怎么样？
Dialogue: 0,0:05:27.33,0:05:29.10,Default,,0,0,0,,我搞砸了
Dialogue: 0,0:05:29.10,0:05:30.83,Default,,0,0,0,,犯下悔不当初的失误
Dialogue: 0,0:05:30.83,0:05:32.70,Default,,0,0,0,,我愿意
Dialogue: 0,0:05:32.70,0:05:36.44,Default,,0,0,0,,如果是跟平匡先生
Dialogue: 0,0:05:36.44,0:05:39.50,Default,,0,0,0,,就算做那种事情我也愿意
Dialogue: 0,0:05:49.92,0:05:52.62,Default,,0,0,0,,对不起
Dialogue: 0,0:05:55.02,0:05:57.79,Default,,0,0,0,,我办不到
Dialogue: 0,0:05:57.79,0:06:00.13,Default,,0,0,0,,如果不要说那句话
Dialogue: 0,0:06:00.13,0:06:05.46,Default,,0,0,0,,那天原本能在 气氛很棒的状况下结束
Dialogue: 0,0:06:05.46,0:06:08.67,Default,,0,0,0,,我克制不了想跟他更进一步的欲望
Dialogue: 0,0:06:08.67,0:06:13.71,Default,,0,0,0,,以为他一定会接受的这样的自己
Dialogue: 0,0:06:13.71,0:06:15.88,Default,,0,0,0,,是个悲惨女……
Dialogue: 0,0:06:15.88,0:06:18.04,Default,,0,0,0,,加油
Dialogue: 0,0:06:18.04,0:06:20.05,Default,,0,0,0,,抱歉
Dialogue: 0,0:06:20.05,0:06:24.75,Default,,0,0,0,,那么对于津崎选手 你现在的想法如何？
Dialogue: 0,0:06:24.75,0:06:28.62,Default,,0,0,0,,他是个很优秀的选手 我很尊敬他
Dialogue: 0,0:06:28.62,0:06:32.26,Default,,0,0,0,,今后我会跟他保持一定距离
Dialogue: 0,0:06:32.26,0:06:35.13,Default,,0,0,0,,谨慎的做好自己的工作
Dialogue: 0,0:06:35.13,0:06:38.73,Default,,0,0,0,,-没错…… -就是这样……
Dialogue: 0,0:06:38.73,0:06:39.60,Default,,0,0,0,,谢谢大家
Dialogue: 0,0:06:39.60,0:06:42.70,Default,,0,0,0,,没问题 这样做就对了
Dialogue: 0,0:06:45.20,0:06:48.14,Default,,0,0,0,,就把那天晚上的事当成趣闻
Dialogue: 0,0:06:48.14,0:06:50.24,Default,,0,0,0,,靠幻想来自我解嘲 自我蒙混
Dialogue: 0,0:06:50.24,0:06:51.84,Default,,0,0,0,,一定能够克服过去
Dialogue: 0,0:06:56.55,0:07:00.02,Default,,0,0,0,,不过拥抱日毫不留情的到来
Dialogue: 0,0:07:01.65,0:07:02.79,Default,,0,0,0,,路上小心
Dialogue: 0,0:07:02.79,0:07:04.96,Default,,0,0,0,,我出门了
Dialogue: 0,0:07:18.47,0:07:19.91,Default,,0,0,0,,好想到很远的地方去
Dialogue: 0,0:07:19.91,0:07:21.04,Default,,0,0,0,,去哪里都行
Dialogue: 0,0:07:21.04,0:07:22.84,Default,,0,0,0,,越远越好
Dialogue: 0,0:07:25.11,0:07:26.75,Default,,0,0,0,,听说妈骨折了
Dialogue: 0,0:07:26.75,0:07:28.55,Default,,0,0,0,,从梯子上掉下来 要2个月才会好
Dialogue: 0,0:07:28.55,0:07:29.75,Default,,0,0,0,,那不是很糟吗？
Dialogue: 0,0:07:29.75,0:07:31.05,Default,,0,0,0,,家事怎么办？
Dialogue: 0,0:07:31.05,0:07:32.68,Default,,0,0,0,,爸在做
Dialogue: 0,0:07:32.68,0:07:33.75,Default,,0,0,0,,妈说除了脚以外 一切都很好
Dialogue: 0,0:07:33.75,0:07:36.59,Default,,0,0,0,,还说不用担心 叫我们别回去
Dialogue: 0,0:07:48.27,0:07:53.14,Default,,0,0,0,,打工 社团活动 学校 我从来没有请过假
Dialogue: 0,0:07:58.84,0:08:02.38,Default,,0,0,0,,这是我最大的自豪
Dialogue: 0,0:08:02.38,0:08:05.32,Default,,0,0,0,,有生以来第一次弃离职守
Dialogue: 0,0:08:05.32,0:08:08.65,Default,,0,0,0,,至少要做好万全准备
Dialogue: 0,0:08:13.96,0:08:16.20,Default,,0,0,0,,平匡先生
Dialogue: 0,0:08:16.20,0:08:19.73,Default,,0,0,0,,我妈骨折 叫我一定要回去帮忙
Dialogue: 0,0:08:19.73,0:08:21.97,Default,,0,0,0,,所以我要去馆山一趟
Dialogue: 0,0:08:21.97,0:08:24.04,Default,,0,0,0,,煮好的饭菜放在冰箱里
Dialogue: 0,0:08:25.80,0:08:28.04,Default,,0,0,0,,不管是什么借口都好
Dialogue: 0,0:08:28.04,0:08:31.14,Default,,0,0,0,,只要能逃离这里就好
Dialogue: 0,0:08:33.85,0:08:37.48,Default,,0,0,0,,只要能逃离礼拜二就好
Dialogue: 0,0:08:59.24,0:09:03.68,Default,,0,0,0,,只要能让我 不用面对悲惨的自己就好
Dialogue: 0,0:09:10.78,0:09:14.82,Default,,0,0,0,,也许再也无法回来
Dialogue: 0,0:09:14.82,0:09:20.29,Default,,0,0,0,,另一个自己装聋作哑 说服自己“这也是人生”
Dialogue: 0,0:09:21.36,0:09:25.60,Default,,0,0,0,,好好发挥 未来的我
Dialogue: 0,0:09:25.60,0:09:27.83,Default,,0,0,0,,一定会面带笑容吧
Dialogue: 0,0:09:27.83,0:09:31.14,Default,,0,0,0,,两人的步宽 呼吸 小动作 会渐渐同步
Dialogue: 0,0:09:31.14,0:09:35.41,Default,,0,0,0,,给我等着瞧 那个时候的我
Dialogue: 0,0:09:35.41,0:09:38.51,Default,,0,0,0,,下次绝对不要停下来
Dialogue: 0,0:09:38.51,0:09:42.18,Default,,0,0,0,,继续迈进 就算逃走也要争取未来
Dialogue: 0,0:09:46.02,0:09:47.55,Default,,0,0,0,,我每天都过得很充实
Dialogue: 0,0:09:47.55,0:09:49.22,Default,,0,0,0,,你跟老公吵架了吗？
Dialogue: 0,0:09:49.22,0:09:50.69,Default,,0,0,0,,至少会裁员吧
Dialogue: 0,0:09:50.69,0:09:53.76,Default,,0,0,0,,我觉得我比津崎先生 要更了解美栗小姐
Dialogue: 0,0:09:53.76,0:09:58.06,Default,,0,0,0,,我跟你基本上完全不一样
Dialogue: 0,0:09:58.06,0:10:00.20,Default,,0,0,0,,要一直待在这里也可以哦
Dialogue: 0,0:10:00.20,0:10:00.87,Default,,0,0,0,,谢谢
Dialogue: 0,0:10:04.00,0:10:08.31,Default,,0,0,0,,没想到你爸无能到这种地步
Dialogue: 0,0:10:08.31,0:10:10.48,Default,,0,0,0,,去露营时爸爸没帮忙煮饭吗？
Dialogue: 0,0:10:10.48,0:10:13.51,Default,,0,0,0,,后来仔细想想 切菜的是我
Dialogue: 0,0:10:13.51,0:10:16.42,Default,,0,0,0,,煮咖喱的也是我
Dialogue: 0,0:10:16.42,0:10:18.35,Default,,0,0,0,,爸就只有生火烤肉而已
Dialogue: 0,0:10:18.35,0:10:20.95,Default,,0,0,0,,现在才发现自己被骗
Dialogue: 0,0:10:20.95,0:10:23.39,Default,,0,0,0,,哪算是被骗啊
Dialogue: 0,0:10:23.39,0:10:25.86,Default,,0,0,0,,是你自己误会我而已
Dialogue: 0,0:10:25.86,0:10:28.66,Default,,0,0,0,,应该多训练你做家事才对
Dialogue: 0,0:10:28.66,0:10:31.03,Default,,0,0,0,,你还是多少有帮点忙吧
Dialogue: 0,0:10:31.03,0:10:33.60,Default,,0,0,0,,我有帮忙倒垃圾
Dialogue: 0,0:10:35.10,0:10:37.30,Default,,0,0,0,,爸 倒垃圾不算做家事
Dialogue: 0,0:10:37.30,0:10:38.30,Default,,0,0,0,,也有帮忙打扫浴室
Dialogue: 0,0:10:38.30,0:10:39.07,Default,,0,0,0,,多久1次？
Dialogue: 0,0:10:39.07,0:10:41.81,Default,,0,0,0,,大概1个月2次吧
Dialogue: 0,0:10:45.04,0:10:49.15,Default,,0,0,0,,偶尔帮忙扫一下浴室就一脸得意
Dialogue: 0,0:10:49.15,0:10:50.98,Default,,0,0,0,,小葵
Dialogue: 0,0:10:50.98,0:10:53.65,Default,,0,0,0,,不好意思 我忍不住想起小茅
Dialogue: 0,0:10:53.65,0:10:55.89,Default,,0,0,0,,小梢
Dialogue: 0,0:10:55.89,0:10:58.06,Default,,0,0,0,,我是爷爷哦
Dialogue: 0,0:10:58.06,0:10:59.62,Default,,0,0,0,,很抱歉从院子进来
Dialogue: 0,0:10:59.62,0:11:01.63,Default,,0,0,0,,因为这孩子先跑了进来
Dialogue: 0,0:11:01.63,0:11:03.26,Default,,0,0,0,,妈 你的脚不要紧吧
Dialogue: 0,0:11:03.26,0:11:04.60,Default,,0,0,0,,我没事
Dialogue: 0,0:11:04.60,0:11:06.13,Default,,0,0,0,,我哥什么都不做吗？
Dialogue: 0,0:11:06.13,0:11:07.57,Default,,0,0,0,,完全不做
Dialogue: 0,0:11:07.57,0:11:10.37,Default,,0,0,0,,一回家就说“累死了 帮我按摩”
Dialogue: 0,0:11:10.37,0:11:12.60,Default,,0,0,0,,我们才需要按摩呢
Dialogue: 0,0:11:12.60,0:11:16.84,Default,,0,0,0,,现在是还无所谓 不过我下个月要回去上班
Dialogue: 0,0:11:16.84,0:11:18.44,Default,,0,0,0,,找到幼稚园了啊
Dialogue: 0,0:11:18.44,0:11:19.88,Default,,0,0,0,,好不容易找到
Dialogue: 0,0:11:19.88,0:11:23.95,Default,,0,0,0,,不过要上班 照顾小梢
Dialogue: 0,0:11:23.95,0:11:27.02,Default,,0,0,0,,连小茅都得照顾 我实在没自信办到
Dialogue: 0,0:11:27.02,0:11:29.36,Default,,0,0,0,,很抱歉我没把儿子教好
Dialogue: 0,0:11:29.36,0:11:30.62,Default,,0,0,0,,我不是这个意思
Dialogue: 0,0:11:30.62,0:11:34.46,Default,,0,0,0,,因为我是全职主妇 加上做家事是我的兴趣
Dialogue: 0,0:11:34.46,0:11:36.20,Default,,0,0,0,,也许之前做过头了
Dialogue: 0,0:11:36.20,0:11:37.76,Default,,0,0,0,,你就有叫我做啊
Dialogue: 0,0:11:37.76,0:11:40.63,Default,,0,0,0,,是你自己说“我要帮妈妈忙”
Dialogue: 0,0:11:40.63,0:11:42.64,Default,,0,0,0,,-是这样吗？ -是啊
Dialogue: 0,0:11:44.40,0:11:46.60,Default,,0,0,0,,衣服洗好了
Dialogue: 0,0:11:46.60,0:11:47.24,Default,,0,0,0,,-我来帮忙 -我来
Dialogue: 0,0:11:47.24,0:11:50.74,Default,,0,0,0,,不行 这是你爸爸的工作
Dialogue: 0,0:11:51.88,0:11:54.31,Default,,0,0,0,,爸爸来晒
Dialogue: 0,0:11:55.61,0:11:57.78,Default,,0,0,0,,上面还有皱折
Dialogue: 0,0:11:57.78,0:11:59.82,Default,,0,0,0,,要用力甩过
Dialogue: 0,0:12:02.15,0:12:05.52,Default,,0,0,0,,平匡先生会帮忙做家事吗？
Dialogue: 0,0:12:05.52,0:12:08.86,Default,,0,0,0,,他还算会帮忙
Dialogue: 0,0:12:08.86,0:12:11.60,Default,,0,0,0,,好好哦
Dialogue: 0,0:12:11.60,0:12:14.70,Default,,0,0,0,,“我是拿薪水在做家事”
Dialogue: 0,0:12:14.70,0:12:18.87,Default,,0,0,0,,在无薪奉献的人面前 这句话我说不出口
Dialogue: 0,0:12:21.31,0:12:23.51,Default,,0,0,0,,又要少一个人吗？
Dialogue: 0,0:12:23.51,0:12:24.91,Default,,0,0,0,,听说是请产假
Dialogue: 0,0:12:24.91,0:12:26.11,Default,,0,0,0,,糟透了
Dialogue: 0,0:12:26.11,0:12:27.78,Default,,0,0,0,,有够会找麻烦
Dialogue: 0,0:12:27.78,0:12:29.12,Default,,0,0,0,,不要说这种话
Dialogue: 0,0:12:29.12,0:12:30.95,Default,,0,0,0,,土屋小姐的工作量也会增加吧
Dialogue: 0,0:12:30.95,0:12:32.68,Default,,0,0,0,,你不会火大吗？
Dialogue: 0,0:12:32.68,0:12:36.16,Default,,0,0,0,,不好意思 我跟你们是不同的次元
Dialogue: 0,0:12:38.36,0:12:40.29,Default,,0,0,0,,感谢
Dialogue: 0,0:12:41.33,0:12:43.60,Default,,0,0,0,,感谢？
Dialogue: 0,0:12:43.60,0:12:46.93,Default,,0,0,0,,连我的份一起生 谢谢
Dialogue: 0,0:12:46.93,0:12:48.93,Default,,0,0,0,,会这么想吗？
Dialogue: 0,0:12:48.93,0:12:52.07,Default,,0,0,0,,到了这个年纪 连忌妒都不会了
Dialogue: 0,0:12:52.07,0:12:53.84,Default,,0,0,0,,不过别人会这么说吧
Dialogue: 0,0:12:53.84,0:12:56.48,Default,,0,0,0,,既然生为女人 就应该这样或那样
Dialogue: 0,0:12:56.48,0:12:58.41,Default,,0,0,0,,自己不去在意就好
Dialogue: 0,0:12:58.41,0:13:00.61,Default,,0,0,0,,因为我们更努力工作啊
Dialogue: 0,0:13:00.61,0:13:02.41,Default,,0,0,0,,而且很守法缴税啊
Dialogue: 0,0:13:02.41,0:13:05.42,Default,,0,0,0,,所以你们也不要抱怨
Dialogue: 0,0:13:05.42,0:13:09.05,Default,,0,0,0,,能在可休产假的公司工作 就该偷笑了
Dialogue: 0,0:13:09.05,0:13:13.53,Default,,0,0,0,,而且公司福利好就表示工作很稳定
Dialogue: 0,0:13:13.53,0:13:16.93,Default,,0,0,0,,社长 实际状况是怎样？
Dialogue: 0,0:13:16.93,0:13:19.43,Default,,0,0,0,,我们公司以后没问题吗？
Dialogue: 0,0:13:19.43,0:13:21.77,Default,,0,0,0,,为什么沼田先生知道这件事？
Dialogue: 0,0:13:21.77,0:13:24.94,Default,,0,0,0,,很抱歉 好像是我举止诡异
Dialogue: 0,0:13:24.94,0:13:27.11,Default,,0,0,0,,他感到怀疑 所以跟踪我
Dialogue: 0,0:13:27.11,0:13:31.01,Default,,0,0,0,,他威胁要关闭所有服务器 完全拿他没辙
Dialogue: 0,0:13:31.01,0:13:32.28,Default,,0,0,0,,可恶
Dialogue: 0,0:13:32.28,0:13:33.28,Default,,0,0,0,,臭网管工程师
Dialogue: 0,0:13:33.28,0:13:35.92,Default,,0,0,0,,这家公司的生命线掌握在我手中
Dialogue: 0,0:13:35.92,0:13:39.32,Default,,0,0,0,,沼田先生以前 不是负责保卫国家的网管吗？
Dialogue: 0,0:13:39.32,0:13:41.82,Default,,0,0,0,,那份工作很辛苦
Dialogue: 0,0:13:41.82,0:13:45.49,Default,,0,0,0,,薪水比现在多1倍 不过压力却多5倍
Dialogue: 0,0:13:46.93,0:13:48.53,Default,,0,0,0,,你以前很惨咯
Dialogue: 0,0:13:48.53,0:13:51.46,Default,,0,0,0,,你现在也很惨吧 到底怎么样？
Dialogue: 0,0:13:51.46,0:13:55.97,Default,,0,0,0,,现在只是我们的客户M公司 可能遭到并购
Dialogue: 0,0:13:55.97,0:13:59.14,Default,,0,0,0,,如果因为这样就中止 跟我们的交易怎么办？
Dialogue: 0,0:13:59.14,0:14:02.27,Default,,0,0,0,,我们公司的营收马上会掉4成
Dialogue: 0,0:14:02.27,0:14:03.88,Default,,0,0,0,,也是啦
Dialogue: 0,0:14:03.88,0:14:05.34,Default,,0,0,0,,太轻浮了吧
Dialogue: 0,0:14:05.34,0:14:06.85,Default,,0,0,0,,船到桥头自然直
Dialogue: 0,0:14:06.85,0:14:09.32,Default,,0,0,0,,如果真的很不妙 至少会裁个员吧
Dialogue: 0,0:14:09.32,0:14:11.18,Default,,0,0,0,,至少？
Dialogue: 0,0:14:11.18,0:14:14.19,Default,,0,0,0,,你要我现在就破坏服务器吗？ 社长大人
Dialogue: 0,0:14:14.19,0:14:16.69,Default,,0,0,0,,现在又还没有确定
Dialogue: 0,0:14:16.69,0:14:19.06,Default,,0,0,0,,没事让大家紧张也不好
Dialogue: 0,0:14:19.06,0:14:20.43,Default,,0,0,0,,这件事请你保密
Dialogue: 0,0:14:20.43,0:14:21.93,Default,,0,0,0,,要我怎么保密啊
Dialogue: 0,0:14:21.93,0:14:25.46,Default,,0,0,0,,公司里有不少人在玩股票吧
Dialogue: 0,0:14:25.46,0:14:30.27,Default,,0,0,0,,要是到时被爆出搞内线交易 你能负责吗？
Dialogue: 0,0:14:30.27,0:14:32.10,Default,,0,0,0,,千万保密
Dialogue: 0,0:14:32.10,0:14:34.37,Default,,0,0,0,,这是社长命令
Dialogue: 0,0:14:41.41,0:14:42.92,Default,,0,0,0,,你在干嘛？
Dialogue: 0,0:14:42.92,0:14:44.92,Default,,0,0,0,,不吃你的帕尼诺三明治吗？
Dialogue: 0,0:14:44.92,0:14:46.55,Default,,0,0,0,,沼田先生
Dialogue: 0,0:14:46.55,0:14:48.25,Default,,0,0,0,,赖纲
Dialogue: 0,0:14:49.46,0:14:51.79,Default,,0,0,0,,可不可以不要管我？
Dialogue: 0,0:14:56.66,0:14:58.90,Default,,0,0,0,,津崎先生？
Dialogue: 0,0:15:15.25,0:15:17.72,Default,,0,0,0,,这是隔壁松本家的孙子
Dialogue: 0,0:15:17.72,0:15:20.35,Default,,0,0,0,,不知道我们家何时能抱孙子
Dialogue: 0,0:15:20.35,0:15:23.19,Default,,0,0,0,,妈 很抱歉
Dialogue: 0,0:15:23.19,0:15:26.52,Default,,0,0,0,,你的儿子别说要传宗接代
Dialogue: 0,0:15:26.52,0:15:29.86,Default,,0,0,0,,就连起跑线都站不上去
Dialogue: 0,0:15:29.86,0:15:34.27,Default,,0,0,0,,拥抱 然后接吻 已经是我的极限
Dialogue: 0,0:15:34.27,0:15:38.30,Default,,0,0,0,,小我10岁的美栗小姐的步调 我完全跟不上
Dialogue: 0,0:15:38.30,0:15:42.01,Default,,0,0,0,,根本不该从那里更进一步
Dialogue: 0,0:15:42.01,0:15:43.94,Default,,0,0,0,,不管平匡先生你发生什么事
Dialogue: 0,0:15:43.94,0:15:47.35,Default,,0,0,0,,我都会站在你这边的
Dialogue: 0,0:15:47.35,0:15:51.42,Default,,0,0,0,,要是能一直保持那样该有多好
Dialogue: 0,0:15:51.42,0:15:53.18,Default,,0,0,0,,我也很想象美栗小姐……
Dialogue: 0,0:15:53.18,0:15:57.56,Default,,0,0,0,,也很想象她那样用幻想让自己分心
Dialogue: 0,0:15:58.92,0:16:03.03,Default,,0,0,0,,不过我没有那么丰富的想象力
Dialogue: 0,0:16:14.07,0:16:17.34,Default,,0,0,0,,好和平
Dialogue: 0,0:16:17.34,0:16:20.98,Default,,0,0,0,,不过这里找不到工作
Dialogue: 0,0:16:20.98,0:16:23.75,Default,,0,0,0,,就这么一直在这里生活
Dialogue: 0,0:16:23.75,0:16:26.05,Default,,0,0,0,,如果这样的话……
Dialogue: 0,0:16:36.80,0:16:38.86,Default,,0,0,0,,这个嘛……
Dialogue: 0,0:16:38.86,0:16:42.20,Default,,0,0,0,,我大概有半年没出门了
Dialogue: 0,0:16:47.11,0:16:48.91,Default,,0,0,0,,很开心啊
Dialogue: 0,0:16:48.91,0:16:52.38,Default,,0,0,0,,附三餐加午睡 还能尽情打电动
Dialogue: 0,0:16:52.38,0:16:55.11,Default,,0,0,0,,每天都过得很充实
Dialogue: 0,0:16:57.92,0:16:59.58,Default,,0,0,0,,还是要工作
Dialogue: 0,0:17:02.25,0:17:04.72,Default,,0,0,0,,一定要找到工作
Dialogue: 0,0:17:19.17,0:17:21.31,Default,,0,0,0,,还有这招啊
Dialogue: 0,0:17:31.65,0:17:33.22,Default,,0,0,0,,野口真由小姐
Dialogue: 0,0:17:33.22,0:17:34.99,Default,,0,0,0,,是的
Dialogue: 0,0:17:34.99,0:17:37.22,Default,,0,0,0,,我好想见你
Dialogue: 0,0:17:38.46,0:17:39.66,Default,,0,0,0,,你好
Dialogue: 0,0:17:39.66,0:17:41.49,Default,,0,0,0,,幸会
Dialogue: 0,0:17:43.93,0:17:45.03,Default,,0,0,0,,全都在这里了
Dialogue: 0,0:17:45.03,0:17:46.90,Default,,0,0,0,,好的
Dialogue: 0,0:17:48.23,0:17:49.30,Default,,0,0,0,,小蝶呢？
Dialogue: 0,0:17:49.30,0:17:50.70,Default,,0,0,0,,我奶奶帮忙照顾
Dialogue: 0,0:17:50.70,0:17:52.54,Default,,0,0,0,,好漂亮的莲藕
Dialogue: 0,0:17:52.54,0:17:53.54,Default,,0,0,0,,很棒吧
Dialogue: 0,0:17:53.54,0:17:55.57,Default,,0,0,0,,好想吃筑前卤菜
Dialogue: 0,0:17:55.57,0:17:56.51,Default,,0,0,0,,筑前卤菜？
Dialogue: 0,0:17:56.51,0:17:59.08,Default,,0,0,0,,不能选更简单的菜吗？
Dialogue: 0,0:18:00.45,0:18:02.01,Default,,0,0,0,,小安
Dialogue: 0,0:18:02.01,0:18:02.68,Default,,0,0,0,,嗨
Dialogue: 0,0:18:02.68,0:18:04.12,Default,,0,0,0,,没想到你真的会来
Dialogue: 0,0:18:04.12,0:18:06.32,Default,,0,0,0,,你说只要我来 就教我怎么做蔬菜果酱
Dialogue: 0,0:18:06.32,0:18:07.55,Default,,0,0,0,,我以为你不会来
Dialogue: 0,0:18:07.55,0:18:09.82,Default,,0,0,0,,别小看我的行动力哦
Dialogue: 0,0:18:12.52,0:18:15.09,Default,,0,0,0,,契约结婚的事要保密哦
Dialogue: 0,0:18:15.09,0:18:16.73,Default,,0,0,0,,知道了
Dialogue: 0,0:18:17.66,0:18:19.20,Default,,0,0,0,,这么多人啊
Dialogue: 0,0:18:19.20,0:18:20.70,Default,,0,0,0,,-小茅 -怎么这么早到
Dialogue: 0,0:18:20.70,0:18:22.27,Default,,0,0,0,,为什么美栗也在？
Dialogue: 0,0:18:22.27,0:18:23.47,Default,,0,0,0,,不行吗？
Dialogue: 0,0:18:23.47,0:18:25.87,Default,,0,0,0,,你好
Dialogue: 0,0:18:25.87,0:18:27.07,Default,,0,0,0,,你叫做……
Dialogue: 0,0:18:27.07,0:18:28.11,Default,,0,0,0,,太妹小安
Dialogue: 0,0:18:28.11,0:18:29.74,Default,,0,0,0,,她叫安惠 所以小名叫做小安
Dialogue: 0,0:18:29.74,0:18:31.61,Default,,0,0,0,,还不是差不多
Dialogue: 0,0:18:31.61,0:18:33.88,Default,,0,0,0,,妈 你的脚怎么样？
Dialogue: 0,0:18:33.88,0:18:35.95,Default,,0,0,0,,你哥完全没变
Dialogue: 0,0:18:35.95,0:18:38.55,Default,,0,0,0,,你尽管给他壁咚 要是他下次又乱说话
Dialogue: 0,0:18:38.55,0:18:39.58,Default,,0,0,0,,壁咚？
Dialogue: 0,0:18:39.58,0:18:41.12,Default,,0,0,0,,不会心动的那种
Dialogue: 0,0:18:41.12,0:18:43.79,Default,,0,0,0,,像这样……用力咚下去
Dialogue: 0,0:18:43.79,0:18:44.72,Default,,0,0,0,,咚？
Dialogue: 0,0:18:44.72,0:18:46.62,Default,,0,0,0,,也找津崎来吧
Dialogue: 0,0:18:46.62,0:18:47.76,Default,,0,0,0,,反正明天放假
Dialogue: 0,0:18:47.76,0:18:49.23,Default,,0,0,0,,平匡先生有自己的节目啦
Dialogue: 0,0:18:49.23,0:18:51.73,Default,,0,0,0,,搭电车咻一下就到了
Dialogue: 0,0:18:51.73,0:18:53.76,Default,,0,0,0,,不要用拟声法蒙混 才没这么近
Dialogue: 0,0:18:53.76,0:18:56.14,Default,,0,0,0,,打电话问一声又不用钱
Dialogue: 0,0:18:56.14,0:18:57.94,Default,,0,0,0,,就这么办
Dialogue: 0,0:18:57.94,0:19:00.24,Default,,0,0,0,,这样得花电话费 谁说不用钱
Dialogue: 0,0:19:00.24,0:19:01.64,Default,,0,0,0,,我又不是这个意思
Dialogue: 0,0:19:01.64,0:19:02.81,Default,,0,0,0,,总之绝对不行
Dialogue: 0,0:19:02.81,0:19:06.74,Default,,0,0,0,,不准滥用电话 不行就是不行
Dialogue: 0,0:19:06.74,0:19:09.38,Default,,0,0,0,,你这么坚持的话那就算了
Dialogue: 0,0:19:09.38,0:19:11.98,Default,,0,0,0,,你跟老公吵架了吗？
Dialogue: 0,0:19:13.82,0:19:15.32,Default,,0,0,0,,所以才离家出走啊
Dialogue: 0,0:19:15.32,0:19:18.06,Default,,0,0,0,,原来如此 是这样啊
Dialogue: 0,0:19:18.06,0:19:21.73,Default,,0,0,0,,一定又说些自以为是的话
Dialogue: 0,0:19:21.73,0:19:23.73,Default,,0,0,0,,要对老公好一点
Dialogue: 0,0:19:23.73,0:19:27.27,Default,,0,0,0,,要体恤疲惫的老公才行
Dialogue: 0,0:19:27.27,0:19:28.43,Default,,0,0,0,,美栗
Dialogue: 0,0:19:28.43,0:19:30.27,Default,,0,0,0,,麻烦你了
Dialogue: 0,0:19:34.71,0:19:37.21,Default,,0,0,0,,你这家伙……
Dialogue: 0,0:19:37.21,0:19:39.74,Default,,0,0,0,,不要太过分！
Dialogue: 0,0:19:46.22,0:19:48.85,Default,,0,0,0,,为什么我要做这种事啊
Dialogue: 0,0:19:48.85,0:19:52.26,Default,,0,0,0,,为什么会把你养成这样的小孩啊
Dialogue: 0,0:19:53.52,0:19:55.53,Default,,0,0,0,,我很幸福啊
Dialogue: 0,0:19:55.53,0:19:58.00,Default,,0,0,0,,要是也能让周遭的人幸福就好
Dialogue: 0,0:19:58.00,0:20:03.44,Default,,0,0,0,,如果自己不幸福 怎么让别人幸福啊
Dialogue: 0,0:20:03.44,0:20:06.87,Default,,0,0,0,,你真会说话
Dialogue: 0,0:20:06.87,0:20:08.41,Default,,0,0,0,,因为我是爸爸的儿子啊
Dialogue: 0,0:20:08.41,0:20:10.24,Default,,0,0,0,,所以这么会说话？
Dialogue: 0,0:20:13.71,0:20:16.22,Default,,0,0,0,,就算做成果酱 也要先用盐巴搓过
Dialogue: 0,0:20:16.22,0:20:21.05,Default,,0,0,0,,另外南瓜一定要连籽一起蒸
Dialogue: 0,0:20:21.05,0:20:24.66,Default,,0,0,0,,这样就能做出浓郁美味的果酱
Dialogue: 0,0:20:26.19,0:20:28.09,Default,,0,0,0,,-给你 -谢谢
Dialogue: 0,0:20:28.09,0:20:31.20,Default,,0,0,0,,那两个男人相互称赞还蛮恶心的
Dialogue: 0,0:20:32.43,0:20:35.80,Default,,0,0,0,,我发现爸跟哥的自我肯定感都很强
Dialogue: 0,0:20:35.80,0:20:38.40,Default,,0,0,0,,你小时候也是这样啊
Dialogue: 0,0:20:38.40,0:20:41.67,Default,,0,0,0,,我可是在学校跟社会中挫折不断
Dialogue: 0,0:20:41.67,0:20:43.41,Default,,0,0,0,,一般人都是这样吧
Dialogue: 0,0:20:43.41,0:20:46.81,Default,,0,0,0,,就只有小茅很奇迹似的 完全没受过挫折
Dialogue: 0,0:20:46.81,0:20:48.51,Default,,0,0,0,,说那样是幸福也算是幸福
Dialogue: 0,0:20:48.51,0:20:51.75,Default,,0,0,0,,我不希望小蝶受到什么大伤
Dialogue: 0,0:20:51.75,0:20:53.78,Default,,0,0,0,,不过觉得有点小擦伤是必要的
Dialogue: 0,0:20:53.78,0:20:56.59,Default,,0,0,0,,以经验值而言 确实是有受过伤比较好
Dialogue: 0,0:20:56.59,0:20:58.76,Default,,0,0,0,,问题就是程度轻重
Dialogue: 0,0:20:58.76,0:21:01.73,Default,,0,0,0,,擦伤程度的小伤
Dialogue: 0,0:21:01.73,0:21:06.40,Default,,0,0,0,,就算如此 不断受到小擦伤
Dialogue: 0,0:21:06.40,0:21:09.53,Default,,0,0,0,,也会变成严重的伤害
Dialogue: 0,0:21:09.53,0:21:12.74,Default,,0,0,0,,让自己疲惫不堪
Dialogue: 0,0:21:12.74,0:21:14.17,Default,,0,0,0,,与我无关
Dialogue: 0,0:21:14.17,0:21:18.04,Default,,0,0,0,,因为爱上低自尊的平匡先生
Dialogue: 0,0:21:18.04,0:21:22.25,Default,,0,0,0,,请不要揣测或是分析我
Dialogue: 0,0:21:22.25,0:21:29.35,Default,,0,0,0,,就算遭到拒绝也假装没事 而强颜欢笑让我觉得好累
Dialogue: 0,0:21:29.35,0:21:35.26,Default,,0,0,0,,所以我觉得可以去选市议会议员
Dialogue: 0,0:21:35.26,0:21:36.50,Default,,0,0,0,,什么？
Dialogue: 0,0:21:36.50,0:21:37.56,Default,,0,0,0,,很好啊
Dialogue: 0,0:21:37.56,0:21:40.63,Default,,0,0,0,,你刚刚说的“所以” 是从哪里接下来的？
Dialogue: 0,0:21:40.63,0:21:42.47,Default,,0,0,0,,我刚刚问过野口真由小姐
Dialogue: 0,0:21:42.47,0:21:43.37,Default,,0,0,0,,谁啊？
Dialogue: 0,0:21:43.37,0:21:45.27,Default,,0,0,0,,跟我同年的市议会议员
Dialogue: 0,0:21:45.27,0:21:47.10,Default,,0,0,0,,是个充满热情的大陆派
Dialogue: 0,0:21:47.10,0:21:48.94,Default,,0,0,0,,这么容易就能选上吗？
Dialogue: 0,0:21:48.94,0:21:51.04,Default,,0,0,0,,选举演说的幻想我有做过
Dialogue: 0,0:21:51.04,0:21:52.44,Default,,0,0,0,,这么说想象训练没问题咯
Dialogue: 0,0:21:52.44,0:21:57.35,Default,,0,0,0,,不觉得能对世人有所贡献 同时又有薪水可拿很棒吗？
Dialogue: 0,0:21:57.35,0:21:58.22,Default,,0,0,0,,我有问题
Dialogue: 0,0:21:58.22,0:22:00.69,Default,,0,0,0,,我想请问议员候选人 美栗小姐
Dialogue: 0,0:22:00.69,0:22:04.49,Default,,0,0,0,,对于职业妇女的育儿 你有什么看法？
Dialogue: 0,0:22:04.49,0:22:06.09,Default,,0,0,0,,要不要做直播讨论？
Dialogue: 0,0:22:06.09,0:22:06.86,Default,,0,0,0,,啥？
Dialogue: 0,0:22:06.86,0:22:08.93,Default,,0,0,0,,我来当田原总一朗
Dialogue: 0,0:22:19.97,0:22:20.71,Default,,0,0,0,,大家好
Dialogue: 0,0:22:20.71,0:22:23.71,Default,,0,0,0,,今天的议题是职业妇女的育儿问题
Dialogue: 0,0:22:23.71,0:22:26.31,Default,,0,0,0,,这个社会对女人的要求太超过了
Dialogue: 0,0:22:26.31,0:22:28.25,Default,,0,0,0,,要你工作 生小孩 教育小孩
Dialogue: 0,0:22:28.25,0:22:30.35,Default,,0,0,0,,还要你保持美丽
Dialogue: 0,0:22:30.35,0:22:31.85,Default,,0,0,0,,这样不管有几条命都不够用
Dialogue: 0,0:22:31.85,0:22:34.39,Default,,0,0,0,,不过如果女性不生产 少子化问题会越来越严重
Dialogue: 0,0:22:34.39,0:22:36.89,Default,,0,0,0,,另一方面 有些女性也很想工作
Dialogue: 0,0:22:36.89,0:22:41.19,Default,,0,0,0,,大家干脆趁高中时生产如何？
Dialogue: 0,0:22:41.19,0:22:42.09,Default,,0,0,0,,啥？
Dialogue: 0,0:22:42.09,0:22:43.73,Default,,0,0,0,,与其边工作边养小孩
Dialogue: 0,0:22:43.73,0:22:46.63,Default,,0,0,0,,我认为在学生时代养小孩 会比较轻松
Dialogue: 0,0:22:46.63,0:22:50.97,Default,,0,0,0,,把高中的空教室改成托儿所 上课时小孩先寄在托儿所
Dialogue: 0,0:22:50.97,0:22:53.84,Default,,0,0,0,,下课时间再去喂奶
Dialogue: 0,0:22:53.84,0:22:55.51,Default,,0,0,0,,就算因为生产而休学
Dialogue: 0,0:22:55.51,0:22:59.54,Default,,0,0,0,,只要暑假去补习 学业也能追得上
Dialogue: 0,0:22:59.54,0:23:02.58,Default,,0,0,0,,家政课学做婴儿服或是断奶食品
Dialogue: 0,0:23:02.58,0:23:03.42,Default,,0,0,0,,没错
Dialogue: 0,0:23:03.42,0:23:06.88,Default,,0,0,0,,像这样全校一起来育儿……
Dialogue: 0,0:23:06.88,0:23:08.69,Default,,0,0,0,,-美栗 -是
Dialogue: 0,0:23:08.69,0:23:10.72,Default,,0,0,0,,你的想法是很有趣
Dialogue: 0,0:23:10.72,0:23:16.76,Default,,0,0,0,,不过高举高中育儿制度参选 应该不会当选
Dialogue: 0,0:23:16.76,0:23:17.80,Default,,0,0,0,,你也这么想吗？
Dialogue: 0,0:23:17.80,0:23:19.90,Default,,0,0,0,,至少高中时想好好享受青春
Dialogue: 0,0:23:19.90,0:23:22.17,Default,,0,0,0,,那应该什么时候生好呢？
Dialogue: 0,0:23:22.17,0:23:25.40,Default,,0,0,0,,不觉得边育儿边投入社会的 时机很难拿捏吗？
Dialogue: 0,0:23:25.40,0:23:28.01,Default,,0,0,0,,还是得请大家一起帮忙吧
Dialogue: 0,0:23:28.01,0:23:30.71,Default,,0,0,0,,像是夫妻 社会跟身边的人
Dialogue: 0,0:23:30.71,0:23:32.71,Default,,0,0,0,,问题就出在没这么顺利
Dialogue: 0,0:23:32.71,0:23:36.88,Default,,0,0,0,,只要男人也能生小孩就好了
Dialogue: 0,0:23:36.88,0:23:37.65,Default,,0,0,0,,这个点子很棒
Dialogue: 0,0:23:37.65,0:23:39.48,Default,,0,0,0,,丈夫跟妻子轮流生小孩
Dialogue: 0,0:23:39.48,0:23:41.99,Default,,0,0,0,,如果有选择余地 就能了解彼此的苦处
Dialogue: 0,0:23:41.99,0:23:44.86,Default,,0,0,0,,真糟糕 我应该选择当科学家才对
Dialogue: 0,0:23:44.86,0:23:48.09,Default,,0,0,0,,听起来真不舒服
Dialogue: 0,0:23:48.09,0:23:50.70,Default,,0,0,0,,我也好想生
Dialogue: 0,0:23:54.17,0:23:56.23,Default,,0,0,0,,干杯
Dialogue: 0,0:23:58.77,0:24:00.10,Default,,0,0,0,,太棒了
Dialogue: 0,0:24:00.10,0:24:02.54,Default,,0,0,0,,生啤酒太好喝了
Dialogue: 0,0:24:02.54,0:24:03.58,Default,,0,0,0,,沼田先生
Dialogue: 0,0:24:03.58,0:24:05.58,Default,,0,0,0,,开口 快开口啦
Dialogue: 0,0:24:05.58,0:24:07.31,Default,,0,0,0,,就算开口 我也什么都不会说
Dialogue: 0,0:24:07.31,0:24:09.78,Default,,0,0,0,,你有想说的事吗？
Dialogue: 0,0:24:09.78,0:24:12.12,Default,,0,0,0,,我问你们 要点什么？
Dialogue: 0,0:24:12.12,0:24:14.02,Default,,0,0,0,,这个
Dialogue: 0,0:24:14.02,0:24:15.35,Default,,0,0,0,,好想吃炸软骨
Dialogue: 0,0:24:15.35,0:24:16.79,Default,,0,0,0,,脆脆的口感 好想吃脆脆的口感
Dialogue: 0,0:24:16.79,0:24:17.52,Default,,0,0,0,,日野
Dialogue: 0,0:24:17.52,0:24:18.72,Default,,0,0,0,,先冷静下来
Dialogue: 0,0:24:18.72,0:24:19.86,Default,,0,0,0,,不过是来居酒屋
Dialogue: 0,0:24:19.86,0:24:21.06,Default,,0,0,0,,我超开心
Dialogue: 0,0:24:21.06,0:24:23.40,Default,,0,0,0,,这里对我而言是超级娱乐城
Dialogue: 0,0:24:23.40,0:24:26.03,Default,,0,0,0,,每次聚餐我小孩都发烧 没一次去成
Dialogue: 0,0:24:26.03,0:24:28.03,Default,,0,0,0,,为您转接语音信箱
Dialogue: 0,0:24:28.03,0:24:29.94,Default,,0,0,0,,津崎先生
Dialogue: 0,0:24:29.94,0:24:32.80,Default,,0,0,0,,快点收工 过来会合
Dialogue: 0,0:24:32.80,0:24:34.17,Default,,0,0,0,,他太太跟小孩呢？
Dialogue: 0,0:24:34.17,0:24:35.94,Default,,0,0,0,,听说回娘家了
Dialogue: 0,0:24:35.94,0:24:38.41,Default,,0,0,0,,因为声优在娘家附近办活动
Dialogue: 0,0:24:38.41,0:24:40.41,Default,,0,0,0,,是我老婆的嗜好
Dialogue: 0,0:24:40.41,0:24:44.25,Default,,0,0,0,,能跟日野这个超稀有角色 喝酒的机会很难得哦
Dialogue: 0,0:24:44.25,0:24:47.55,Default,,0,0,0,,听到这个留言后马上给我滚过来
Dialogue: 0,0:24:50.22,0:24:52.86,Default,,0,0,0,,如果现在喝酒
Dialogue: 0,0:24:52.86,0:24:56.76,Default,,0,0,0,,好像连不该说的话都会说出口
Dialogue: 0,0:24:56.76,0:25:00.70,Default,,0,0,0,,不过日野先生又那么照顾我
Dialogue: 0,0:25:00.70,0:25:04.57,Default,,0,0,0,,不过今天身体状况不太好
Dialogue: 0,0:25:04.57,0:25:07.94,Default,,0,0,0,,不过日野先生……
Dialogue: 0,0:25:07.94,0:25:12.41,Default,,0,0,0,,在这种郁闷的心情之下……
Dialogue: 0,0:25:12.41,0:25:14.98,Default,,0,0,0,,稀有角色……
Dialogue: 0,0:25:21.79,0:25:25.19,Default,,0,0,0,,这么优柔寡断的男人
Dialogue: 0,0:25:25.19,0:25:28.93,Default,,0,0,0,,怪不得美栗小姐会受不了
Dialogue: 0,0:25:30.26,0:25:32.20,Default,,0,0,0,,终于来了 好啊
Dialogue: 0,0:25:32.20,0:25:33.63,Default,,0,0,0,,很抱歉我来晚了
Dialogue: 0,0:25:33.63,0:25:35.93,Default,,0,0,0,,麻烦给我们小毛巾跟啤酒
Dialogue: 0,0:25:35.93,0:25:36.50,Default,,0,0,0,,马上来
Dialogue: 0,0:25:36.50,0:25:39.07,Default,,0,0,0,,快追上 快追上哦
Dialogue: 0,0:25:39.07,0:25:40.57,Default,,0,0,0,,我要喝了
Dialogue: 0,0:25:43.58,0:25:45.91,Default,,0,0,0,,我也有邀百合妹
Dialogue: 0,0:25:45.91,0:25:47.75,Default,,0,0,0,,百合妹？
Dialogue: 0,0:25:47.75,0:25:50.18,Default,,0,0,0,,我跟她互叫百合妹跟小沼弟
Dialogue: 0,0:25:50.18,0:25:51.82,Default,,0,0,0,,什么时候变这么熟啊
Dialogue: 0,0:25:51.82,0:25:53.95,Default,,0,0,0,,不过她说今天开车 没办法喝酒
Dialogue: 0,0:25:53.95,0:25:55.55,Default,,0,0,0,,他们公司能开车上班啊
Dialogue: 0,0:25:55.55,0:25:58.59,Default,,0,0,0,,好像要载 活动要用的东西之类的
Dialogue: 0,0:25:58.59,0:26:00.19,Default,,0,0,0,,我也好想见她们
Dialogue: 0,0:26:00.19,0:26:02.73,Default,,0,0,0,,百合妹跟美栗妹
Dialogue: 0,0:26:04.16,0:26:06.06,Default,,0,0,0,,我不知道你能否见到百合小姐
Dialogue: 0,0:26:06.06,0:26:09.33,Default,,0,0,0,,不过一定见不到美栗小姐
Dialogue: 0,0:26:09.33,0:26:11.84,Default,,0,0,0,,让我见她啦
Dialogue: 0,0:26:15.61,0:26:17.91,Default,,0,0,0,,这道筑前卤菜……
Dialogue: 0,0:26:17.91,0:26:20.11,Default,,0,0,0,,只有1颗星
Dialogue: 0,0:26:20.11,0:26:22.38,Default,,0,0,0,,评分好严格
Dialogue: 0,0:26:22.38,0:26:23.82,Default,,0,0,0,,真的只有1颗星
Dialogue: 0,0:26:23.82,0:26:28.02,Default,,0,0,0,,完全比不上你妈妈的筑前卤菜
Dialogue: 0,0:26:29.52,0:26:32.52,Default,,0,0,0,,小茅 下次在家也要煮给我吃
Dialogue: 0,0:26:32.52,0:26:35.39,Default,,0,0,0,,小心又被壁咚哦
Dialogue: 0,0:26:35.39,0:26:37.16,Default,,0,0,0,,那个已经不流行了 千万不要
Dialogue: 0,0:26:37.16,0:26:38.70,Default,,0,0,0,,都是小安害的
Dialogue: 0,0:26:38.70,0:26:40.53,Default,,0,0,0,,快点吃 不然会冷掉
Dialogue: 0,0:26:40.53,0:26:43.27,Default,,0,0,0,,我要开动了
Dialogue: 0,0:26:49.67,0:26:54.38,Default,,0,0,0,,风见先生 你家的家事帮手 现在怎么样了？
Dialogue: 0,0:26:54.38,0:26:55.51,Default,,0,0,0,,为什么问？
Dialogue: 0,0:26:55.51,0:26:58.55,Default,,0,0,0,,你不是说想追人家吗？
Dialogue: 0,0:26:58.55,0:27:01.22,Default,,0,0,0,,她这个礼拜突然请假
Dialogue: 0,0:27:01.22,0:27:03.29,Default,,0,0,0,,怎么可以随便请假啊
Dialogue: 0,0:27:03.29,0:27:04.86,Default,,0,0,0,,我觉得她应该不是随便请假
Dialogue: 0,0:27:04.86,0:27:08.66,Default,,0,0,0,,她是个对自己的言行负责任的人
Dialogue: 0,0:27:08.66,0:27:12.90,Default,,0,0,0,,一定是发生了什么 让她无法待下去的事吧
Dialogue: 0,0:27:16.33,0:27:17.90,Default,,0,0,0,,什么样的事？
Dialogue: 0,0:27:17.90,0:27:20.67,Default,,0,0,0,,这我就不知道了
Dialogue: 0,0:27:22.34,0:27:25.91,Default,,0,0,0,,如果不知道就不要随便说说
Dialogue: 0,0:27:31.72,0:27:34.12,Default,,0,0,0,,虽然我不知道内情
Dialogue: 0,0:27:34.12,0:27:38.92,Default,,0,0,0,,不过也许我比你更了解她
Dialogue: 0,0:27:40.66,0:27:44.20,Default,,0,0,0,,应该说我看得更清楚吧
Dialogue: 0,0:27:47.80,0:27:52.27,Default,,0,0,0,,我不知道你看到了什么
Dialogue: 0,0:27:52.27,0:27:55.94,Default,,0,0,0,,不过看到不同的东西 是理所当然的事吧
Dialogue: 0,0:27:55.94,0:28:00.01,Default,,0,0,0,,我跟你本来就不一样
Dialogue: 0,0:28:00.01,0:28:01.18,Default,,0,0,0,,不一样？
Dialogue: 0,0:28:01.18,0:28:03.82,Default,,0,0,0,,我不是个会在这种地方 对人语带讽刺
Dialogue: 0,0:28:03.82,0:28:07.72,Default,,0,0,0,,充满自信的人
Dialogue: 0,0:28:07.72,0:28:13.06,Default,,0,0,0,,不管是生活方式和外表 我们全都不一样
Dialogue: 0,0:28:13.06,0:28:16.93,Default,,0,0,0,,彻彻底底的不一样
Dialogue: 0,0:28:20.93,0:28:22.73,Default,,0,0,0,,大家都不一样 不过大家都很好
Dialogue: 0,0:28:22.73,0:28:24.54,Default,,0,0,0,,-大家都很好啊 -就是啊
Dialogue: 0,0:28:24.54,0:28:25.47,Default,,0,0,0,,来干杯吧
Dialogue: 0,0:28:25.47,0:28:28.11,Default,,0,0,0,,喝吧 喝吧
Dialogue: 0,0:28:30.54,0:28:32.88,Default,,0,0,0,,便宜的比较好吧
Dialogue: 0,0:28:32.88,0:28:34.51,Default,,0,0,0,,一定是这样
Dialogue: 0,0:28:34.51,0:28:35.78,Default,,0,0,0,,便宜的比较好吧
Dialogue: 0,0:28:35.78,0:28:38.38,Default,,0,0,0,,竟然要5千圆 都可以吃鳗鱼饭了
Dialogue: 0,0:28:46.99,0:28:48.93,Default,,0,0,0,,真是的 都几岁了 到底在做什么
Dialogue: 0,0:28:48.93,0:28:52.16,Default,,0,0,0,,-很抱歉 -拜托你了
Dialogue: 0,0:28:52.16,0:28:56.07,Default,,0,0,0,,会这样我多少得负责 我陪你送他回去
Dialogue: 0,0:29:02.51,0:29:03.51,Default,,0,0,0,,续摊
Dialogue: 0,0:29:03.51,0:29:04.11,Default,,0,0,0,,要去吗？
Dialogue: 0,0:29:04.11,0:29:04.81,Default,,0,0,0,,当然要去
Dialogue: 0,0:29:04.81,0:29:07.64,Default,,0,0,0,,-你还吃得下吗？ -吃得下
Dialogue: 0,0:29:07.64,0:29:10.68,Default,,0,0,0,,你对爸会不会太严格？
Dialogue: 0,0:29:10.68,0:29:12.28,Default,,0,0,0,,因为他已经退休
Dialogue: 0,0:29:12.28,0:29:16.12,Default,,0,0,0,,所以想让他稍微帮忙家事的 心情我是可以理解
Dialogue: 0,0:29:17.19,0:29:21.26,Default,,0,0,0,,上个月我去做了定期健诊
Dialogue: 0,0:29:21.26,0:29:26.36,Default,,0,0,0,,我没跟你爸说 不过有需要再检查的项目
Dialogue: 0,0:29:26.36,0:29:30.27,Default,,0,0,0,,我去做了精密检查
Dialogue: 0,0:29:30.27,0:29:32.17,Default,,0,0,0,,结果呢？
Dialogue: 0,0:29:37.28,0:29:39.54,Default,,0,0,0,,一切正常
Dialogue: 0,0:29:39.54,0:29:41.25,Default,,0,0,0,,什么啊
Dialogue: 0,0:29:41.25,0:29:43.38,Default,,0,0,0,,在等结果出来之前 我内心很不安
Dialogue: 0,0:29:43.38,0:29:45.38,Default,,0,0,0,,想了很多事情
Dialogue: 0,0:29:45.38,0:29:51.22,Default,,0,0,0,,如果自己先死 那你爸要怎么办
Dialogue: 0,0:29:51.22,0:29:54.53,Default,,0,0,0,,所以我觉得这是个好机会
Dialogue: 0,0:29:54.53,0:29:56.73,Default,,0,0,0,,那你直说不就好了
Dialogue: 0,0:29:56.73,0:30:00.16,Default,,0,0,0,,如果我说会先死这种话 你爸会担心啊
Dialogue: 0,0:30:00.16,0:30:03.33,Default,,0,0,0,,会担心我是不是真的会死
Dialogue: 0,0:30:03.33,0:30:04.64,Default,,0,0,0,,真羡慕你有爸这么爱你
Dialogue: 0,0:30:04.64,0:30:07.24,Default,,0,0,0,,我们很相爱 彼此都很努力爱对方
Dialogue: 0,0:30:07.24,0:30:08.34,Default,,0,0,0,,要努力吗？
Dialogue: 0,0:30:08.34,0:30:12.01,Default,,0,0,0,,怎么可能付出无偿的爱 夫妻原本就是外人
Dialogue: 0,0:30:12.01,0:30:13.64,Default,,0,0,0,,好敢讲哦
Dialogue: 0,0:30:13.64,0:30:16.51,Default,,0,0,0,,虽然大家常说什么命中注定的对象
Dialogue: 0,0:30:16.51,0:30:18.85,Default,,0,0,0,,不过我觉得根本就没有这种人
Dialogue: 0,0:30:18.85,0:30:19.92,Default,,0,0,0,,好没有梦想哦
Dialogue: 0,0:30:19.92,0:30:25.92,Default,,0,0,0,,要把对方变成命中注定的对象
Dialogue: 0,0:30:27.19,0:30:29.33,Default,,0,0,0,,意志不够坚定 就无法继续下去
Dialogue: 0,0:30:29.33,0:30:33.16,Default,,0,0,0,,不管是工作或家庭都一样吧
Dialogue: 0,0:30:39.77,0:30:44.24,Default,,0,0,0,,因为津崎先生的关系 让我想起以前的事
Dialogue: 0,0:30:44.24,0:30:46.18,Default,,0,0,0,,那件事有趣吗？
Dialogue: 0,0:30:46.18,0:30:47.51,Default,,0,0,0,,一点也不有趣
Dialogue: 0,0:30:47.51,0:30:49.81,Default,,0,0,0,,那就不用说了
Dialogue: 0,0:30:49.81,0:30:53.68,Default,,0,0,0,,我初中时很抢手
Dialogue: 0,0:30:53.68,0:30:55.39,Default,,0,0,0,,还是要说啊
Dialogue: 0,0:30:55.39,0:30:57.66,Default,,0,0,0,,第一次交的女朋友
Dialogue: 0,0:30:57.66,0:31:01.53,Default,,0,0,0,,是个很普通的女生
Dialogue: 0,0:31:01.53,0:31:04.63,Default,,0,0,0,,我非常喜欢这个女生
Dialogue: 0,0:31:04.63,0:31:06.40,Default,,0,0,0,,不过有一天……
Dialogue: 0,0:31:06.40,0:31:09.97,Default,,0,0,0,,跟你在一起 我好痛苦
Dialogue: 0,0:31:09.97,0:31:15.81,Default,,0,0,0,,因为你很帅 运动神经又好
Dialogue: 0,0:31:15.81,0:31:17.44,Default,,0,0,0,,女生都很喜欢你
Dialogue: 0,0:31:17.44,0:31:19.44,Default,,0,0,0,,我不起眼又不漂亮
Dialogue: 0,0:31:19.44,0:31:22.51,Default,,0,0,0,,大家都说 “那两个人为什么会在一起”
Dialogue: 0,0:31:22.51,0:31:24.08,Default,,0,0,0,,这种事根本不用去在意
Dialogue: 0,0:31:24.08,0:31:26.95,Default,,0,0,0,,你是不会懂的
Dialogue: 0,0:31:26.95,0:31:31.22,Default,,0,0,0,,因为我跟你……
Dialogue: 0,0:31:31.22,0:31:34.02,Default,,0,0,0,,完全不一样
Dialogue: 0,0:31:34.02,0:31:37.26,Default,,0,0,0,,这种事情我也无能为力
Dialogue: 0,0:31:37.26,0:31:43.03,Default,,0,0,0,,她对自己没自信 明明是她自己的问题
Dialogue: 0,0:31:45.47,0:31:48.27,Default,,0,0,0,,也许我应该对她说
Dialogue: 0,0:31:48.27,0:31:53.08,Default,,0,0,0,,“不管你怎么拒绝我” “我还是最喜欢你”
Dialogue: 0,0:31:53.08,0:31:57.15,Default,,0,0,0,,不过她根本就没想到我的心情
Dialogue: 0,0:31:57.15,0:32:00.42,Default,,0,0,0,,只想到她自己
Dialogue: 0,0:32:00.42,0:32:03.02,Default,,0,0,0,,我该对这样的她说什么好呢？
Dialogue: 0,0:34:06.18,0:34:09.85,Default,,0,0,0,,她是抱着什么样的心情做这些饭菜
Dialogue: 0,0:34:15.45,0:34:19.82,Default,,0,0,0,,抱着什么样的心情离开这里
Dialogue: 0,0:34:22.86,0:34:26.96,Default,,0,0,0,,那时候的美栗小姐……
Dialogue: 0,0:34:30.00,0:34:33.00,Default,,0,0,0,,是抱着什么样的心情呢？
Dialogue: 0,0:34:33.00,0:34:35.81,Default,,0,0,0,,我只顾到自己的心情
Dialogue: 0,0:34:35.81,0:34:42.18,Default,,0,0,0,,甚至连碰都没碰 美栗小姐留下的这些饭菜
Dialogue: 0,0:35:10.84,0:35:16.85,Default,,0,0,0,,要很诚实的持续爱一个人
Dialogue: 0,0:35:16.85,0:35:20.22,Default,,0,0,0,,也许是件非常困难的事
Dialogue: 0,0:35:24.56,0:35:28.66,Default,,0,0,0,,虽然无法改变别人的心
Dialogue: 0,0:35:28.66,0:35:33.66,Default,,0,0,0,,不过人生的方向盘 是由自己掌握
Dialogue: 0,0:35:33.66,0:35:37.44,Default,,0,0,0,,你是不是故意绕远路？
Dialogue: 0,0:35:37.44,0:35:40.80,Default,,0,0,0,,我在想你可能想耍忧郁
Dialogue: 0,0:35:40.80,0:35:42.34,Default,,0,0,0,,走这条路不错吧
Dialogue: 0,0:35:42.34,0:35:43.67,Default,,0,0,0,,是的
Dialogue: 0,0:35:43.67,0:35:47.01,Default,,0,0,0,,现在的年轻人都不买车
Dialogue: 0,0:35:47.01,0:35:48.78,Default,,0,0,0,,就算没车也没差
Dialogue: 0,0:35:48.78,0:35:49.85,Default,,0,0,0,,又来了
Dialogue: 0,0:35:49.85,0:35:53.12,Default,,0,0,0,,搭电车跟巴士 大部分地方都能到
Dialogue: 0,0:35:53.12,0:35:54.99,Default,,0,0,0,,是这样没错
Dialogue: 0,0:35:54.99,0:35:58.89,Default,,0,0,0,,不过有车的话
Dialogue: 0,0:35:58.89,0:36:02.93,Default,,0,0,0,,可以到比你想象中更遥远的地方去
Dialogue: 0,0:36:10.77,0:36:12.74,Default,,0,0,0,,让我来
Dialogue: 0,0:36:13.77,0:36:14.67,Default,,0,0,0,,接着自己做哦
Dialogue: 0,0:36:14.67,0:36:16.17,Default,,0,0,0,,乐意之至
Dialogue: 0,0:36:16.17,0:36:20.04,Default,,0,0,0,,大家都回去了 好舍不得
Dialogue: 0,0:36:20.04,0:36:22.05,Default,,0,0,0,,你不是叫大家别来吗？
Dialogue: 0,0:36:22.05,0:36:23.61,Default,,0,0,0,,美栗
Dialogue: 0,0:36:24.82,0:36:27.95,Default,,0,0,0,,你要一直待下去也没关系哦
Dialogue: 0,0:36:29.99,0:36:32.02,Default,,0,0,0,,谢谢
Dialogue: 0,0:36:51.91,0:36:53.58,Default,,0,0,0,,喂……
Dialogue: 0,0:36:55.98,0:36:58.18,Default,,0,0,0,,我是平匡
Dialogue: 0,0:36:59.32,0:37:01.18,Default,,0,0,0,,我知道
Dialogue: 0,0:37:03.39,0:37:05.26,Default,,0,0,0,,对不起
Dialogue: 0,0:37:08.66,0:37:10.03,Default,,0,0,0,,平匡先生
Dialogue: 0,0:37:10.03,0:37:12.56,Default,,0,0,0,,我已经听够了你一直向我道歉
Dialogue: 0,0:37:12.56,0:37:14.40,Default,,0,0,0,,对不起
Dialogue: 0,0:37:14.40,0:37:15.87,Default,,0,0,0,,不是……抱歉……
Dialogue: 0,0:37:15.87,0:37:17.64,Default,,0,0,0,,不是……
Dialogue: 0,0:37:17.64,0:37:20.50,Default,,0,0,0,,找我有什么事？
Dialogue: 0,0:37:23.01,0:37:25.91,Default,,0,0,0,,我有话想对美栗小姐你说
Dialogue: 0,0:37:27.38,0:37:27.91,Default,,0,0,0,,我……
Dialogue: 0,0:37:27.91,0:37:30.51,Default,,0,0,0,,请等一下
Dialogue: 0,0:37:30.51,0:37:33.28,Default,,0,0,0,,请让我先说
Dialogue: 0,0:37:33.28,0:37:38.82,Default,,0,0,0,,不管你的结论如何 我心意已决
Dialogue: 0,0:37:41.79,0:37:47.80,Default,,0,0,0,,我因数分解过自己的心情
Dialogue: 0,0:37:47.80,0:37:52.50,Default,,0,0,0,,把多余的事情全排除 看看最后剩下什么
Dialogue: 0,0:37:52.50,0:37:54.30,Default,,0,0,0,,你是指质因数分解吧
Dialogue: 0,0:37:54.30,0:37:56.21,Default,,0,0,0,,是的
Dialogue: 0,0:37:56.21,0:37:59.14,Default,,0,0,0,,像是工作 收入
Dialogue: 0,0:37:59.14,0:38:03.91,Default,,0,0,0,,自己想做的事情 想要成为什么样的自己等等
Dialogue: 0,0:38:03.91,0:38:06.28,Default,,0,0,0,,我想了很多 最后……
Dialogue: 0,0:38:06.28,0:38:07.58,Default,,0,0,0,,请等一下
Dialogue: 0,0:38:07.58,0:38:09.82,Default,,0,0,0,,还是请让我先说
Dialogue: 0,0:38:09.82,0:38:11.52,Default,,0,0,0,,我心意已决……
Dialogue: 0,0:38:11.52,0:38:13.89,Default,,0,0,0,,打电话的人是我
Dialogue: 0,0:38:13.89,0:38:17.30,Default,,0,0,0,,我认为我有权利先说
Dialogue: 0,0:38:20.26,0:38:22.33,Default,,0,0,0,,说得也是
Dialogue: 0,0:38:25.64,0:38:29.97,Default,,0,0,0,,我……
Dialogue: 0,0:38:29.97,0:38:32.64,Default,,0,0,0,,没有女性经验
Dialogue: 0,0:38:36.55,0:38:40.48,Default,,0,0,0,,而且一直觉得就算没有也没关系
Dialogue: 0,0:38:40.48,0:38:44.89,Default,,0,0,0,,不过那天晚上脑海里先闪过的是
Dialogue: 0,0:38:44.89,0:38:48.29,Default,,0,0,0,,“要是失败该怎么办”
Dialogue: 0,0:38:48.29,0:38:53.36,Default,,0,0,0,,同时也觉得让小自己10岁的 女生主导很丢脸
Dialogue: 0,0:38:57.80,0:39:03.54,Default,,0,0,0,,遭到拒绝的美栗小姐是怎么想的
Dialogue: 0,0:39:03.54,0:39:06.54,Default,,0,0,0,,我脑子里压根没想到这件事
Dialogue: 0,0:39:09.21,0:39:11.42,Default,,0,0,0,,对不起
Dialogue: 0,0:39:13.72,0:39:18.32,Default,,0,0,0,,一方面也是害怕被你发现我没经验
Dialogue: 0,0:39:19.46,0:39:21.49,Default,,0,0,0,,我早就知道了
Dialogue: 0,0:39:24.16,0:39:26.03,Default,,0,0,0,,我早就知道这件事
Dialogue: 0,0:39:27.20,0:39:30.10,Default,,0,0,0,,从你母亲告诉我你的事
Dialogue: 0,0:39:30.10,0:39:34.04,Default,,0,0,0,,加上其他种种的事就能猜到
Dialogue: 0,0:39:37.24,0:39:43.25,Default,,0,0,0,,对我来说这种事情根本不算什么
Dialogue: 0,0:39:46.02,0:39:52.96,Default,,0,0,0,,不过遭到你拒绝
Dialogue: 0,0:39:52.96,0:39:57.33,Default,,0,0,0,,让我……
Dialogue: 0,0:39:57.33,0:39:59.80,Default,,0,0,0,,让我大受打击
Dialogue: 0,0:40:05.57,0:40:10.41,Default,,0,0,0,,我甚至想在馆山选市议会议员算了
Dialogue: 0,0:40:10.41,0:40:12.28,Default,,0,0,0,,市议会议员？
Dialogue: 0,0:40:12.28,0:40:15.08,Default,,0,0,0,,见到跟自己同年的女议员
Dialogue: 0,0:40:15.08,0:40:20.28,Default,,0,0,0,,我在想这样的人生也不错
Dialogue: 0,0:40:20.28,0:40:23.35,Default,,0,0,0,,一这么想……
Dialogue: 0,0:40:23.35,0:40:25.69,Default,,0,0,0,,心情就轻松好多
Dialogue: 0,0:40:31.30,0:40:35.06,Default,,0,0,0,,知道自己还有其他路可走
Dialogue: 0,0:40:35.06,0:40:38.24,Default,,0,0,0,,就算现在这条路走失败了也没关系
Dialogue: 0,0:40:41.81,0:40:46.68,Default,,0,0,0,,我现在打算回去303号室
Dialogue: 0,0:40:47.78,0:40:51.18,Default,,0,0,0,,这是我摒除一切后得到的答案
Dialogue: 0,0:40:51.18,0:40:54.12,Default,,0,0,0,,平匡先生你可能会觉得我很麻烦
Dialogue: 0,0:40:54.12,0:40:57.02,Default,,0,0,0,,不过就这么结束太虎头蛇尾
Dialogue: 0,0:40:57.02,0:40:59.89,Default,,0,0,0,,我们还是应该见面好好再谈一次
Dialogue: 0,0:40:59.89,0:41:02.39,Default,,0,0,0,,我要见你
Dialogue: 0,0:41:02.39,0:41:03.83,Default,,0,0,0,,我就在这里
Dialogue: 0,0:41:03.83,0:41:06.00,Default,,0,0,0,,就在你附近
Dialogue: 0,0:41:06.00,0:41:08.50,Default,,0,0,0,,我要跟你见面
Dialogue: 0,0:41:08.50,0:41:12.07,Default,,0,0,0,,把礼拜二的拥抱补回来
Dialogue: 0,0:41:22.75,0:41:24.62,Default,,0,0,0,,好的
Dialogue: 0,0:41:43.60,0:41:45.50,Default,,0,0,0,,津崎
Dialogue: 0,0:41:45.50,0:41:47.50,Default,,0,0,0,,美栗小姐呢？
Dialogue: 0,0:41:47.50,0:41:48.77,Default,,0,0,0,,等一下
Dialogue: 0,0:41:51.11,0:41:52.78,Default,,0,0,0,,平匡先生你现在人在哪里？
Dialogue: 0,0:41:52.78,0:41:55.55,Default,,0,0,0,,这还用问吗？我在馆山
Dialogue: 0,0:41:55.55,0:41:58.48,Default,,0,0,0,,我现在在公寓前面
Dialogue: 0,0:42:01.12,0:42:04.62,Default,,0,0,0,,欢迎你来
Dialogue: 0,0:42:04.62,0:42:05.16,Default,,0,0,0,,你来真是太好了
Dialogue: 0,0:42:05.16,0:42:06.49,Default,,0,0,0,,平匡先生 拥抱呢？
Dialogue: 0,0:42:06.49,0:42:09.73,Default,,0,0,0,,我现在正在被拥抱
Dialogue: 0,0:42:09.73,0:42:11.16,Default,,0,0,0,,被你爸爸抱
Dialogue: 0,0:42:33.05,0:42:34.05,Default,,0,0,0,,再多喝一点
Dialogue: 0,0:42:34.05,0:42:37.59,Default,,0,0,0,,不……我想今天赶回去
Dialogue: 0,0:42:37.59,0:42:40.12,Default,,0,0,0,,-有什么关系 -明天放假吧
Dialogue: 0,0:42:40.12,0:42:41.86,Default,,0,0,0,,我们棉被家多得是
Dialogue: 0,0:42:41.86,0:42:42.66,Default,,0,0,0,,对了
Dialogue: 0,0:42:42.66,0:42:44.86,Default,,0,0,0,,要不要看美栗的相簿？
Dialogue: 0,0:42:44.86,0:42:46.60,Default,,0,0,0,,我是想看 不过……
Dialogue: 0,0:42:46.60,0:42:47.93,Default,,0,0,0,,还有视频哦
Dialogue: 0,0:42:47.93,0:42:48.93,Default,,0,0,0,,运动会的视频
Dialogue: 0,0:42:48.93,0:42:50.37,Default,,0,0,0,,总共5小时的视频哦
Dialogue: 0,0:42:50.37,0:42:52.30,Default,,0,0,0,,总共5小时？
Dialogue: 0,0:42:53.37,0:42:57.17,Default,,0,0,0,,很抱歉 我今天没办法回去了
Dialogue: 0,0:43:02.11,0:43:05.02,Default,,0,0,0,,加油 加油
Dialogue: 0,0:43:05.02,0:43:07.25,Default,,0,0,0,,很抱歉 我爸妈这么强人所难
Dialogue: 0,0:43:07.25,0:43:08.82,Default,,0,0,0,,快看啊
Dialogue: 0,0:43:08.82,0:43:10.49,Default,,0,0,0,,美栗在那里
Dialogue: 0,0:43:10.49,0:43:12.66,Default,,0,0,0,,好像个小豆子 根本看不出来吧
Dialogue: 0,0:43:12.66,0:43:14.02,Default,,0,0,0,,看得出来啦 快看
Dialogue: 0,0:43:14.02,0:43:16.03,Default,,0,0,0,,好可爱哦
Dialogue: 0,0:43:17.39,0:43:19.80,Default,,0,0,0,,我明天会回去
Dialogue: 0,0:43:20.90,0:43:24.03,Default,,0,0,0,,明天晚餐要煮什么呢？
Dialogue: 0,0:43:24.03,0:43:26.94,Default,,0,0,0,,要跟他聊什么呢？
Dialogue: 0,0:43:26.94,0:43:29.27,Default,,0,0,0,,我等你回来
Dialogue: 0,0:43:30.98,0:43:34.21,Default,,0,0,0,,像个小孩般好兴奋
Dialogue: 0,0:43:35.41,0:43:37.98,Default,,0,0,0,,请等我回去
Dialogue: 0,0:43:38.88,0:43:42.92,Default,,0,0,0,,好期待明天快点到来
Dialogue: 0,0:43:47.26,0:43:50.26,Default,,0,0,0,,存在于心中的东西
Dialogue: 0,0:43:50.26,0:43:53.26,Default,,0,0,0,,有一天不再看到的东西
Dialogue: 0,0:43:53.26,0:43:56.17,Default,,0,0,0,,那就是陪在你身边
Dialogue: 0,0:43:56.17,0:43:59.34,Default,,0,0,0,,总是让我想起
Dialogue: 0,0:43:59.34,0:44:02.37,Default,,0,0,0,,存在于你心中的东西
Dialogue: 0,0:44:02.37,0:44:05.44,Default,,0,0,0,,存在于距离中的鼓动
Dialogue: 0,0:44:05.44,0:44:08.24,Default,,0,0,0,,曾经恋上的你
Dialogue: 0,0:44:08.24,0:44:11.28,Default,,0,0,0,,十指交叠 脸庞的香味
Dialogue: 0,0:44:11.28,0:44:14.35,Default,,0,0,0,,超越夫妇
Dialogue: 0,0:44:14.35,0:44:17.35,Default,,0,0,0,,超越两人
Dialogue: 0,0:44:17.35,0:44:19.82,Default,,0,0,0,,超越一人
Dialogue: 0,0:44:31.64,0:44:32.90,Default,,0,0,0,,辛苦了 很累吧
Dialogue: 0,0:44:32.90,0:44:35.17,Default,,0,0,0,,我好累
Dialogue: 0,0:44:35.17,0:44:38.08,Default,,0,0,0,,听说裁员 会从有能力的裁起
Dialogue: 0,0:44:38.08,0:44:39.74,Default,,0,0,0,,礼拜二是开除日
Dialogue: 0,0:44:39.74,0:44:42.05,Default,,0,0,0,,需要进行系统的再构筑
Dialogue: 0,0:44:42.05,0:44:44.38,Default,,0,0,0,,他觉得我是个轻浮的女人
Dialogue: 0,0:44:44.38,0:44:47.82,Default,,0,0,0,,现在的我完全像市原悦子
Dialogue: 0,0:44:47.82,0:44:49.75,Default,,0,0,0,,家政妇看到了
Dialogue: 0,0:05:27.33,0:05:29.10,Note,,0,0,0,,（恋爱47公斤级）
Dialogue: 0,0:05:39.50,0:05:41.71,Note,,0,0,0,,（悔不当初的失误）
Dialogue: 0,0:16:30.02,0:16:32.89,Note,,0,0,0,,（森山美栗 无业）
Dialogue: 0,0:18:27.07,0:18:28.11,Note,,0,0,0,,（太妹与小安音近）
Dialogue: 0,0:22:06.86,0:22:08.93,Note,,0,0,0,,（政论节目主持人）
Dialogue: 0,0:22:10.30,0:22:13.70,Note,,0,0,0,,（直播讨论到最后）
Dialogue: 0,0:22:13.70,0:22:18.00,Note,,0,0,0,,（激辩！职业妇女的育儿问题）
Dialogue: 0,0:22:28.25,0:22:30.35,Note,,0,0,0,,（双薪家庭主妇代表）
Dialogue: 0,0:22:36.89,0:22:41.19,Note,,0,0,0,,（市议会议员候选人）
Dialogue: 0,0:32:40.66,0:32:44.53,Note,,0,0,0,,（早餐 请用微波炉加热再吃）\N（今天也请好好努力工作）
Dialogue: 0,0:32:54.67,0:32:56.84,Note,,0,0,0,,（早餐 今天的胡萝卜）\N（好甜好好吃）
Dialogue: 0,0:33:01.11,0:33:04.82,Note,,0,0,0,,（晚餐 纯正高汤煮的什锦饭）\N（跟配菜很搭哦）
Dialogue: 0,0:33:15.96,0:33:17.36,Note,,0,0,0,,（晚餐 工作辛苦了）
Dialogue: 0,0:33:17.36,0:33:19.16,Note,,0,0,0,,（泡38度的澡能让自己放松哦）
Dialogue: 0,0:33:22.80,0:33:25.54,Note,,0,0,0,,（晚餐 今天的菜色）\N（用了很多秋天的根茎蔬菜）
Dialogue: 0,0:33:25.54,0:33:27.50,Note,,0,0,0,,（里面还有莲藕哦）
Dialogue: 0,0:33:30.91,0:33:32.31,Note,,0,0,0,,（晚餐 工作辛苦了）
Dialogue: 0,0:33:32.31,0:33:34.24,Note,,0,0,0,,（今天是中华料理 营养也很丰富哦）
Dialogue: 0,0:44:31.64,0:44:32.90,Note,,0,0,0,,（下集预告）
